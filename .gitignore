# build output
dist/
# deps
node_modules/
# astro
.astro/
# env
.env
.env.production
# os / editor
.DS_Store
Thumbs.db
*.log

# Local Netlify folder
.netlify

.vercel

# local browser-test captures
artifacts/

# Blender render intermediates — the encoded plates in public/worlds/render are
# the shipped artifact; the PNG sequences behind them are reproducible
render/out/
render/*.log
render/assets/

# Python bytecode: churns on every Blender run and pollutes every diff.
__pycache__/
*.pyc

# Cake Studio Phase-1 generation evidence kept locally; Git receives only the
# accepted keyframes, compact master review sheets, prompts, ledger, and QA.
public/worlds/assets/cake-studio/raw/
public/worlds/assets/cake-studio/review/REJECT-*.png
public/worlds/assets/cake-studio/review/HOLD-BEFORE-*.png
public/worlds/assets/cake-studio/review/HOLD-AFTER-*.png
public/worlds/assets/cake-studio/review/CST-contact-sheet-[0-9][0-9].png
public/worlds/assets/cake-studio/review/CST-contact-sheet-portrait-[0-9][0-9].png

# Cut The Strings Phase-1 generation evidence kept locally; Git receives only
# accepted keyframes, compact master review sheets, prompts, review, and QA.
public/worlds/assets/strings/raw/
public/worlds/assets/strings/review/rejected-v1/
public/worlds/assets/strings/review/rolling/
public/worlds/assets/strings/review/CTS-KF*.png
public/worlds/assets/strings/review/CTS-contact-sheet-[0-9][0-9].png
public/worlds/assets/strings/review/CTS-contact-sheet-portrait-[0-9][0-9].png

# Impeccable review captures (large, regenerated per review)
.impeccable/review/

# Isolated type declarations for the typecheck gate. The install is generated;
# the manifest and lockfile that make it reproducible are not.
.typedeps/node_modules/

# Round 06 realtime desktop capture is 11 MB — over the 5 MB git budget.
# Kept locally in docs/signal-review/round06/after/ only.
docs/signal-review/round06/after/signal-realtime-desktop.mp4

# Deep Field evidence: the real-input recordings stay local. The contact sheets
# and the report are the packet; an mp4 is for the owner to watch, not for git.
docs/deep-field/**/*.mp4
dist-v2/

---
import { automationProjects, labProjects } from '../data/system-projects';
import { legacyProjects } from '../data/projects';
import { pick, workPath, type Lang } from '../i18n/utils';

interface Props { lang: Lang }
const { lang } = Astro.props;
const ar = lang === 'ar';
const all = [...automationProjects, ...legacyProjects, ...labProjects];
const groups = [
  { key: 'automation', title: ar ? 'أنظمة الأتمتة' : 'Automation systems', items: automationProjects },
  { key: 'foundation', title: ar ? 'الأساس التشغيلي' : 'Operating foundation', items: legacyProjects },
  { key: 'lab', title: ar ? 'المختبر الهندسي' : 'Engineering lab', items: labProjects },
];
const arrow = ar ? '←' : '→';
const indexOf = (slug: string) => String(all.findIndex((p) => p.slug === slug) + 1).padStart(2, '0');
---

<div class="world-journeys" data-home-world-experience>
  <article class="wj wj--razer" data-world-journey="razer" aria-hidden="true">
    <section class="wj-stage rz-boot" data-world-stage>
      <div class="wj-stick">
        <div class="rz-tunnel" aria-hidden="true"><i></i><i></i><i></i><i></i><b></b></div>
        <div class="rz-boot__copy">
          <span class="rz-signal">SYSTEM // ONLINE</span>
          <div class="home-heading" role="heading" aria-level="1">{ar ? 'ادخل إلى محرك العمليات.' : 'Enter the operations engine.'}</div>
          <p>{ar ? 'كل نقرة تمر عبر أربع بوابات: ارسم، ابنِ، وافق، أثبت.' : 'Every scroll step advances one real operating contract: map, build, gate, prove.'}</p>
          <a href="#razer-bay">{ar ? 'ابدأ التنفيذ' : 'Initiate sequence'} {arrow}</a>
        </div>
        <div class="rz-readout" aria-hidden="true"><span>31 REPOS AUDITED</span><span>{all.length} VERIFIED STORIES</span><span>EN / AR</span></div>
      </div>
    </section>
    <section class="wj-stage rz-corridor" data-world-stage>
      <div class="wj-stick">
        <div class="rz-perspective" aria-hidden="true">
          {['MAP','BUILD','GATE','PROVE'].map((gate, i) => <div class="rz-gate" style={`--i:${i}`}><span>{gate}</span><b></b></div>)}
        </div>
        <div class="rz-corridor__copy">
          <span>SCROLL-LINKED EXECUTION</span>
          <h2>{ar ? 'السرعة لا تلغي السلطة.' : 'Speed never outranks authority.'}</h2>
          <p>{ar ? 'الأتمتة تُحضّر وتنفّذ ما هو قابل للعكس. القرار المكلف يتوقف عند بوابة بشرية مسجلة.' : 'Automation prepares and executes the reversible work. Costly decisions stop at a recorded human gate.'}</p>
        </div>
      </div>
    </section>
    <section class="wj-stage rz-blackbox" data-world-stage>
      <div class="wj-stick">
        <div class="rz-console" aria-hidden="true">
          <div class="rz-display"><span>FLIGHT RECORDER</span><b>TRACE / READBACK / LIMITS</b><i></i></div>
          <div class="rz-keys">{['MAP','BUILD','GATE','PROVE'].map((key) => <span>{key}</span>)}<span class="approval">HUMAN<br/>APPROVAL</span></div>
        </div>
        <div class="rz-blackbox__copy"><h2>{ar ? 'إذا لم يترك دليلًا، فهو لم يعمل.' : 'If it leaves no evidence, it did not run.'}</h2><p>{ar ? 'الاختبارات والقياسات والقراءة الراجعة والحدود جزء من النظام، لا حاشية بعد الإطلاق.' : 'Tests, measurements, readback, and explicit limits are part of the system—not release-day decoration.'}</p></div>
      </div>
    </section>
    <section class="rz-bay" id="razer-bay">
      <header><span>CARTRIDGE BAY / {String(all.length).padStart(2, '0')}</span><h2>{ar ? 'اختر نظامًا. افتح سجل الرحلة.' : 'Choose a system. Open its flight recorder.'}</h2></header>
      {groups.map((group) => <div class="rz-rack"><h3>{group.title}</h3><div>{group.items.map((project) => <a href={workPath(lang, project.slug)} style={`--a:${project.cardA};--b:${project.cardB}`}><span>{indexOf(project.slug)}</span><b>{pick(lang, project.title)}</b><small>{pick(lang, project.stat)}</small><i>{arrow}</i></a>)}</div></div>)}
      <footer><p>{ar ? 'السلطة تبقى بشرية. الدليل يبقى قابلًا للقراءة.' : 'Authority stays human. Evidence stays readable.'}</p><a href="#contact">{ar ? 'افتح قناة اتصال' : 'Open a channel'} {arrow}</a></footer>
    </section>
  </article>

  <article class="wj wj--disney" data-world-journey="disney" aria-hidden="true">
    <section class="wj-stage ds-opening" data-world-stage><div class="wj-stick">
      <div class="ds-castle" aria-hidden="true"><i></i><i></i><i></i><i></i><b></b></div>
      <div class="ds-copy"><p>{ar ? 'حكاية أنظمة حقيقية' : 'A story of real systems'}</p><div class="home-heading" role="heading" aria-level="1">{ar ? 'كل عمل يدوي ينتظر تحوّلًا.' : 'Every manual task is waiting for a transformation.'}</div><span>{ar ? 'مرّر الصفحة لفتح الكتاب.' : 'Scroll to open the book.'}</span></div>
    </div></section>
    <section class="wj-stage ds-book" data-world-stage><div class="wj-stick">
      <div class="ds-spread" aria-hidden="true"><div><span>ONCE</span><i></i><i></i></div><b></b><div><span>AFTER</span><i></i><i></i></div></div>
      <div class="ds-book__copy"><h2>{ar ? 'الفصل يتغير، والحقيقة لا.' : 'The chapter changes. The truth does not.'}</h2><p>{ar ? 'تبدأ كل قصة بمهمة تشغيلية، تمر بتحول معماري، وتنتهي بدليل وحد واضح.' : 'Each story begins with operating friction, crosses an architectural transformation, and ends with proof and an honest boundary.'}</p></div>
    </div></section>
    <section class="ds-library">
      <header><span>{ar ? 'المكتبة الكاملة' : 'The complete library'}</span><h2>{ar ? 'ثلاثون حكاية، لا قصة مستنسخة.' : 'Thirty stories. No repeated plot.'}</h2></header>
      <div class="ds-shelves">{groups.map((group, gi) => <section><h3>{group.title}</h3><div>{group.items.map((project, i) => <a href={workPath(lang, project.slug)} style={`--a:${project.cardA};--turn:${(i % 5) - 2}deg`}><span>{gi + 1}.{String(i + 1).padStart(2,'0')}</span><b>{pick(lang, project.title)}</b><small>{pick(lang, project.blurb)}</small><i>{ar ? 'افتح الفصل' : 'Open chapter'} {arrow}</i></a>)}</div></section>)}</div>
      <a class="ds-end" href="#contact">{ar ? 'والفصل التالي نكتبه معًا.' : 'The next chapter is the one we build together.'} {arrow}</a>
    </section>
  </article>

  <article class="wj wj--cod" data-world-journey="cod" aria-hidden="true">
    <section class="wj-stage cod-brief" data-world-stage><div class="wj-stick">
      <div class="cod-map" aria-hidden="true"><b></b>{[1,2,3,4,5].map((n) => <i style={`--n:${n}`}></i>)}</div>
      <div class="cod-copy"><span>OPERATION // REMOVE THE LOOP</span><div class="home-heading" role="heading" aria-level="1">{ar ? 'المهمة: استعد السيطرة على العملية.' : 'Mission: take back control of the operation.'}</div><dl><div><dt>AO</dt><dd>KUWAIT</dd></div><div><dt>ROLE</dt><dd>AUTOMATION ENGINEER</dd></div><div><dt>ROE</dt><dd>HUMAN AUTHORITY</dd></div></dl></div>
    </div></section>
    <section class="wj-stage cod-operation" data-world-stage><div class="wj-stick">
      <div class="cod-route" aria-hidden="true"><span>INTAKE</span><i></i><span>STATE</span><i></i><span>GATE</span><i></i><span>OUTPUT</span></div>
      <div class="cod-operation__copy"><h2>{ar ? 'لا إطلاق بلا قواعد اشتباك.' : 'No deployment without rules of engagement.'}</h2><p>{ar ? 'يفصل النظام بين الإعداد والسلطة، ويغلق بأمان، ويسجل ما حدث ومن امتلك القرار.' : 'The system separates preparation from authority, fails closed, and records what happened and who owned the decision.'}</p></div>
    </div></section>
    <section class="cod-roster">
      <header><span>MISSION ROSTER / {all.length}</span><h2>{ar ? 'اختر العملية. اقرأ تقرير ما بعد التنفيذ.' : 'Select an operation. Read the after-action report.'}</h2></header>
      <div>{all.map((project, i) => <a href={workPath(lang, project.slug)} style={`--a:${project.cardA}`}><span>{String(i + 1).padStart(2,'0')}</span><b>{pick(lang, project.title)}</b><small>{pick(lang, project.tag)}</small><em>{pick(lang, project.stat)}</em><i>OPEN AAR {arrow}</i></a>)}</div>
    </section>
  </article>

  <article class="wj wj--netflix" data-world-journey="netflix" aria-hidden="true">
    <section class="wj-stage nf-profile" data-world-stage><div class="wj-stick"><div class="home-heading" role="heading" aria-level="1">{ar ? 'من يشاهد؟' : "Who's watching?"}</div><div class="nf-faces"><button class="active"><i>MM</i><b>{ar ? 'محمد' : 'Mohamed'}</b></button><button><i>AI</i><b>Systems</b></button><button><i>{all.length}</i><b>Stories</b></button></div><p>{ar ? 'اختيار الملف يفتح موسمًا كاملًا، لا لوحة بطاقات.' : 'This profile opens a complete season—not a reskinned card wall.'}</p></div></section>
    <section class="wj-stage nf-billboard" data-world-stage><div class="wj-stick"><div class="nf-light" aria-hidden="true"></div><div class="nf-copy"><span><b>N</b> ORIGINAL SYSTEMS</span><div class="home-heading" role="heading" aria-level="1">AUTOMATION<br/><em>ENGINEER</em></div><p>{ar ? 'موسم من الأنظمة المحلية، بوابات الموافقة، الأدوات الداخلية، والنتائج القابلة للقراءة.' : 'A season of local systems, approval gates, internal tools, and evidence you can actually read.'}</p><a href="#netflix-episodes">▶ {ar ? 'تشغيل الموسم' : 'Play season'}</a></div></div></section>
    <section class="nf-catalog" id="netflix-episodes"><header><h2>{ar ? 'الحلقات والمجموعات' : 'Episodes & collections'}</h2><span>{all.length} EPISODES · EN / AR</span></header>{groups.map((group) => <section><h3>{group.title}</h3><div>{group.items.map((project, i) => <a href={workPath(lang, project.slug)} style={`--a:${project.cardA};--b:${project.cardB}`}><span class="nf-rank">{String(i + 1).padStart(2,'0')}</span><div><b>{pick(lang, project.title)}</b><small>{pick(lang, project.blurb)}</small></div><em>{pick(lang, project.stat)}</em></a>)}</div></section>)}</section>
  </article>

  <article class="wj wj--spotify" data-world-journey="spotify" aria-hidden="true">
    <section class="wj-stage sp-album" data-world-stage><div class="wj-stick"><div class="sp-cover" aria-hidden="true"><i></i><b>MM</b><span>AUTOMATION<br/>MIX</span></div><div class="sp-copy"><span>{ar ? 'ألبوم · ٢٠٢٦' : 'ALBUM · 2026'}</span><div class="home-heading" role="heading" aria-level="1">{ar ? 'أنظمة تعمل بهدوء.' : 'Systems that keep playing.'}</div><p>{ar ? 'ثلاثون مسارًا عن الأتمتة المحلية، هندسة الأدلة، والأدوات التي تبقى قريبة من العمل.' : 'Thirty tracks about local automation, evidence engineering, and tools that stay close to the work.'}</p><a href="#spotify-tracks">▶ {ar ? 'تشغيل' : 'Play'}</a></div></div></section>
    <section class="wj-stage sp-now" data-world-stage><div class="wj-stick"><div class="sp-wave" aria-hidden="true">{Array.from({length:42},(_,i)=><i style={`--i:${i}`}></i>)}</div><div class="sp-now__copy"><span>NOW PLAYING</span><h2>{ar ? 'العمل المتكرر هو الإيقاع. الموافقة هي الوقفة.' : 'Repetition is the beat. Approval is the pause.'}</h2><p>{ar ? 'يبني النظام التدفق ويترك القرار للإنسان، ثم يسجل ما تم تشغيله.' : 'The system builds the flow, leaves the decision to a human, then records what played.'}</p></div></div></section>
    <section class="sp-tracks" id="spotify-tracks"><header><h2>{ar ? 'قائمة المسارات' : 'Track list'}</h2><span>{all.length} SONGS · {ar ? 'بدون تخطٍ' : 'NO SKIPS'}</span></header>{groups.map((group) => <section><h3>{group.title}</h3>{group.items.map((project, i) => <a href={workPath(lang, project.slug)}><span>{String(i + 1).padStart(2,'0')}</span><i style={`--a:${project.cardA};--b:${project.cardB}`}></i><b>{pick(lang, project.title)}<small>{pick(lang, project.tag)}</small></b><em>{pick(lang, project.stat)}</em><strong>•••</strong></a>)}</section>)}</section>
  </article>

  <article class="wj wj--apple" data-world-journey="apple" aria-hidden="true">
    <section class="wj-stage ap-keynote" data-world-stage><div class="wj-stick"><div class="ap-orb" aria-hidden="true"><i></i><i></i><i></i><b>H</b></div><div class="ap-copy"><div class="home-heading" role="heading" aria-level="1">{ar ? 'أتمتة. مدروسة بالكامل.' : 'Automation. Thought through.'}</div><p>{ar ? 'من المدخل إلى القرار، ومن التفاعل إلى دليل قابل للقراءة.' : 'From intake to decision. From interaction to evidence.'}</p><a href="#apple-products">{ar ? 'شاهد الأنظمة' : 'See the systems'} {arrow}</a></div></div></section>
    <section class="wj-stage ap-explode" data-world-stage><div class="wj-stick"><div class="ap-stack" aria-hidden="true">{['INPUT','STATE','DECISION','OUTPUT'].map((x,i)=><div style={`--i:${i}`}><span>{x}</span></div>)}</div><div class="ap-explode__copy"><h2>{ar ? 'كل طبقة تعرف مسؤوليتها.' : 'Every layer knows its job.'}</h2><p>{ar ? 'المعمارية الواضحة تجعل النظام أسرع في التغيير وأسهل في الاختبار وأصدق في العرض.' : 'A legible architecture makes the system easier to change, easier to test, and harder to misrepresent.'}</p></div></div></section>
    <section class="ap-products" id="apple-products"><header><h2>{ar ? 'تشكيلة الأنظمة.' : 'The system lineup.'}</h2><p>{ar ? 'ثلاثون قصة، ولكل واحدة عقدها ودليلها وحدودها.' : 'Thirty stories, each with its own contract, proof, and limits.'}</p></header><div>{all.map((project,i)=><a href={workPath(lang,project.slug)} style={`--a:${project.cardA};--b:${project.cardB};--i:${i}`}><span>{pick(lang,project.tag)}</span><b>{pick(lang,project.title)}</b><small>{pick(lang,project.blurb)}</small><em>{pick(lang,project.stat)}</em><i>{ar ? 'اعرف المزيد' : 'Learn more'} {arrow}</i></a>)}</div><footer><h3>{ar ? 'وشيء أخير.' : 'And one more thing.'}</h3><a href="#contact">{ar ? 'لنبنِ العملية التالية.' : 'Let’s build the next operation.'} {arrow}</a></footer></section>
  </article>

  <article class="wj wj--samsung" data-world-journey="samsung" aria-hidden="true">
    <section class="wj-stage sm-unfold" data-world-stage><div class="wj-stick"><div class="sm-device" aria-hidden="true"><div><span>INPUT</span><i></i><i></i></div><b></b><div><span>OUTPUT</span><strong>{all.length}</strong><small>STORIES</small></div></div><div class="sm-copy"><span>CONNECTED OPERATIONS</span><div class="home-heading" role="heading" aria-level="1">{ar ? 'الأتمتة، تنفتح.' : 'Automation, unfolded.'}</div><p>{ar ? 'عملية واحدة. طبقات متصلة. حقيقة تتحرك عبر كل شاشة.' : 'One operation. Connected layers. One truth moving across every surface.'}</p></div></div></section>
    <section class="wj-stage sm-ecosystem" data-world-stage><div class="wj-stick"><div class="sm-orbits" aria-hidden="true"><b>MM</b>{['DATA','AI','OPS','DOCS','HUMAN'].map((x,i)=><span style={`--i:${i}`}>{x}</span>)}</div><div class="sm-ecosystem__copy"><h2>{ar ? 'الاتصال ليس تكاملًا حتى يمر القرار.' : 'Connected is not integrated until the decision travels.'}</h2><p>{ar ? 'تربط المسارات البيانات بالحالة والإجراء والدليل، مع بقاء السلطة في مكانها الصحيح.' : 'The workflows connect data to state, action, and proof while authority stays where it belongs.'}</p></div></div></section>
    <section class="sm-devices"><header><span>GALAXY OF WORK / {all.length}</span><h2>{ar ? 'كل نظام سطح مختلف لنفس الانضباط.' : 'Every system is a different surface for the same discipline.'}</h2></header><div>{groups.map((group)=><section><h3>{group.title}</h3>{group.items.map((project,i)=><a href={workPath(lang,project.slug)} style={`--a:${project.cardA};--b:${project.cardB};--i:${i}`}><span>{indexOf(project.slug)}</span><b>{pick(lang,project.title)}</b><small>{pick(lang,project.blurb)}</small><em>{pick(lang,project.stat)}</em></a>)}</section>)}</div></section>
  </article>
</div>

<script>
  let worldJourneyCleanup: (() => void) | null = null;
  function initWorldJourneys() {
    worldJourneyCleanup?.();
    const root = document.querySelector<HTMLElement>('[data-home-world-experience]');
    if (!root) return;
    let raf = 0;
    const sync = () => {
      const world = document.documentElement.dataset.world || 'astronomy';
      root.querySelectorAll<HTMLElement>('[data-world-journey]').forEach((journey) => {
        const active = journey.dataset.worldJourney === world;
        journey.setAttribute('aria-hidden', String(!active));
        if ('inert' in journey) journey.inert = !active;
      });
      update();
    };
    const update = () => {
      raf = 0;
      root.querySelectorAll<HTMLElement>('[data-world-stage]').forEach((stage) => {
        if (stage.offsetParent === null) return;
        const rect = stage.getBoundingClientRect();
        const span = Math.max(1, rect.height - innerHeight);
        const p = Math.max(0, Math.min(1, -rect.top / span));
        stage.style.setProperty('--p', p.toFixed(4));
      });
    };
    const queue = () => { if (!raf) raf = requestAnimationFrame(update); };
    sync();
    addEventListener('scroll', queue, { passive: true });
    addEventListener('resize', queue, { passive: true });
    document.addEventListener('mm:worldchange', sync);
    worldJourneyCleanup = () => { if (raf) cancelAnimationFrame(raf); removeEventListener('scroll', queue); removeEventListener('resize', queue); document.removeEventListener('mm:worldchange', sync); };
  }
  initWorldJourneys();
  document.addEventListener('astro:page-load', initWorldJourneys);
</script>

<style is:global>
  .world-journeys,.wj{display:none}.wj[aria-hidden="false"]{display:block}.wj{position:relative;z-index:3;overflow:clip}.wj-stage{position:relative;height:220vh}.wj-stick{position:sticky;top:0;height:100svh;min-height:620px;overflow:hidden;isolation:isolate}.wj h1,.wj h2,.wj h3,.wj p{margin-top:0}.wj a:focus-visible{outline:3px solid currentColor;outline-offset:5px}

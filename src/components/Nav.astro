---
import { useTranslations, otherLang, mirrorPath, homePath, type Lang } from '../i18n/utils';
import { WORLDS, WORLD_GLYPHS } from '../lib/theme';
import type { UIKey } from '../i18n/ui';

interface Props {
  lang: Lang;
  /** true on the homepage → in-page anchors; false on stories → link home first */
  home?: boolean;
}
const { lang, home = false } = Astro.props;
const t = useTranslations(lang);
const base = home ? '' : homePath(lang);
const other = otherLang(lang);
const mirror = mirrorPath(Astro.url.pathname, other);
const otherLabel = other === 'ar' ? 'ع' : 'EN';
---

<nav class="nav" id="top" aria-label="Primary">
  <a class="nav__brand" href={homePath(lang)} aria-label={t('a11y.home')}>
    <span class="dot" aria-hidden="true"></span>Mohamed&nbsp;Mahmoud
  </a>
  <div class="nav__links">
    <a href={`${base}#work`}>{t('nav.work')}</a>
    <a href={`${base}#lab`}>{t('nav.team')}</a>
    <a href={`${base}#foundation`}>{t('nav.about')}</a>
    <a href={`${base}#contact`}>{t('nav.contact')}</a>
  </div>
  <div class="nav__tools">
    <a class="pill" href={mirror} aria-label={t('a11y.switchLang')} data-astro-reload>{otherLabel}</a>
    <div class="theme-menu" data-world-menu>
      <button
        class="pill world-pill"
        type="button"
        data-world-btn
        aria-haspopup="listbox"
        aria-expanded="false"
        aria-label={t('a11y.themeMenu')}>
        <span data-world-glyph aria-hidden="true">{WORLD_GLYPHS.astronomy}</span>
        <span class="world-pill__label" data-world-label>{t('world.astronomy')}</span>
      </button>
      <ul class="theme-menu__list" role="listbox" aria-label={t('a11y.themeMenu')} hidden>
        {
          WORLDS.map((world) => (
            <li role="presentation">
              <button
                class="theme-menu__opt"
                type="button"
                role="option"
                data-world-opt={world}
                data-world-copy={t(`world.${world}` as UIKey)}
                aria-selected="false">
                <span class="theme-menu__glyph" aria-hidden="true">{WORLD_GLYPHS[world]}</span>
                {t(`world.${world}` as UIKey)}
              </button>
            </li>
          ))
        }
      </ul>
    </div>
    <button class="pill" type="button" data-mode-btn aria-label={t('a11y.toggleTheme')}>☾</button>
  </div>
</nav>

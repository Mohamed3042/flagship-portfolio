---
import { pick, workPath, type Lang } from '../../i18n/utils';
import type { ProjectMeta } from '../../data/projects';
import type { Featured } from '../../data/featured';
interface Props { lang: Lang; project: ProjectMeta; feature: Featured; }
const { lang, project, feature } = Astro.props;
const ar = lang === 'ar';
const story = project.story!;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// Only the previously privacy-reviewed homepage shots are used.
const shots = feature.shots;
const first = project.slug === 'cake-studio' ? shots.find(s => s.src === 'cake-render') ?? shots[0] : shots[0];
const extra = story.link && story.link.href !== feature.repo ? story.link : null;
---
<article class="sr-card" style={`--a:${project.cardA};--b:${project.cardB}`} aria-labelledby={`project-${project.slug}`}>
  {/* The accessible name has to CONTAIN the visible label, or someone driving
      the page by voice says "view full size" and nothing happens (WCAG 2.5.3,
      Label in Name). It used to read "Enlarge screenshot of X" over a button
      whose visible words were "View full size". */}
  <div class="sr-card__media">
    <button type="button" class="sr-card__image" data-zoom data-src={`${base}/img/sky/${first.src}.webp`} data-alt={pick(lang, first.alt)} aria-label={`${ar ? 'عرض بالحجم الكامل' : 'View full size'}: ${pick(lang, project.title)}`}>
      <img data-card-image src={`${base}/img/sky/${first.src}.webp`} alt={pick(lang, first.alt)} width={first.w} height={first.h} loading="lazy" decoding="async" />
      <span class="sr-card__enlarge">{ar ? 'عرض بالحجم الكامل' : 'View full size'} <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><path d="M7 3H3v4m10-4h4v4M3 13v4h4m10-4v4h-4" fill="none" stroke="currentColor" stroke-width="1.5" /></svg></span>
    </button>
    {shots.length > 1 && <div class="sr-card__shots" role="group" aria-label={ar ? 'صور المشروع' : 'Project screenshots'}>{shots.map((s, i) => <button type="button" data-shot={`${base}/img/sky/${s.src}.webp`} data-alt={pick(lang, s.alt)} aria-pressed={s === first ? 'true' : 'false'} aria-label={`${ar ? 'الصورة' : 'Screenshot'} ${i + 1}: ${pick(lang, s.alt)}`}><img src={`${base}/img/sky/${s.src}.webp`} alt="" width="80" height="50" loading="lazy" decoding="async" /></button>)}</div>}
  </div>
  <div class="sr-card__body">
    <div class="sr-card__title"><h3 id={`project-${project.slug}`}><a href={workPath(lang, project.slug)}>{pick(lang, project.title)}</a></h3><span class="sr-status" data-public={!!feature.repo}>{feature.repo ? (ar ? 'عام' : 'Public') : (ar ? 'خاص' : 'Private')}{feature.version && <span dir="ltr"> · {feature.version}</span>}</span></div>
    <p class="sr-card__blurb">{pick(lang, project.blurb)}</p>
    <p class="sr-proof"><strong>{pick(lang, project.stat)}</strong><span>{pick(lang, project.statNote)}</span></p>
    <details class="sr-boundary"><summary>{ar ? 'الأدلة والنطاق والحدود' : 'Evidence, scope & limitations'}</summary><div>
      <dl>{story.proof.map(m => <div><dt>{pick(lang, m.label)}</dt><dd>{m.value}</dd></div>)}</dl>
      <p><strong>{pick(lang, story.boundaryKicker)}</strong> {pick(lang, story.boundary)}</p>
    </div></details>
    <div class="sr-card__links"><a class="sr-text-link" href={workPath(lang, project.slug)}>{ar ? 'دراسة المشروع' : 'Explore the project'}<svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="M3 10h13m-5-5 5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" /></svg></a>{feature.repo && <a href={feature.repo} target="_blank" rel="noopener noreferrer">GitHub</a>}{extra && <a href={extra.href} target="_blank" rel="noopener noreferrer">{pick(lang, extra.label)}</a>}</div>
  </div>
</article>

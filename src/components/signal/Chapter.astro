---
/**
 * One beat of DEEP FIELD.
 *
 * A chapter is a kicker, a heading, one line, and the links that let a reader
 * check it. Everything here is real HTML in document order: with no JavaScript,
 * with no WebGL, or with reduced motion on, the whole page is still a readable
 * list of work. The scene upgrades this composition; it never supplies it.
 */
import type { Lang } from '../../i18n/utils';

export interface SignalAction {
  href: string;
  label: string;
  external?: boolean;
  /** Left-to-right content (an address, a handle) inside an RTL page. */
  ltr?: boolean;
}

export interface SignalChapterCopy {
  id: string;
  act: 'hero' | 'worlds' | 'film' | 'public' | 'contact';
  kicker: string | null;
  /** The chapter heading. The hero's is the page's h1. */
  title: string;
  /** At most one line. */
  line: string | null;
  /** The hero's second line: the role, beneath the name. */
  role?: string | null;
  actions: SignalAction[];
}

interface Props {
  lang: Lang;
  chapter: SignalChapterCopy;
  index: number;
}
const { lang, chapter, index } = Astro.props;
const ar = lang === 'ar';
const hero = chapter.act === 'hero';
const titleId = `signal-${chapter.id}-title`;
---
<article
  class="signal__chapter"
  data-chapter={chapter.id}
  data-act={chapter.act}
  data-index={index}
  aria-labelledby={titleId}
  id={`signal-${chapter.id}`}
>
  <div class="signal__copy" data-chapter-copy>
    {chapter.kicker && <p class="signal__kicker">{chapter.kicker}</p>}

    {hero
      ? (
        <>
          {/* The name is the h1. When the scene is live the stars carry it, and
              this keeps the document's own heading exactly where it was. */}
          <h1 class="signal__name" id={titleId}>{chapter.title}</h1>
          {chapter.role && <p class="signal__role">{chapter.role}</p>}
          {chapter.line && <p class="signal__line" tabindex="-1">{chapter.line}</p>}
        </>
      )
      : (
        <>
          <h2 class="signal__title" id={titleId}>{chapter.title}</h2>
          {chapter.line && <p class="signal__line" tabindex="-1">{chapter.line}</p>}
        </>
      )}

    {chapter.actions.length > 0 && (
      <div class="signal__actions">
        {chapter.actions.map((action) => (
          <a
            class="signal__action"
            href={action.href}
            {...(action.external ? { target: '_blank', rel: 'noopener' } : {})}
            {...(action.ltr ? { dir: 'ltr' } : {})}
          >
            {action.label}
            <svg viewBox="0 0 20 20" width="15" height="15" aria-hidden="true">
              <path d="M3 10h13m-5-5 5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.5" />
            </svg>
          </a>
        ))}
      </div>
    )}

    {hero && (
      <p class="signal__hint" data-signal-hint>
        <span class="signal__hint-rule" aria-hidden="true"></span>
        {ar ? 'مرّر' : 'Scroll'}
      </p>
    )}
  </div>
</article>

---
/**
 * One beat of DEEP FIELD.
 *
 * A chapter is a kicker, a heading, one line, and the links that let a reader
 * check it. Everything here is real HTML in document order: with no JavaScript,
 * with no WebGL, or with reduced motion on, the whole page is still a readable
 * list of work. The scene upgrades this composition; it never supplies it.
 *
 * Two kinds of chapter carry something besides words. A world hangs its own key
 * frame inside the aperture the stars open for it, and a constellation chapter
 * hangs one label on each of its anchor stars — HTML, positioned every frame
 * from where the camera says that star is, because registration belongs to the
 * camera and not to a guess.
 */
import type { Lang } from '../../i18n/utils';

export interface SignalAction {
  href: string;
  label: string;
  external?: boolean;
  /** Left-to-right content (an address, a handle) inside an RTL page. */
  ltr?: boolean;
}

/** A label anchored to one star of a constellation. A chip without an `href`
 *  is not a control: it is the star's name, and nothing to click. */
export interface SignalLabel {
  key: string;
  label: string;
  href?: string;
}

/** A world's own key frame, shown inside that world's portal. */
export interface SignalPortal {
  src: string;
  alt: string;
  /** Intrinsic ratio, so the plate never has to guess its own shape. */
  aspect: number;
  width: number;
  height: number;
}

export interface SignalChapterCopy {
  id: string;
  act: 'hero' | 'worlds' | 'games' | 'voice' | 'systems' | 'tools' | 'public' | 'contact' | 'road';
  /** Which side the copy takes on a wide screen. The figure takes the other. */
  side: 'start' | 'end' | 'centre';
  kicker: string | null;
  /** The chapter heading. The hero's is the page's h1. */
  title: string;
  /** At most one line. */
  line: string | null;
  /** The hero's second line: the role, beneath the name. */
  role?: string | null;
  actions: SignalAction[];
  labels?: SignalLabel[];
  portal?: SignalPortal | null;
}

interface Props {
  lang: Lang;
  chapter: SignalChapterCopy;
  index: number;
}
const { lang, chapter, index } = Astro.props;
const ar = lang === 'ar';
const hero = chapter.act === 'hero';
const titleId = `signal-${chapter.id}-title`;
---
<article
  class="signal__chapter"
  data-chapter={chapter.id}
  data-act={chapter.act}
  data-side={chapter.side}
  data-index={index}
  aria-labelledby={titleId}
  id={`signal-${chapter.id}`}
>
  {chapter.portal && (
    /* The plate the aperture holds. `data-decoded` is the gate: the renderer
       only lets the blend rise once the browser says the frame is DECODED, so
       the ring never opens onto a blank rectangle that fills in afterwards.
       Width and height are the intrinsic ones — the stylesheet overrides both
       with the ring's measured box, and they are here so a no-JS page reserves
       the right space instead of shifting when the image lands. */
    <div class="signal__portal" data-signal-portal data-decoded="false"
         data-aspect={chapter.portal.aspect.toFixed(4)}>
      <img
        src={chapter.portal.src}
        alt={chapter.portal.alt}
        width={chapter.portal.width}
        height={chapter.portal.height}
        loading="lazy"
        decoding="async"
      />
    </div>
  )}

  {chapter.labels && chapter.labels.length > 0 && (
    /* Each label is a POINT at the projected star, with its chip hanging off
       it: that makes the element's own rect the anchor, so the four-pixel
       registration check has something exact to read. */
    <div class="signal__labels" data-signal-labels data-on="false">
      {chapter.labels.map((label) => (
        label.href
          ? (
            <a
              class="signal__label"
              data-label-key={label.key}
              data-side="left"
              href={label.href}
              target="_blank"
              rel="noopener"
            >
              <span class="signal__label-box" dir="ltr">{label.label}</span>
            </a>
          )
          : (
            <span class="signal__label" data-label-key={label.key} data-side="left">
              <span class="signal__label-box signal__label-box--plain" dir="ltr">{label.label}</span>
            </span>
          )
      ))}
    </div>
  )}

  <div class="signal__copy" data-chapter-copy>
    {chapter.kicker && <p class="signal__kicker">{chapter.kicker}</p>}

    {hero
      ? (
        <>
          {/* The name is the h1. When the scene is live the stars carry it, and
              this keeps the document's own heading exactly where it was. */}
          <h1 class="signal__name" id={titleId}>{chapter.title}</h1>
          {chapter.role && <p class="signal__role">{chapter.role}</p>}
          {chapter.line && <p class="signal__line" tabindex="-1">{chapter.line}</p>}
        </>
      )
      : (
        <>
          <h2 class="signal__title" id={titleId}>{chapter.title}</h2>
          {chapter.line && <p class="signal__line" tabindex="-1">{chapter.line}</p>}
        </>
      )}

    {chapter.actions.length > 0 && (
      <div class="signal__actions">
        {chapter.actions.map((action) => (
          <a
            class="signal__action"
            href={action.href}
            {...(action.external ? { target: '_blank', rel: 'noopener' } : {})}
            {...(action.ltr ? { dir: 'ltr' } : {})}
          >
            {action.label}
            <svg viewBox="0 0 20 20" width="15" height="15" aria-hidden="true">
              <path d="M3 10h13m-5-5 5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.5" />
            </svg>
          </a>
        ))}
      </div>
    )}

    {hero && (
      <p class="signal__hint" data-signal-hint>
        <span class="signal__hint-rule" aria-hidden="true"></span>
        {ar ? 'مرّر' : 'Scroll'}
      </p>
    )}
  </div>
</article>

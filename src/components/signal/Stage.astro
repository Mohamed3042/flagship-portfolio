---
import Chapter, { type SignalAction, type SignalChapterCopy } from './Chapter.astro';
import type { Lang } from '../../i18n/utils';
export type { SignalAction, SignalChapterCopy };

interface Props {
  lang: Lang;
  /** Already-resolved copy, one entry per chapter, in narrative order. */
  chapters: SignalChapterCopy[];
  /** Scroll runway length in viewport heights. The renderer maps it onto u in [0,1]. */
  runway?: number;
}
const { lang, chapters, runway = 16 } = Astro.props;
const ar = lang === 'ar';
// `data-graphics` is deliberately absent: the still composition is what the
// server ships, and it is complete. The renderer adds data-graphics="webgl"
// only once it holds a live context.
---
<div class="signal__stage" data-signal-stage style={`--signal-vh:${runway}`}>
  <a class="signal__skip" href="#work">{ar ? 'تخطَّ المشهد إلى الأعمال' : 'Skip the cinematic to the work'}</a>
  <div class="signal__runway" data-signal-runway>
    <div class="signal__frame" data-signal-frame>
      {chapters.map((chapter, i) => <Chapter lang={lang} chapter={chapter} index={i} />)}

      {/* Chapter navigation, and only that. It lives in the sticky frame but
          OUTSIDE every inert-toggled chapter panel, so it is reachable at any
          progress and never disappears from the tab order under a visitor. A
          scroll film that can only be advanced by scrolling is a film a keyboard
          cannot watch. */}
      <nav class="signal__seek" data-signal-seek
           aria-label={ar ? 'فصول المشهد' : 'Cinematic chapters'}>
        <button type="button" data-seek="prev">
          <svg viewBox="0 0 20 20" width="15" height="15" aria-hidden="true"><path d="M12 4 6 10l6 6" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>
          {ar ? 'السابق' : 'Previous'}
        </button>
        <button type="button" data-seek="next">
          {ar ? 'التالي' : 'Next'}
          <svg viewBox="0 0 20 20" width="15" height="15" aria-hidden="true"><path d="m8 4 6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>
        </button>
        <a class="signal__seek-out" href="#work" data-seek="work">{ar ? 'إلى الأعمال' : 'View work'}</a>
      </nav>
    </div>
  </div>
</div>

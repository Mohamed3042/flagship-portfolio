---
import { pick, type Lang } from '../../i18n/utils';
import { profile } from '../../data/profile';

interface Props {
  lang: Lang;
  projectCount: number;
  publicCount: number;
}
const { lang, projectCount, publicCount } = Astro.props;
const ar = lang === 'ar';

const l1 = ar ? 'أحوّل العمل اليدوي' : 'I turn manual work';
const l2 = ar ? 'إلى أنظمة تعمل.' : 'into systems that run.';
const lead = ar ? 'أرسم العملية. أبني الأداة. أضع البوابة. أثبت النتيجة.' : 'I map it. I build it. I gate it. I prove it.';
const status = ar
  ? `${pick(lang, profile.title)} · ${pick(lang, profile.location)} · ${projectCount.toLocaleString('ar-EG')} مشروعًا، منها ${publicCount.toLocaleString('ar-EG')} مستودعات عامة`
  : '';
const cta1 = ar ? 'شاهد الأنظمة' : 'See the systems';
const cta2 = ar ? 'تواصل معي' : 'Get in touch';
---

<section class:list={['skyhero', { 'is-ar': ar }]} id="intro" data-sky-stop="hero" aria-labelledby="skyhero-title">
  <div class="skyhero__halo" aria-hidden="true"></div>
  <div class="skyhero__wrap">
    <h1 id="skyhero-title" class="skyhero__title" data-ptext>
      <span class="skyhero__l1">{l1}</span>
      <span class="skyhero__l2">{l2}</span>
    </h1>
    <p class="skyhero__lead" data-tx>{lead}</p>
    <div class="skyhero__cta">
      <a class="skyhero__btn skyhero__btn--primary" href="#work">
        {cta1}
        <svg class="skyhero__arr" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="M4 10h11m-4-4 4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg>
      </a>
      <a class="skyhero__btn skyhero__btn--ghost" href="#contact">{cta2}</a>
    </div>
    {
      ar ? (
        <p class="skyhero__status" data-tx>{status}</p>
      ) : (
        <p class="skyhero__status" data-tx>
          {pick(lang, profile.title)} · {pick(lang, profile.location)} · <b data-count={projectCount} style={`display:inline-block;min-width:${String(projectCount).length}ch;text-align:end`}>{projectCount}</b> systems · <b data-count={publicCount} style={`display:inline-block;min-width:${String(publicCount).length}ch;text-align:end`}>{publicCount}</b> public repositories
        </p>
      )
    }
  </div>
  <div class="skyhero__cue" aria-hidden="true"><span>{ar ? 'مرّر' : 'Scroll'}</span><b><i></i></b></div>
</section>

<style>
  .skyhero {
    position: relative;
    z-index: 1;
    min-height: 100svh;
    display: grid;
    place-items: center;
    padding: 96px clamp(20px, 5vw, 40px) 84px;
    text-align: center;
    isolation: isolate;
  }
  /* A dark lens behind the words: the galaxy core sits right behind the
     headline, and the headline must win. */
  .skyhero__halo {
    position: absolute;
    left: 50%;
    top: 48%;
    width: min(1180px, 124vw);
    height: min(720px, 92vh);
    transform: translate(-50%, -50%);
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(52% 40% at 50% 56%, rgba(3, 3, 10, 0.62), rgba(3, 3, 10, 0.3) 60%, transparent 82%);
  }
  .skyhero__wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 1100px;
  }
  .skyhero__title {
    margin: 0;
    font-weight: 860;
    font-size: clamp(40px, 7.4vw, 98px);
    line-height: 1.01;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }
  .skyhero__l1,
  .skyhero__l2 {
    display: block;
    animation: skyRise 1.1s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .skyhero__l1 {
    color: var(--ink);
    text-shadow: 0 2px 30px rgba(3, 3, 10, 0.75);
  }
  .skyhero__l2 {
    animation-delay: 0.12s;
    /* the incumbent hero ramp and its shimmer, unchanged */
    background: linear-gradient(100deg, #ff5e8a, #a259ff 34%, #2997ff 66%, #64d2ff);
    background-size: 220% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: skyRise 1.1s 0.12s cubic-bezier(0.16, 1, 0.3, 1) both, skyShimmer 9s ease-in-out infinite;
    filter: drop-shadow(0 6px 40px rgba(120, 110, 255, 0.35));
  }
  @keyframes skyShimmer {
    0%,
    100% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
  }
  .skyhero.is-ar .skyhero__title {
    font-family: var(--font-ar-display);
    letter-spacing: 0;
    line-height: 1.18;
    font-size: clamp(34px, 6.4vw, 86px);
  }
  .skyhero__lead {
    margin: clamp(22px, 3.2vh, 32px) 0 0;
    max-width: 46ch;
    color: var(--ink);
    font-weight: 560;
    letter-spacing: -0.01em;
    text-shadow: 0 1px 18px rgba(3, 3, 10, 0.95);
    font-size: clamp(16px, 1.75vw, 20px);
    line-height: 1.55;
    animation: skyRise 1.1s 0.24s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .skyhero.is-ar .skyhero__lead {
    max-width: 40ch;
    line-height: 1.75;
  }
  .skyhero__cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: clamp(26px, 4vh, 38px);
    animation: skyRise 1.1s 0.36s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .skyhero__btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 50px;
    padding: 0 26px;
    border-radius: 999px;
    font-size: 16px;
    font-weight: 620;
    letter-spacing: -0.01em;
    border: 1px solid transparent;
    transition: transform 0.35s var(--ease-expo), box-shadow 0.35s var(--ease-expo), background-color 0.35s, border-color 0.35s;
  }
  .skyhero__btn--primary {
    color: #fff;
    background: linear-gradient(120deg, #2997ff, #a259ff);
    box-shadow: 0 16px 40px -16px rgba(80, 120, 255, 0.9), inset 0 1px 0 rgba(255, 255, 255, 0.25);
  }
  .skyhero__btn--primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 24px 56px -18px rgba(100, 120, 255, 1), inset 0 1px 0 rgba(255, 255, 255, 0.3);
  }
  .skyhero__arr {
    transition: transform 0.35s var(--ease-expo);
  }
  .skyhero.is-ar .skyhero__arr {
    transform: scaleX(-1);
  }
  .skyhero__btn--primary:hover .skyhero__arr {
    transform: translateX(4px);
  }
  .skyhero.is-ar .skyhero__btn--primary:hover .skyhero__arr {
    transform: scaleX(-1) translateX(4px);
  }
  .skyhero__btn--ghost {
    color: var(--ink);
    background: rgba(8, 9, 20, 0.45);
    border-color: rgba(255, 255, 255, 0.18);
  }
  .skyhero__btn--ghost:hover {
    transform: translateY(-2px);
    border-color: rgba(255, 255, 255, 0.36);
  }
  .skyhero__btn:focus-visible {
    outline: 2px solid #64d2ff;
    outline-offset: 3px;
  }
  .skyhero__status {
    margin-top: 22px;
    font-family: var(--font-label);
    font-size: 13px;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
    color: var(--ink-3);
    animation: skyRise 1.1s 0.48s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .skyhero__cue {
    position: absolute;
    left: 50%;
    bottom: 22px;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    font-family: var(--font-label);
    font-size: 12px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--ink-2);
  }
  .skyhero.is-ar .skyhero__cue {
    letter-spacing: 0;
    font-family: var(--font-ar);
    font-size: 14px;
  }
  .skyhero__cue b {
    position: relative;
    width: 2px;
    height: 44px;
    overflow: hidden;
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.16);
  }
  .skyhero__cue i {
    position: absolute;
    inset: 0;
    background: linear-gradient(transparent, #9fd8ff);
    animation: skyCue 2.4s cubic-bezier(0.83, 0, 0.17, 1) infinite;
  }
  @keyframes skyRise {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
  }
  @keyframes skyCue {
    from {
      transform: translateY(-100%);
    }
    to {
      transform: translateY(100%);
    }
  }
  :global([data-theme='light']) .skyhero__halo {
    background: radial-gradient(56% 48% at 50% 50%, rgba(246, 246, 252, 0.82), rgba(246, 246, 252, 0.4) 58%, transparent 80%);
  }
  :global([data-theme='light']) .skyhero__btn--ghost {
    background: rgba(255, 255, 255, 0.6);
    border-color: rgba(0, 0, 0, 0.14);
  }
  @media (max-width: 560px) {
    .skyhero__cta {
      width: 100%;
    }
    .skyhero__btn {
      flex: 1 1 auto;
      justify-content: center;
    }
  }
</style>

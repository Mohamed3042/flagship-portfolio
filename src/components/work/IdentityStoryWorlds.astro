---
import { projects, type ProjectMeta } from '../../data/projects';
import { storyForProject } from '../../data/project-kinetics';
import { homePath, pick, type Lang } from '../../i18n/utils';
import ProjectKinetic from './ProjectKinetic.astro';
import DisneyProjectBook from './worlds/DisneyProjectBook.astro';

interface Props { lang: Lang; project: ProjectMeta }
const { lang, project } = Astro.props;
const story = storyForProject(project, lang);
const ar = lang === 'ar';
const no = String(projects.findIndex((item) => item.slug === project.slug) + 1).padStart(2, '0');
const hash = [...project.slug].reduce((sum, char) => sum + char.charCodeAt(0), 0);
const shape = ['relay', 'vault', 'ledger', 'studio', 'simulation'][hash % 5];
const back = homePath(lang) + '#work';
const arrow = ar ? '←' : '→';
---

<div class="story-worlds" data-story-world-experience data-story-shape={shape} style={`--story-a:${project.cardA};--story-b:${project.cardB}`}>
  <article class="sworld sworld--razer" data-story-world="razer" aria-hidden="true">
    <section class="sworld-stage rzstory-boot" data-story-stage><div class="sworld-stick">
      <ProjectKinetic project={project} lang={lang} world="razer" phase="input" />
      <div class="rzstory-frame" aria-hidden="true"><i></i><i></i><i></i><b></b></div>
      <div class="rzstory-head"><span>FLIGHT RECORDER / {no}</span><div class="story-heading" role="heading" aria-level="1" set:html={pick(lang, story.headline)}></div><p>{pick(lang, story.lead)}</p><div><a href={back}>{arrow} {ar ? 'كل الأنظمة' : 'All systems'}</a>{story.link && <a href={story.link.href} target="_blank" rel="noopener">{pick(lang, story.link.label)} ↗</a>}</div></div>
      <aside><span>CARTRIDGE</span><b>{project.slug.toUpperCase()}</b><i>{pick(lang, project.stat)}</i><small>{pick(lang, project.statNote)}</small></aside>
    </div></section>
    <section class="sworld-stage rzstory-trace" data-story-stage><div class="sworld-stick">
      <div class="story-mechanism story-mechanism--sticky"><ProjectKinetic project={project} lang={lang} world="razer" phase="run" /></div>
      <div class="rzstory-tape" aria-hidden="true"><span>INPUT</span>{story.steps.map((step) => <><i></i><b>{step.n}</b></>)}<i></i><span>OUTPUT</span></div>
      <div class="rzstory-map"><span>{pick(lang, story.problemKicker)}</span><h2>{pick(lang, story.problemHeading)}</h2><p>{pick(lang, story.problemBody)}</p></div>
      <ol>{story.steps.map((step) => <li><span>{step.n}</span><b>{pick(lang, step.title)}</b><p>{pick(lang, step.body)}</p></li>)}</ol>
    </div></section>
    <section class="sworld-stage rzstory-proof" data-story-stage><div class="sworld-stick">
      <div class="rzstory-display"><span>READBACK / VERIFIED OUTPUT</span><h2>{pick(lang, story.proofHeading)}</h2><p>{pick(lang, story.proofBody)}</p><div>{story.proof.map((metric) => <b><strong>{metric.value}</strong><small>{pick(lang, metric.label)}</small></b>)}</div></div>
      <div class="rzstory-key"><span>HUMAN<br/>APPROVAL</span></div>
    </div></section>
    <section class="rzstory-limit"><span>{pick(lang, story.boundaryKicker)}</span><h2>{ar ? 'حد التشغيل.' : 'Operating limit.'}</h2><p>{pick(lang, story.boundary)}</p><div>{story.tools.map((tool) => <i>{tool}</i>)}</div><a href={back}>{ar ? 'أغلق السجل' : 'Close recorder'} {arrow}</a></section>
  </article>

  <DisneyProjectBook lang={lang} project={project} />

  <article class="sworld sworld--cod" data-story-world="cod" aria-hidden="true">
    <section class="sworld-stage codstory-brief" data-story-stage><div class="sworld-stick"><ProjectKinetic project={project} lang={lang} world="cod" phase="input" /><div class="codstory-grid" aria-hidden="true"><i></i><i></i><b></b></div><div class="codstory-copy"><span>MISSION {no} / {project.slug.toUpperCase()}</span><div class="story-heading" role="heading" aria-level="1">{pick(lang, project.title)}</div><p>{pick(lang, story.lead)}</p><dl><div><dt>OBJECTIVE</dt><dd>{pick(lang, story.problemHeading)}</dd></div><div><dt>STATUS</dt><dd>{pick(lang, project.stat)}</dd></div><div><dt>ROE</dt><dd>VERIFY / FAIL CLOSED</dd></div></dl></div></div></section>
    <section class="codstory-operation"><header><span>OPERATION ROUTE</span><h2>{pick(lang, story.stepsHeading)}</h2></header><div class="story-mechanism"><ProjectKinetic project={project} lang={lang} world="cod" phase="run" /></div><ol>{story.steps.map((step, i) => <li style={`--i:${i}`}><span>{step.n}</span><div><h3>{pick(lang, step.title)}</h3><p>{pick(lang, step.body)}</p></div><i></i></li>)}</ol></section>
    <section class="codstory-aar"><header><span>AFTER-ACTION REPORT</span><h2>{pick(lang, story.proofHeading)}</h2><p>{pick(lang, story.proofBody)}</p></header><div>{story.proof.map((metric) => <article><strong>{metric.value}</strong><span>{pick(lang, metric.label)}</span></article>)}</div><aside><b>RULES OF ENGAGEMENT</b><p>{pick(lang, story.boundary)}</p></aside><footer>{story.tools.map((tool) => <i>{tool}</i>)}<a href={back}>EXFIL {arrow}</a></footer></section>
  </article>

  <article class="sworld sworld--netflix" data-story-world="netflix" aria-hidden="true">
    <section class="sworld-stage nfstory-cold" data-story-stage><div class="sworld-stick"><ProjectKinetic project={project} lang={lang} world="netflix" phase="input" /><div class="nfstory-mark" aria-hidden="true">N</div><div class="nfstory-copy"><span><b>N</b> ORIGINAL SYSTEM · EPISODE {no}</span><div class="story-heading" role="heading" aria-level="1">{pick(lang, project.title)}</div><p>{pick(lang, story.lead)}</p><div><a href="#episode">▶ {ar ? 'تشغيل الحلقة' : 'Play episode'}</a><a href={back}>ⓘ {ar ? 'كل الحلقات' : 'All episodes'}</a></div></div><aside><b>{pick(lang, project.stat)}</b><span>{pick(lang, project.statNote)}</span></aside></div></section>
    <section class="nfstory-episode" id="episode"><header><span>S{project.section === 'automation' ? '01' : project.section === 'lab' ? '03' : '02'} E{no}</span><h2>{pick(lang, story.problemHeading)}</h2><p>{pick(lang, story.problemBody)}</p></header><div class="story-mechanism"><ProjectKinetic project={project} lang={lang} world="netflix" phase="run" /></div><ol>{story.steps.map((step) => <li><span>{step.n}</span><div><h3>{pick(lang, step.title)}</h3><p>{pick(lang, step.body)}</p></div><i>▶</i></li>)}</ol></section>
    <section class="nfstory-credits"><div><span>{ar ? 'نهاية الحلقة' : 'Episode result'}</span><h2>{pick(lang, story.proofHeading)}</h2><p>{pick(lang, story.proofBody)}</p></div><dl>{story.proof.map((metric) => <div><dt>{metric.value}</dt><dd>{pick(lang, metric.label)}</dd></div>)}</dl><aside><b>{ar ? 'ملاحظات الإنتاج' : 'Production notes'}</b><p>{pick(lang, story.boundary)}</p></aside><a href={back}>{ar ? 'الحلقة التالية' : 'Back to episodes'} {arrow}</a></section>
  </article>

  <article class="sworld sworld--spotify" data-story-world="spotify" aria-hidden="true">
    <section class="sworld-stage spstory-player" data-story-stage><div class="sworld-stick"><ProjectKinetic project={project} lang={lang} world="spotify" phase="input" /><div class="spstory-art" aria-hidden="true"><b>{story.ghost}</b><i></i><span>{no}</span></div><div class="spstory-copy"><span>SONG</span><div class="story-heading" role="heading" aria-level="1">{pick(lang, project.title)}</div><p>{pick(lang, story.lead)}</p><div><button type="button">▶</button><a href={back}>{ar ? 'قائمة المسارات' : 'Track list'}</a></div></div><footer><span>0:00</span><i><b></b></i><span>PROOF</span></footer></div></section>
    <section class="spstory-queue"><header><h2>{ar ? 'داخل المسار' : 'Inside the track'}</h2><span>{pick(lang, story.stepsHeading)}</span></header><div class="story-mechanism"><ProjectKinetic project={project} lang={lang} world="spotify" phase="run" /></div>{story.steps.map((step, i) => <article><span>{String(i + 1).padStart(2,'0')}</span><i style={`--i:${i}`}></i><div><h3>{pick(lang, step.title)}</h3><p>{pick(lang, step.body)}</p></div><em>{step.n}</em></article>)}</section>
    <section class="spstory-notes"><header><span>{ar ? 'ملاحظات الألبوم' : 'Liner notes'}</span><h2>{pick(lang, story.proofHeading)}</h2><p>{pick(lang, story.proofBody)}</p></header><dl>{story.proof.map((metric) => <div><dt>{metric.value}</dt><dd>{pick(lang, metric.label)}</dd></div>)}</dl><aside><b>{ar ? 'المسار لا يدّعي' : 'What this track does not claim'}</b><p>{pick(lang, story.boundary)}</p></aside></section>
  </article>

  <article class="sworld sworld--apple" data-story-world="apple" aria-hidden="true">
    <section class="sworld-stage apstory-keynote" data-story-stage><div class="sworld-stick"><ProjectKinetic project={project} lang={lang} world="apple" phase="input" /><div class="apstory-object" aria-hidden="true"><i></i><b>{story.ghost}</b><span>{no}</span></div><div class="apstory-copy"><div class="story-heading" role="heading" aria-level="1">{pick(lang, project.title)}</div><p>{pick(lang, story.lead)}</p><a href="#apple-details">{ar ? 'شاهد كيف تعمل' : 'See how it works'} {arrow}</a></div></div></section>
    <section class="sworld-stage apstory-explode" id="apple-details" data-story-stage><div class="sworld-stick"><div class="story-mechanism story-mechanism--sticky"><ProjectKinetic project={project} lang={lang} world="apple" phase="run" /></div><div class="apstory-layers" aria-hidden="true">{story.steps.map((step, i) => <div style={`--i:${i}`}><span>{step.n}</span><b>{pick(lang, step.title)}</b></div>)}</div><div class="apstory-detail"><h2>{pick(lang, story.problemHeading)}</h2><p>{pick(lang, story.problemBody)}</p></div></div></section>
    <section class="apstory-proof"><header><h2>{pick(lang, story.proofHeading)}</h2><p>{pick(lang, story.proofBody)}</p></header><div>{story.proof.map((metric) => <article><strong>{metric.value}</strong><span>{pick(lang, metric.label)}</span></article>)}</div><aside><h3>{ar ? 'التفاصيل المهمة.' : 'The fine print that matters.'}</h3><p>{pick(lang, story.boundary)}</p></aside><footer>{story.tools.map((tool) => <i>{tool}</i>)}<a href={back}>{ar ? 'قارن كل الأنظمة' : 'Compare every system'} {arrow}</a></footer></section>
  </article>

  <article class="sworld sworld--samsung" data-story-world="samsung" aria-hidden="true">
    <section class="sworld-stage smstory-unfold" data-story-stage><div class="sworld-stick"><ProjectKinetic project={project} lang={lang} world="samsung" phase="input" /><div class="smstory-device" aria-hidden="true"><div><span>INPUT</span><b>{story.ghost}</b></div><i></i><div><span>OUTPUT</span><strong>{pick(lang, project.stat)}</strong></div></div><div class="smstory-copy"><span>CONNECTED STORY / {no}</span><div class="story-heading" role="heading" aria-level="1">{pick(lang, project.title)}</div><p>{pick(lang, story.lead)}</p></div></div></section>
    <section class="smstory-flow"><header><h2>{pick(lang, story.stepsHeading)}</h2><p>{pick(lang, story.problemBody)}</p></header><div class="story-mechanism"><ProjectKinetic project={project} lang={lang} world="samsung" phase="run" /></div><div>{story.steps.map((step, i) => <article style={`--i:${i}`}><span>{step.n}</span><i></i><h3>{pick(lang, step.title)}</h3><p>{pick(lang, step.body)}</p></article>)}</div></section>
    <section class="smstory-specs"><header><span>LAB RESULTS</span><h2>{pick(lang, story.proofHeading)}</h2><p>{pick(lang, story.proofBody)}</p></header><dl>{story.proof.map((metric) => <div><dt>{metric.value}</dt><dd>{pick(lang, metric.label)}</dd></div>)}</dl><aside><b>{ar ? 'حدود الاتصال' : 'Connection boundary'}</b><p>{pick(lang, story.boundary)}</p></aside><footer>{story.tools.map((tool) => <i>{tool}</i>)}<a href={back}>{ar ? 'افتح النظام البيئي' : 'Open the ecosystem'} {arrow}</a></footer></section>
  </article>
</div>

<script>
  let storyWorldCleanup: (() => void) | null = null;
  function initStoryWorlds() {
    storyWorldCleanup?.();
    const root = document.querySelector<HTMLElement>('[data-story-world-experience]');
    if (!root) return;
    let raf = 0;
    const sync = () => {
      const world = document.documentElement.dataset.world || 'astronomy';
      root.querySelectorAll<HTMLElement>('[data-story-world]').forEach((story) => {
        const active = story.dataset.storyWorld === world;
        story.setAttribute('aria-hidden', String(!active));
        if ('inert' in story) story.inert = !active;
      });
      update();
    };
    const update = () => {
      raf = 0;
      root.querySelectorAll<HTMLElement>('[data-story-stage]').forEach((stage) => {
        if (stage.offsetParent === null) return;
        const rect = stage.getBoundingClientRect();
        const p = Math.max(0, Math.min(1, -rect.top / Math.max(1, rect.height - innerHeight)));
        stage.style.setProperty('--p', p.toFixed(4));
      });
    };
    const queue = () => { if (!raf) raf = requestAnimationFrame(update); };
    sync(); addEventListener('scroll', queue, { passive: true }); addEventListener('resize', queue, { passive: true }); document.addEventListener('mm:worldchange', sync);
    storyWorldCleanup = () => { if (raf) cancelAnimationFrame(raf); removeEventListener('scroll', queue); removeEventListener('resize', queue); document.removeEventListener('mm:worldchange', sync); };
  }
  initStoryWorlds(); document.addEventListener('astro:page-load', initStoryWorlds);
</script>

<style is:global>
  .story-worlds,.sworld{display:none}.sworld[aria-hidden="false"]{display:block}.sworld{position:relative;z-index:2;overflow:clip}.sworld-stage{position:relative;height:210vh}.sworld-stick{position:sticky;top:0;height:100svh;min-height:620px;overflow:hidden;isolation:isolate}.sworld h1,.sworld h2,.sworld h3,.sworld p{margin-top:0}.sworld a:focus-visible{outline:3px solid currentColor;outline-offset:5px}html[data-world]:not([data-world="astronomy"]) .story-worlds{display:block}html[data-world]:not([data-world="astronomy"]) .system-story--astronomy{display:none!important}
  .sworld-stick>.project-kinetic{position:absolute!important;z-index:1;left:auto!important;right:3vw!important;top:13%!important;width:min(52vw,820px)!important;min-height:0;opacity:calc(.68 + var(--p)*.32);transform:perspective(1200px) translateY(calc((1 - var(--p))*60px)) rotateX(calc((1 - var(--p))*6deg))!important;transform-origin:center bottom}.spstory-player .sworld-stick>.project-kinetic{left:4vw!important;right:auto!important;top:14%!important;width:min(47vw,720px)!important}.rzstory-frame,.dstory-book,.codstory-grid,.nfstory-mark,.spstory-art,.apstory-object,.smstory-device{opacity:.14!important;filter:saturate(.65)}
  .sworld--razer{background:#030604;color:#eef6ee;font-family:var(--font-display)}.rzstory-boot .sworld-stick,.rzstory-trace .sworld-stick,.rzstory-proof .sworld-stick{background:radial-gradient(circle at 65% 45%,color-mix(in srgb,var(--story-a) 14%,transparent),transparent 28%),#030604}.rzstory-frame{position:absolute;inset:6vh 4vw;border:1px solid #44d62c66;clip-path:polygon(0 7%,7% 0,93% 0,100% 7%,100% 93%,93% 100%,7% 100%,0 93%);transform:scale(calc(.86 + var(--p)*.14))}.rzstory-frame::before,.rzstory-frame::after{content:"";position:absolute;inset:7%;border:1px solid #00e0ff24}.rzstory-frame::after{inset:15%;border-color:#ff2dc422}.rzstory-frame i{position:absolute;width:13px;height:13px;background:var(--story-a);box-shadow:0 0 22px var(--story-a)}.rzstory-frame i:nth-child(1){left:10%;top:11%}.rzstory-frame i:nth-child(2){right:12%;top:18%}.rzstory-frame i:nth-child(3){right:20%;bottom:12%}.rzstory-frame b{position:absolute;left:50%;top:50%;width:35vw;height:2px;background:linear-gradient(90deg,transparent,var(--story-a),transparent);transform:translate(-50%,-50%) rotate(calc(var(--p)*120deg))}.rzstory-head{position:absolute;z-index:2;left:7vw;top:22%;width:min(790px,70vw)}.rzstory-head>span,.rzstory-map>span,.rzstory-display>span,.rzstory-limit>span{color:#44d62c;font:800 10px var(--font-mono);letter-spacing:.17em}.rzstory-head h1{margin:18px 0;font-size:clamp(54px,8vw,112px);line-height:.88;letter-spacing:-.035em}.rzstory-head h1 :global(.gradient-text){color:var(--story-a);background:none;-webkit-text-fill-color:currentColor}.rzstory-head p{max-width:64ch;color:#b6c3b7;font-size:clamp(16px,1.4vw,21px);line-height:1.6}.rzstory-head>div{display:flex;gap:12px;margin-top:26px}.rzstory-head a,.rzstory-limit>a{padding:13px 18px;color:#e9f5e9;text-decoration:none;border:1px solid #44d62c55}.rzstory-head a:last-child{background:#44d62c;color:#020402;font-weight:800}.rzstory-boot aside{position:absolute;right:6vw;bottom:7vh;width:260px;padding:22px;border:1px solid #44d62c44;background:#090e0a;font-family:var(--font-mono);transform:translateY(calc((1 - var(--p))*40px))}.rzstory-boot aside span,.rzstory-boot aside b,.rzstory-boot aside i,.rzstory-boot aside small{display:block}.rzstory-boot aside span{color:#76947b;font-size:9px}.rzstory-boot aside b{margin:15px 0;color:#44d62c;word-break:break-all}.rzstory-boot aside i{color:var(--story-a);font-size:25px;font-style:normal}.rzstory-boot aside small{margin-top:8px;color:#9aac9c}.rzstory-tape{position:absolute;left:6vw;right:6vw;top:17%;display:flex;align-items:center;gap:0}.rzstory-tape span,.rzstory-tape b{padding:12px 16px;border:1px solid #44d62c55;background:#081009;color:#d9e6da;font:800 10px var(--font-mono)}.rzstory-tape i{flex:1;height:2px;background:linear-gradient(90deg,#44d62c,var(--story-a));transform:scaleX(var(--p));transform-origin:left}.rzstory-map{position:absolute;left:6vw;top:31%;width:min(600px,42vw)}.rzstory-map h2{margin:18px 0;font-size:clamp(42px,6vw,82px);line-height:.92}.rzstory-map p{color:#aebbae;line-height:1.6}.rzstory-trace ol{position:absolute;right:5vw;top:29%;width:min(48vw,700px);display:grid;grid-template-columns:repeat(2,1fr);gap:12px;list-style:none;margin:0;padding:0}.rzstory-trace li{min-height:190px;padding:22px;background:linear-gradient(145deg,color-mix(in srgb,var(--story-a) 10%,#0b100c),#070a08);border-top:1px solid var(--story-a)}.rzstory-trace li span{color:var(--story-a);font:800 10px var(--font-mono)}.rzstory-trace li b{display:block;margin:40px 0 10px;font-size:21px}.rzstory-trace li p{color:#aebbae;font-size:13px;line-height:1.45}.rzstory-display{position:absolute;left:6vw;top:17%;width:min(75vw,980px);min-height:58vh;padding:clamp(28px,5vw,64px);background:#111007;border:1px solid #ffad3366;box-shadow:inset 0 0 90px #ff9f0a0e}.rzstory-display h2{margin:25px 0;font-size:clamp(45px,7vw,90px);line-height:.9;color:#ffd28a}.rzstory-display p{max-width:68ch;color:#c8b99d;line-height:1.6}.rzstory-display>div{display:flex;gap:1px;margi
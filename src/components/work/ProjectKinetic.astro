        <g class="agents"><circle cx="162" cy="115" r="52"/><circle cx="638" cy="115" r="52"/><circle cx="400" cy="375" r="52"/></g><path class="flow" pathLength="1" d="M208 140 347 204M592 140 453 204M400 323v-31"/><path class="approval-ring spin" d="M400 115a115 115 0 1 1-1 0"/><text x="362" y="238">HUMAN</text>

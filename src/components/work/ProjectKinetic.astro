---
import type { ProjectMeta } from '../../data/projects';
import { kineticSpecFor } from '../../data/project-kinetics';
import { pick, type Lang } from '../../i18n/utils';

interface Props {
  project: ProjectMeta;
  lang: Lang;
  world?: 'astronomy' | 'razer' | 'disney' | 'cod' | 'netflix' | 'spotify' | 'apple' | 'samsung';
  compact?: boolean;
  phase?: 'input' | 'run' | 'proof';
}

const { project, lang, world = 'astronomy', compact = false, phase = 'run' } = Astro.props;
const spec = kineticSpecFor(project);
const slug = project.slug;
const stages = spec.stages.map((label, index) => ({ label: pick(lang, label), index }));
---

<figure
  class:list={['project-kinetic', compact && 'project-kinetic--compact']}
  data-project-kinetic
  data-kinetic={slug}
  data-kinetic-world={world}
  data-kinetic-phase={phase}
  style={`--ka:${project.cardA};--kb:${project.cardB};view-transition-name:kinetic-${slug}`}
  aria-label={`${pick(lang, project.title)} — ${pick(lang, project.stat)}`}
>
  <div class="kinetic-chrome" aria-hidden="true"><i></i><i></i><i></i><span>{spec.code}</span></div>
  <div class="kinetic-viewport" aria-hidden="true">
    <svg viewBox="0 0 800 460" role="presentation">
      <defs>
        <linearGradient id={`kg-${slug}`} x1="0" y1="0" x2="1" y2="1"><stop stop-color={project.cardA}/><stop offset="1" stop-color={project.cardB}/></linearGradient>
        <radialGradient id={`kr-${slug}`}><stop stop-color={project.cardA}/><stop offset="1" stop-color={project.cardB} stop-opacity="0"/></radialGradient>
        <filter id={`glow-${slug}`} x="-80%" y="-80%" width="260%" height="260%"><feGaussianBlur stdDeviation="8" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
        <pattern id={`grid-${slug}`} width="32" height="32" patternUnits="userSpaceOnUse"><path d="M32 0H0V32" fill="none" stroke="currentColor" stroke-opacity=".09"/></pattern>
      </defs>
      <rect width="800" height="460" fill={`url(#grid-${slug})`} class="kinetic-grid"/>
      <path class="kinetic-horizon" d="M40 374H760" pathLength="1"/>

      {slug === 'career-autopilot' && <g class="signature approval">
        <g class="job-cards"><rect x="65" y="105" width="132" height="76" rx="12"/><rect x="82" y="193" width="132" height="76" rx="12"/><rect x="65" y="281" width="132" height="76" rx="12"/></g>
        <path class="flow" pathLength="1" d="M216 230H360"/><rect class="gate" x="360" y="96" width="82" height="270" rx="18"/><circle class="human" cx="401" cy="177" r="22"/><path class="human" d="M365 272c10-56 62-56 72 0"/>
        <path class="flow" pathLength="1" d="M442 230H650"/><g class="send"><rect x="608" y="185" width="112" height="90" rx="16"/><path d="m630 232 30 22 36-44"/></g><circle class="packet" cx="298" cy="230" r="10"/>
      </g>}
      {slug === 'lifeos' && <g class="signature local-ai">
        <path class="shield" d="M400 62 585 126v116c0 100-80 150-185 176-105-26-185-76-185-176V126z"/>
        <circle class="core spin" cx="400" cy="224" r="82"/><circle class="core" cx="400" cy="224" r="35"/><g class="orbit spin"><ellipse cx="400" cy="224" rx="143" ry="48"/><circle cx="543" cy="224" r="10"/><ellipse cx="400" cy="224" rx="48" ry="143"/><circle cx="400" cy="81" r="10"/></g>
        <path class="flow" pathLength="1" d="M112 224h100M588 224h100"/><path class="lock" d="M378 216v-24c0-31 44-31 44 0v24m-58 0h72v69h-72z"/>
      </g>}
      {slug === 'medmac-document-studio' && <g class="signature document">
        <g class="page page-a"><path d="M92 83h206l50 50v248H92z"/><path d="M298 83v50h50M126 182h158M126 220h112M126 258h148"/></g>
        <g class="page page-b"><path d="M452 83h206l50 50v248H452z"/><path d="M658 83v50h50M488 182h158M532 220h112M496 258h148"/></g>
        <path class="merge flow" pathLength="1" d="M342 231h116"/><circle class="press" cx="400" cy="231" r="38"/><path d="m382 231 13 14 26-31"/>
      </g>}
      {slug === 'medmac-box-studio' && <g class="signature box-studio">

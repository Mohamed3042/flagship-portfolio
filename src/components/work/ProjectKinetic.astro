        <g class="proof"><rect x="588" y="126" width="146" height="208" rx="12"/><path d="M614 175h94M614 216h94M614 257h94"/></g>
      </g>}
      {slug === 'spaceframe-world' && <g class="signature frame-solver">
        <g class="truss draw"><path pathLength="1" d="M64 328 150 130l92 198 88-198 92 198 90-198 92 198 82-198 70 198M64 328h672M150 130h180M330 130h182M512 130h174"/></g>
        <g class="nodes">{[64,150,242,330,422,512,604,686,736].map((x,i)=><circle cx={x} cy={i===1||i===3||i===5||i===7?130:328} r="8"/>)}</g><path class="load" d="M400 48v122m-18-20 18 20 18-20"/><path class="deform" d="M64 348q336 70 672 0"/>
      </g>}
      {slug === 'b2mh' && <g class="signature texture">
        <g class="face source"><path d="M92 110c40-70 178-70 218 0v150c0 92-55 142-109 142S92 352 92 260z"/><path d="M128 190h48m50 0h48M201 204v58m-38 54q38 28 76 0"/></g>

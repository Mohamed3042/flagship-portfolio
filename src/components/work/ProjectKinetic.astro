      </g>}
      {slug === 'crm' && <g class="signature crm">
        <g class="columns">{Array.from({length:6}).map((_, i) => <g><rect x={60 + i * 116} y="76" width="94" height="310" rx="12"/><circle cx={107 + i * 116} cy="112" r="10"/></g>)}</g>

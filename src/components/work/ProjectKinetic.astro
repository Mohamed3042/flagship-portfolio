        <path class="flow" pathLength="1" d="M480 230h82"/><g class="files"><rect x="562" y="105" width="150" height="54" rx="8"/><rect x="582" y="181" width="150" height="54" rx="8"/><rect x="562" y="257" width="150" height="54" rx="8"/><rect x="582" y="333" width="150" height="54" rx="8"/></g>

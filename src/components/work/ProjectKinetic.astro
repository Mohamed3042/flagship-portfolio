        <g class="unity-six"><path d="m532 91 194 68v142l-194 68-91-139z"/><text x="556" y="252">UNITY 6</text></g>
      </g>}
      {slug === 'cocolani-3d' && <g class="signature world-audit">
        <g class="islands"><path d="M65 168q70-115 160 0t166 0q75-105 164 0t180 0v165H65z"/></g><g class="audit-flags"><circle cx="154" cy="178" r="20"/><circle cx="400" cy="168" r="20"/><circle cx="650" cy="178" r="20"/><text x="146" y="184">V</text><text x="394" y="174">I</text><text x="644" y="184">L</text></g>
        <path class="scanline" d="M40 80h720"/><g class="private-lock"><rect x="330" y="294" width="140" height="88" rx="14"/><path d="M360 294v-34c0-55 80-55 80 0v34"/></g>

        <path class="flow" pathLength="1" d="M330 238h124"/><g class="vault-door"><rect x="454" y="78" width="260" height="320" rx="22"/><circle class="spin" cx="584" cy="238" r="72"/><path d="M584 166v144M512 238h144M533 187l102 102M635 187 533 289"/></g>
        <g class="hash-chain"><circle cx="377" cy="320" r="9"/><circle cx="410" cy="340" r="9"/><circle cx="443" cy="320" r="9"/><path d="m385 325 17 10m16 0 17-10"/></g>
      </g>}
      {slug === 'reclaim' && <g class="signature reclaim">

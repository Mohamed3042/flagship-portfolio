        <path class="flow" pathLength="1" d="M210 121q105 0 155 109M210 231h155M210 341q105 0 155-110"/><g class="dedupe"><circle cx="405" cy="230" r="75"/><text x="367" y="240">142→100</text></g>
        <path class="flow" pathLength="1" d="M480 230h104"/><g class="shortlist"><rect x="584" y="105" width="158" height="250" rx="16"/><circle cx="620" cy="152" r="13"/><circle cx="620" cy="214" r="13"/><circle cx="620" cy="276" r="13"/><path d="M650 152h58M650 214h58M650 276h58"/></g>

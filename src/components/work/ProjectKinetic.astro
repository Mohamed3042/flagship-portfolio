        <path class="flow" pathLength="1" d="M294 232h138"/><g class="outputs"><path d="M432 78h128v142H432zM576 244h156v152H576z"/><path d="M450 116h92M450 150h92M600 280h108M600 314h108M600 348h108"/><text x="464" y="196">XLSX</text><text x="622" y="380">A4</text></g>
      </g>}

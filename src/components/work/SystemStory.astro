---
import Biome from '../Biome.astro';
import Brief from './spine/Brief.astro';
import Build from './spine/Build.astro';
import Proof from './spine/Proof.astro';
import Honesty from './spine/Honesty.astro';
import SystemVisual from './SystemVisual.astro';
import { homePath, pick, useTranslations, type Lang } from '../../i18n/utils';
import type { ProjectMeta } from '../../data/projects';

interface Props {
  lang: Lang;
  project: ProjectMeta;
}

const { lang, project } = Astro.props;
const story = project.story!;
const t = useTranslations(lang);
const ar = lang === 'ar';
---

<article class="system-story system-story--astronomy" data-spine>
  <section class="system-hook" data-screen="hook">
    <Biome kind="nebula" tint={project.cardA} />
    <span class="system-hook__ghost" aria-hidden="true">{story.ghost}</span>
    <div class="system-hook__grid">
      <div class="system-hook__copy">
        <span class="system-hook__tag"><i></i>{pick(lang, project.tag)}</span>
        <h1 set:html={pick(lang, story.headline)}></h1>
        <p set:html={pick(lang, story.lead)}></p>
        <div class="system-hook__actions">
          <a href={homePath(lang) + '#work'}>{ar ? '→' : '←'} {t('work.all')}</a>
          {story.link && <a class="primary" href={story.link.href} target="_blank" rel="noopener">{pick(lang, story.link.label)} ↗</a>}
        </div>
      </div>
      <SystemVisual lang={lang} story={story} compact={true} />
    </div>
    <div class="system-hook__cue" aria-hidden="true"><span>{t('hero.scroll')}</span><i></i></div>
  </section>

  <Brief
    lang={lang}
    kicker={story.problemKicker}
    heading={story.problemHeading}
    body={story.problemBody}
    ghostWord={story.ghost}
  >
    <div class="contract-panel">
      <span class="contract-panel__label">{ar ? 'عقد النظام' : 'SYSTEM CONTRACT'}</span>
      <div><i>{ar ? 'المدخل' : 'INPUT'}</i><b>{pick(lang, project.blurb)}</b></div>
      <div><i>{ar ? 'التحكم' : 'CONTROL'}</i><b>{pick(lang, story.boundaryKicker)}</b></div>
      <div><i>{ar ? 'الدليل' : 'PROOF'}</i><b>{pick(lang, story.proof[0].label)}</b></div>
      <span class="contract-panel__pulse" aria-hidden="true"></span>
    </div>
  </Brief>

  <Build
    lang={lang}
    kicker={story.stepsKicker}
    heading={story.stepsHeading}
    intro={story.stepsIntro}
    items={story.steps}
    mult={3.1}
  />

  <Proof lang={lang} mult={2.8} center={`system-${story.visual}`}>
    <div class="system-proof">
      <div class="system-proof__copy">
        <span>{pick(lang, story.proofKicker)}</span>
        <h2>{pick(lang, story.proofHeading)}</h2>
        <p>{pick(lang, story.proofBody)}</p>
      </div>
      <SystemVisual lang={lang} story={story} />
    </div>
  </Proof>

  <Honesty lang={lang} slug={project.slug} kicker={story.boundaryKicker} note={story.boundary}>
    <div slot="tools" class="system-tools">
      {story.tools.map((tool) => <span>{tool}</span>)}
      {story.link && <a href={story.link.href} target="_blank" rel="noopener">{pick(lang, story.link.label)} ↗</a>}
    </div>
  </Honesty>
</article>

<style>
  .system-story{overflow:clip}
  .system-hook{position:relative;min-height:100svh;padding:clamp(108px,13vh,150px) clamp(22px,6vw,94px) clamp(72px,10vh,110px);display:flex;align-items:center;overflow:hidden;isolation:isolate}
  .system-hook__ghost{position:absolute;inset-inline-end:-.02em;top:8%;font:900 clamp(150px,30vw,520px)/.8 var(--font-display);letter-spacing:-.04em;color:transparent;-webkit-text-stroke:1px color-mix(in srgb,var(--accent) 20%,transparent);opacity:.55;z-index:-1;direction:ltr}
  .system-hook__grid{width:min(1420px,100%);margin-inline:auto;display:grid;grid-template-columns:minmax(0,.82fr) minmax(440px,1.18fr);gap:clamp(44px,7vw,110px);align-items:center}
  .system-hook__copy{position:relative;z-index:2}.system-hook__tag{display:flex;align-items:center;gap:10px;margin-bottom:clamp(20px,3vw,34px);font-family:var(--font-mono);font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--ink-3)}.system-hook__tag i{width:9px;height:9px;border-radius:50%;background:var(--accent);box-shadow:0 0 18px color-mix(in srgb,var(--accent) 72%,transparent)}
  .system-hook h1{margin:0;font-size:clamp(44px,7vw,104px);line-height:.96;letter-spacing:-.035em;text-wrap:balance;color:var(--ink)}
  :global([dir="rtl"]) .system-hook h1{letter-spacing:0;line-height:1.14}
  .system-hook p{max-width:65ch;margin:clamp(24px,3.4vw,38px) 0 0;font-size:clamp(16px,1.6vw,21px);line-height:1.65;color:var(--ink-2)}
  .system-hook__actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:32px}.system-hook__actions a{display:inline-flex;align-items:center;min-height:46px;padding:0 18px;border-radius:14px;border:1px solid var(--glass-brd);color:var(--ink-2);text-decoration:none;font-size:13px;transition:transform .25s var(--ease),color .25s,border-color .25s}.system-hook__actions a:hover{transform:translateY(-2px);color:var(--ink);border-color:color-mix(in srgb,var(--accent) 48%,var(--glass-brd))}.system-hook__actions .primary{background:var(--accent);border-color:var(--accent);color:#08090d;font-weight:700}
  .system-hook__cue{position:absolute;bottom:26px;left:50%;translate:-50%;display:flex;align-items:center;gap:10px;color:var(--ink-3);font:10px var(--font-mono);letter-spacing:.13em;text-transform:uppercase}.system-hook__cue i{display:block;width:46px;height:1px;background:linear-gradient(90deg,var(--accent),transparent)}
  .contract-panel{position:relative;width:min(100%,500px);margin-inline:auto;padding:clamp(24px,4vw,48px);border-radius:28px;background:color-mix(in srgb,var(--surface) 91%,var(--accent) 9%);box-shadow:0 38px 90px rgba(0,0,0,.28);overflow:hidden}.contract-panel::before{content:"";position:absolute;inset:0 0 auto;height:2px;background:linear-gradient(90deg,var(--accent),transparent)}.contract-panel__label{display:block;margin-bottom:26px;color:var(--accent);font:10px var(--font-mono);letter-spacing:.14em}.contract-panel div{display:grid;grid-template-columns:74px 1fr;gap:18px;padding:17px 0;border-top:1px solid color-mix(in srgb,var(--ink-3) 18%,transparent)}.contract-panel i{font:9px var(--font-mono);font-style:normal;letter-spacing:.1em;color:var(--ink-3)}.contract-panel b{font-size:13px;line-height:1.5;font-weight:500;color:var(--ink-2)}.contract-panel__pulse{position:absolute;right:-30px;bottom:-30px;width:120px;aspect-ratio:1;border-radius:50%;background:radial-gradient(circle,var(--accent),transparent 68%);opacity:.22;animation:contract-pulse 4s ease-in-out infinite}
  .system-proof{display:grid;grid-template-columns:minmax(260px,.6fr) minmax(520px,1.4fr);gap:clamp(34px,5vw,76px);align-items:center}.system-proof__copy>span{color:var(--accent);font:10px var(--font-mono);letter-spacing:.14em;text-transform:uppercase}.system-proof__copy h2{margin:18px 0 20px;font-size:clamp(34px,5vw,70px);line-height:1.03;letter-spacing:-.03em;text-wrap:balance}.system-proof__copy p{max-width:58ch;color:var(--ink-2);font-size:clamp(15px,1.45vw,19px);line-height:1.65}
  .system-tools{display:flex;flex-wrap:wrap;gap:9px;margin-top:28px}.system-tools span,.system-tools a{padding:8px 11px;border-radius:10px;border:1px solid var(--glass-brd);font:10px var(--font-mono);color:var(--ink-3);text-decoration:none}.system-tools a{color:var(--accent);border-color:color-mix(in srgb,var(--accent) 38%,var(--glass-brd))}
  @keyframes contract-pulse{0%,100%{transform:scale(.88);opacity:.14}50%{transform:scale(1.12);opacity:.3}}
  @media(max-width:980px){.system-hook__grid,.system-proof{grid-template-columns:1fr}.system-hook__grid{gap:38px}.system-hook{align-items:flex-start}.system-proof__copy{max-width:720px}.system-hook__ghost{top:6%;opacity:.34}}
  @media(max-width:640px){.system-hook{padding-inline:18px}.system-hook h1{font-size:clamp(39px,13vw,66px)}.system-hook__actions{flex-direction:column}.system-hook__actions a{justify-content:center}.contract-panel{border-radius:18px}.system-hook__cue{display:none}}
  @media(prefers-reduced-motion:reduce){.contract-panel__pulse{animation:none}}
</style>

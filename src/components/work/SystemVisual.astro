---
import { pick, type Lang } from '../../i18n/utils';
import type { ProjectStory } from '../../data/projects';

interface Props {
  lang: Lang;
  story: ProjectStory;
  compact?: boolean;
}

const { lang, story, compact = false } = Astro.props;
const v = story.visual;
const metric = (index: number) => story.proof[index];
---

<figure class:list={['system-visual', { compact }]} data-visual={v} aria-label={pick(lang, story.proofHeading)}>
  <div class="visual-grid" aria-hidden="true"></div>

  {v === 'approval-gate' && (
    <div class="approval scene" aria-hidden="true">
      <span class="packet p1">PROFILE</span><span class="packet p2">MATCH</span><span class="packet p3">DRAFT</span>
      <span class="flow-line"></span><span class="gate"><i></i>HUMAN</span><span class="outcome">SEND</span>
    </div>
  )}
  {v === 'encrypted-vault' && (
    <div class="vault scene" aria-hidden="true">
      <span class="vault-ring r1"></span><span class="vault-ring r2"></span><span class="vault-ring r3"></span>
      <span class="vault-key">LOCAL<br/>KEY</span><span class="vault-cite c1">FILE:12</span><span class="vault-cite c2">VAULT:07</span>
    </div>
  )}
  {v === 'document-stack' && (
    <div class="documents scene" aria-hidden="true">
      <span class="page back"><i>AR</i></span><span class="page mid"><i>EN</i></span><span class="page front"><b>PDF/X-4</b><em></em><em></em><em></em></span>
      <span class="crop tl"></span><span class="crop br"></span>
    </div>
  )}
  {v === 'packaging-dieline' && (
    <div class="packaging scene" aria-hidden="true">
      <span class="panel a"></span><span class="panel b"></span><span class="panel c"></span><span class="panel d"></span>
      <span class="fold f1"></span><span class="fold f2"></span><span class="fold f3"></span>
      <span class="cube"><i></i><b></b><em></em></span>
    </div>
  )}
  {v === 'cake-production' && (
    <div class="cake scene" aria-hidden="true">
      <span class="cake-layer l1"></span><span class="cake-layer l2"></span><span class="cake-layer l3"></span>
      <span class="plaque">١:١</span>
      {Array.from({ length: 8 }, (_, i) => <i class="cake-slot" style={`--i:${i}`}></i>)}
    </div>
  )}
  {v === 'audit-locker' && (
    <div class="locker scene" aria-hidden="true">
      <span class="shield"><i>LAN</i></span>
      <span class="ledger row1">A81F · OPEN · 14:02</span><span class="ledger row2">29BC · PDF · 14:03</span><span class="ledger row3">C204 · VERIFY · 14:03</span>
      <span class="chain c1"></span><span class="chain c2"></span><span class="watermark">VIEWER · TIME</span>
    </div>
  )}
  {v === 'mft-radar' && (
    <div class="mft scene" aria-hidden="true">
      <span class="disk d1"></span><span class="disk d2"></span><span class="disk d3"></span><span class="sweep"></span>
      {Array.from({ length: 9 }, (_, i) => <i class="sector" style={`--i:${i}`}></i>)}
      <span class="readout">$MFT<br/>2.62M</span>
    </div>
  )}
  {v === 'ration-matrix' && (
    <div class="ration scene" aria-hidden="true">
      <span class="matrix"></span><span class="constraint c1">DM ≤</span><span class="constraint c2">ME ≥</span><span class="constraint c3">CP ≥</span>
      <span class="ration-bar b1"></span><span class="ration-bar b2"></span><span class="ration-bar b3"></span>
      <span class="solver">LP</span>
    </div>
  )}
  {v === 'page-fitter' && (
    <div class="fitter scene" aria-hidden="true">
      <span class="fit-page p1"><i></i><i></i><i></i></span><span class="fit-page p2"><i></i><i></i><i></i></span>
      <span class="measure m1">1 PAGE</span><span class="measure m2">2 PAGES</span><span class="scale">SCALE ↔</span>
    </div>
  )}
  {v === 'sim-tick' && (
    <div class="sim scene" aria-hidden="true">
      <span class="arena-grid"></span><span class="crosshair"><i></i></span>
      <span class="intent">INTENT →</span><span class="state">→ STATE</span>
      {Array.from({ length: 6 }, (_, i) => <i class="tick" style={`--i:${i}`}></i>)}
      <span class="hz">60<br/><b>HZ</b></span>
    </div>
  )}
  {v === 'texture-transfer' && (
    <div class="texture scene" aria-hidden="true">
      <span class="face source"></span><span class="transfer-arrow">→</span><span class="face target"></span>
      <span class="uv-lines"></span><span class="delta">dE 8.49 → 1.41</span>
    </div>
  )}
  {v === 'artillery-graph' && (
    <div class="artillery scene" aria-hidden="true">
      <span class="cannon"></span><span class="arc"></span><span class="projectile"></span><span class="impact"></span>
      <span class="data-node n1">JSON</span><span class="data-node n2">SIM</span><span class="data-node n3">NET</span>
    </div>
  )}
  {v === 'module-blueprint' && (
    <div class="modules scene" aria-hidden="true">
      <span class="module m1">GAS</span><span class="module m2">CORE</span><span class="module m3">NET</span><span class="module m4">UI</span><span class="module m5">QA</span>
      <span class="module-line l1"></span><span class="module-line l2"></span><span class="module-line l3"></span>
      <span class="missing-content">CONTENT / EXCLUDED</span>
    </div>
  )}
  {v === 'restoration-layers' && (
    <div class="restore scene" aria-hidden="true">
      <span class="layer old">UNITY 4</span><span class="layer bridge">PATCHES</span><span class="layer new">UNITY 6</span>
      <span class="restore-line"></span><span class="rights">ORIGINAL IP ≠ PATCH WORK</span>
    </div>
  )}
  {v === 'world-audit' && (
    <div class="world scene" aria-hidden="true">
      <span class="island i1"></span><span class="island i2"></span><span class="island i3"></span><span class="route r1"></span><span class="route r2"></span>
      <span class="truth v">V</span><span class="truth i">I</span><span class="truth l">L</span>
    </div>
  )}
  {v === 'evidence-ledger' && (
    <div class="evidence scene" aria-hidden="true">
      <span class="application a1">MATCHED</span><span class="application a2">STAGED</span><span class="application a3">SENT?</span>
      <span class="receipt">RECEIPT</span><span class="proof-gate"><i></i></span><span class="status">SENT ✓</span>
    </div>
  )}
  {v === 'theme-engine' && (
    <div class="themes scene" aria-hidden="true">
      {Array.from({ length: 7 }, (_, i) => <span class="theme-card" style={`--i:${i}`}><i>{i + 1}</i></span>)}
      <span class="truth-core">ONE<br/>MODEL</span>
    </div>
  )}

  {v === 'citation-chain' && (
    <div class="cite scene" aria-hidden="true">
      <span class="sent s1"><i></i></span><span class="sent s2"><i></i></span><span class="sent s3"><i></i></span>
      <span class="cite-line l1"></span><span class="cite-line l2"></span>
      <span class="cite-file f1">README.md<b>FILE · LINES</b></span><span class="cite-file f2">verify<b>@ COMMIT</b></span>
      <span class="cite-drop">NO ANCHOR · DROPPED</span>
    </div>
  )}
  {v === 'signed-gate' && (
    <div class="gate2 scene" aria-hidden="true">
      <span class="g-step st1">DISCOVER</span><span class="g-step st2">COMPILE</span><span class="g-step st3 risk">HIGH RISK</span>
      <span class="g-sign"><i></i>SIGNED</span>
      {Array.from({ length: 5 }, (_, i) => <span class="g-block" style={`--i:${i}`}><i>#</i></span>)}
    </div>
  )}
  {v === 'webhook-relay' && (
    <div class="relay scene" aria-hidden="true">
      <span class="r-in">HMAC ✓</span><span class="r-pipe"></span>
      {Array.from({ length: 4 }, (_, i) => <span class="r-event" style={`--i:${i}`}></span>)}
      <span class="r-outbox">OUTBOX</span><span class="r-retry">RETRY ↺</span><span class="r-dlq">DEAD-LETTER</span>
    </div>
  )}
  {v === 'forecast-duel' && (
    <div class="duel scene" aria-hidden="true">
      <svg class="duel-plot" viewBox="0 0 300 150" preserveAspectRatio="none">
        <path class="actual" d="M0 110 L25 96 L50 104 L75 70 L100 82 L125 58 L150 74 L175 50 L200 66 L225 44 L250 60 L275 38 L300 52" />
        <path class="model-a" d="M0 108 L25 100 L50 98 L75 76 L100 80 L125 62 L150 70 L175 54 L200 62 L225 48 L250 58 L275 42 L300 50" />
        <path class="model-b" d="M0 96 L50 94 L100 86 L150 76 L200 66 L250 58 L300 52" />
      </svg>
      <span class="duel-tag a">MODEL</span><span class="duel-tag b">BASELINE</span>
      <span class="duel-reject">CLASSIFIER · REJECTED</span>
    </div>
  )}
  {v === 'spaceframe-lattice' && (
    <div class="lattice scene" aria-hidden="true">
      <svg viewBox="0 0 300 180" preserveAspectRatio="xMidYMid meet">
        <g class="lat">
          <path d="M20 160 L60 70 L100 160 L140 60 L180 160 L220 70 L260 160 Z" />
          <path d="M60 70 L140 60 L220 70 M40 115 L120 110 L200 112 L240 115 M60 70 L100 25 L140 60 L180 25 L220 70 M100 25 L180 25" />
        </g>
        <g class="hot"><path d="M140 60 L180 160" /><path d="M100 25 L140 60" /></g>
      </svg>
      <span class="lat-note">UTILIZATION · ENGINEER APPROVAL</span>
    </div>
  )}
  {v === 'macro-timeline' && (
    <div class="macro scene" aria-hidden="true">
      <span class="m-rec"><i></i>REC</span>
      <span class="m-track"></span>
      {['CLICK', 'TYPE', 'WAIT', 'IF', 'TYPE'].map((label, i) => <span class={`m-step${label === 'IF' ? ' branch' : ''}`} style={`--i:${i}`}>{label}</span>)}
      <span class="m-play">▶ REPLAY</span>
    </div>
  )}
  {v === 'quote-sheet' && (
    <div class="quote scene" aria-hidden="true">
      <span class="q-page"><b>A4</b>{Array.from({ length: 5 }, (_, i) => <i style={`--i:${i}`}></i>)}<em>PRICE · HUMAN</em></span>
      <span class="q-field f1">EN</span><span class="q-field f2">ع</span><span class="q-link"></span>
    </div>
  )}
  {v === 'ocr-grid' && (
    <div class="ocr scene" aria-hidden="true">
      <span class="o-scan">{Array.from({ length: 12 }, (_, i) => <i style={`--i:${i}`}></i>)}<b class="o-beam"></b></span>
      <span class="o-arrow">→</span>
      <span class="o-sheet">XLSX<em></em><em></em><em></em></span>
      <span class="o-check">COMPARE TO SOURCE</span>
    </div>
  )}
  {v === 'prompt-storyboard' && (
    <div class="board scene" aria-hidden="true">
      {Array.from({ length: 4 }, (_, i) => <span class="b-frame" style={`--i:${i}`}><i>{String(i + 1).padStart(2, '0')}</i></span>)}
      <span class="b-brief">BRIEF → CHAIN → COST</span>
    </div>
  )}
  {v === 'voice-wave' && (
    <div class="voice scene" aria-hidden="true">
      {Array.from({ length: 28 }, (_, i) => <i class="v-bar" style={`--i:${i};--h:${10 + ((i * 7) % 11) * 4}%`}></i>)}
      <span class="v-chip local">LOCAL MODEL</span><span class="v-chip offline">ON DEVICE</span>
    </div>
  )}
  {v === 'multicam-sync' && (
    <div class="sync scene" aria-hidden="true">
      {['CAM A', 'CAM B', 'CAM C'].map((label, i) => <span class="s-track" style={`--i:${i}`}><b>{label}</b><i></i></span>)}
      <span class="s-line"></span><span class="s-note">AUDIO-ALIGNED</span>
    </div>
  )}

  {v === 'paper-intake' && (
    <div class="intake scene" aria-hidden="true">
      <span class="pi-form"><b class="pi-qr"></b>{Array.from({ length: 6 }, (_, i) => <i style={`--i:${i}`}></i>)}</span>
      <span class="pi-chat">واتساب</span>
      {['DRAFT', 'DRAFT', 'REVIEW'].map((label, i) => <span class={`pi-card${label === 'REVIEW' ? ' gate' : ''}`} style={`--i:${i}`}>{label}</span>)}
      <span class="pi-audit">AUDIT ✓</span>
    </div>
  )}

  <figcaption class="visual-caption">
    {[0, 1, 2].map((i) => metric(i) && (
      <span><b>{metric(i).value}</b><i>{pick(lang, metric(i).label)}</i></span>
    ))}
  </figcaption>
</figure>

<style>
  .system-visual{--vc:var(--accent,#2997ff);position:relative;margin:0;min-height:clamp(360px,52vw,620px);border-radius:clamp(24px,4vw,46px);overflow:hidden;isolation:isolate;background:linear-gradient(145deg,color-mix(in srgb,var(--surface) 92%,var(--vc) 8%),color-mix(in srgb,var(--surface) 97%,transparent));border:1px solid color-mix(in srgb,var(--vc) 28%,var(--glass-brd));box-shadow:0 50px 130px rgba(0,0,0,.34),inset 0 1px rgba(255,255,255,.08)}
  .system-visual::before{content:"";position:absolute;inset:-20%;z-index:-2;background:radial-gradient(circle at 48% 38%,color-mix(in srgb,var(--vc) 32%,transparent),transparent 48%);filter:blur(28px);animation:visual-breathe 7s ease-in-out infinite}
  .visual-grid{position:absolute;inset:0;z-index:-1;opacity:.18;background-image:linear-gradient(color-mix(in srgb,var(--vc) 22%,transparent) 1px,transparent 1px),linear-gradient(90deg,color-mix(in srgb,var(--vc) 22%,transparent) 1px,transparent 1px);background-size:38px 38px;mask:radial-gradient(circle at 50% 45%,#000,transparent 76%)}
  .scene{position:absolute;inset:8% 7% 27%;font-family:var(--font-mono);direction:ltr}
  .visual-caption{position:absolute;inset:auto 5% 5%;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;direction:ltr}
  .visual-caption span{display:flex;flex-direction:column;gap:4px;padding:13px 14px;border-radius:14px;background:color-mix(in srgb,var(--surface) 84%,transparent);border:1px solid color-mix(in srgb,var(--vc) 24%,var(--glass-brd));backdrop-filter:blur(14px)}
  .visual-caption b{font-size:clamp(15px,2vw,23px);color:var(--ink);font-variant-numeric:tabular-nums}.visual-caption i{font-style:normal;font-size:10px;line-height:1.3;color:var(--ink-3);text-transform:uppercase;letter-spacing:.06em}
  .compact{min-height:290px}.compact .scene{inset:8% 7% 31%}.compact .visual-caption{inset:auto 4% 4%}.compact .visual-caption span{padding:9px}.compact .visual-caption i{font-size:8px}

  /* approval gate */
  .approval .packet{position:absolute;left:4%;width:25%;padding:12px 8px;border:1px solid color-mix(in srgb,var(--vc) 55%,transparent);border-radius:10px;background:color-mix(in srgb,var(--vc) 12%,transparent);font-size:10px;text-align:center;animation:packet-in 4.2s ease-in-out infinite}.approval .p1{top:18%}.approval .p2{top:44%;animation-delay:-1.4s}.approval .p3{top:70%;animation-delay:-2.8s}.approval .flow-line{position:absolute;left:29%;right:12%;top:50%;height:1px;background:linear-gradient(90deg,var(--vc),transparent)}.approval .gate{position:absolute;left:51%;top:50%;translate:-50% -50%;width:106px;height:106px;border-radius:50%;display:grid;place-items:center;border:2px solid var(--vc);background:color-mix(in srgb,var(--surface) 88%,var(--vc) 12%);box-shadow:0 0 40px color-mix(in srgb,var(--vc) 36%,transparent);font-size:11px}.approval .gate i{position:absolute;inset:-10px;border:1px dashed color-mix(in srgb,var(--vc) 54%,transparent);border-radius:50%;animation:spin 10s linear infinite}.approval .outcome{position:absolute;right:1%;top:50%;translate:0 -50%;opacity:.32;font-size:13px;letter-spacing:.1em}
  /* vault */
  .vault .vault-ring{position:absolute;left:50%;top:48%;translate:-50% -50%;border-radius:50%;border:1px solid color-mix(in srgb,var(--vc) 62%,transparent)}.vault .r1{width:31%;aspect-ratio:1}.vault .r2{width:52%;aspect-ratio:1;border-style:dashed;animation:spin 18s linear infinite}.vault .r3{width:76%;aspect-ratio:1;opacity:.38;animation:spin 30s linear infinite reverse}.vault-key{position:absolute;left:50%;top:48%;translate:-50% -50%;width:76px;aspect-ratio:1;display:grid;place-items:center;text-align:center;border-radius:18px;background:linear-gradient(145deg,color-mix(in srgb,var(--vc) 32%,var(--surface)),var(--surface));box-shadow:0 0 45px color-mix(in srgb,var(--vc) 45%,transparent);font-size:10px}.vault-cite{position:absolute;padding:7px 10px;border-radius:999px;border:1px solid color-mix(in srgb,var(--vc) 32%,transparent);font-size:9px;color:var(--ink-2)}.vault-cite.c1{left:4%;top:20%}.vault-cite.c2{right:4%;bottom:18%}
  /* documents */
  .documents .page{position:absolute;left:50%;top:48%;width:34%;height:72%;border-radius:6px;background:color-mix(in srgb,var(--ink) 90%,var(--vc) 10%);box-shadow:0 24px 60px rgba(0,0,0,.35);transform-origin:50% 100%;color:#080910;padding:9%;font-size:11px}.documents .back{translate:-72% -50%;rotate:-12deg;opacity:.5}.documents .mid{translate:-30% -50%;rotate:9deg;opacity:.7}.documents .front{translate:-50% -50%;z-index:2}.documents .front b{display:block;font-size:12px;margin-bottom:22%}.documents .front em{display:block;height:3px;margin:10% 0;background:#151521;opacity:.35}.documents .crop{position:absolute;width:26px;height:26px;border-color:var(--vc);opacity:.8}.documents .crop.tl{left:23%;top:5%;border-left:1px solid;border-top:1px solid}.documents .crop.br{right:23%;bottom:4%;border-right:1px solid;border-bottom:1px solid}
  /* packaging */
  .packaging .panel{position:absolute;top:25%;height:50%;border:1px solid color-mix(in srgb,var(--vc) 64%,transparent);background:color-mix(in srgb,var(--vc) 8%,transparent)}.packaging .a{left:5%;width:18%}.packaging .b{left:23%;width:27%}.packaging .c{left:50%;width:18%}.packaging .d{left:68%;width:27%}.packaging .fold{position:absolute;top:18%;height:64%;border-left:1px dashed color-mix(in srgb,var(--vc) 66%,transparent)}.packaging .f1{left:23%}.packaging .f2{left:50%}.packaging .f3{left:68%}.packaging .cube{position:absolute;right:10%;top:50%;width:86px;height:86px;translate:0 -50%;transform:rotateX(58deg) rotateZ(45deg);transform-style:preserve-3d;opacity:.85}.packaging .cube,.packaging .cube i,.packaging .cube b{border:1px solid var(--vc);background:color-mix(in srgb,var(--vc) 16%,transparent)}.packaging .cube i,.packaging .cube b{position:absolute;inset:0;content:""}.packaging .cube i{transform:rotateY(90deg);transform-origin:left}.packaging .cube b{transform:rotateX(90deg);transform-origin:top}
  /* cake */
  .cake-layer{position:absolute;left:50%;translate:-50% 0;border-radius:50%;background:linear-gradient(90deg,color-mix(in srgb,var(--vc) 18%,var(--surface)),color-mix(in srgb,var(--vc) 72%,white),color-mix(in srgb,var(--vc) 18%,var(--surface)));border:1px solid color-mix(in srgb,var(--vc) 55%,transparent)}.cake .l1{width:44%;height:24%;bottom:10%}.cake .l2{width:36%;height:25%;bottom:31%}.cake .l3{width:28%;height:25%;bottom:52%}.cake .plaque{position:absolute;left:50%;top:31%;translate:-50% -50%;padding:8px 18px;border-radius:8px;background:var(--ink);color:var(--surface);font-weight:800;z-index:2}.cake-slot{position:absolute;left:50%;top:46%;width:7px;height:7px;border-radius:50%;background:var(--vc);transform:rotate(calc(var(--i)*45deg)) translateY(-142px);box-shadow:0 0 12px var(--vc)}
  /* locker */
  .locker .shield{position:absolute;left:15%;top:50%;translate:0 -50%;width:112px;height:132px;clip-path:polygon(50% 0,92% 16%,86% 70%,50% 100%,14% 70%,8% 16%);background:linear-gradient(145deg,var(--vc),color-mix(in srgb,var(--vc) 18%,var(--surface)));display:grid;place-items:center;color:#07120c;font-weight:900}.locker .ledger{position:absolute;left:43%;right:4%;height:42px;padding:13px;border:1px solid color-mix(in srgb,var(--vc) 36%,transparent);background:color-mix(in srgb,var(--vc) 7%,transparent);font-size:9px;color:var(--ink-2)}.locker .row1{top:19%}.locker .row2{top:43%}.locker .row3{top:67%}.locker .chain{position:absolute;left:39%;width:12px;height:12px;border-radius:50%;border:2px solid var(--vc)}.locker .c1{top:35%}.locker .c2{top:59%}.locker .watermark{position:absolute;right:8%;top:50%;rotate:-19deg;opacity:.12;font-size:22px}
  /* MFT */
  .mft .disk{position:absolute;left:50%;top:47%;translate:-50% -50%;border-radius:50%;border:1px solid color-mix(in srgb,var(--vc) 58%,transparent)}.mft .d1{width:68%;aspect-ratio:1}.mft .d2{width:46%;aspect-ratio:1}.mft .d3{width:23%;aspect-ratio:1}.mft .sweep{position:absolute;left:50%;top:47%;width:34%;height:2px;transform-origin:left;background:linear-gradient(90deg,var(--vc),transparent);animation:radar 4s linear infinite}.mft .sector{position:absolute;left:50%;top:47%;width:4px;height:4px;border-radius:50%;background:var(--vc);transform:rotate(calc(var(--i)*40deg)) translateY(-112px);box-shadow:0 0 10px var(--vc)}.mft .readout{position:absolute;left:50%;top:47%;translate:-50% -50%;text-align:center;font-size:11px;line-height:1.5}
  /* ration */
  .ration .matrix{position:absolute;left:5%;top:10%;width:48%;height:74%;background:repeating-linear-gradient(0deg,transparent 0 29px,color-mix(in srgb,var(--vc) 24%,transparent) 29px 30px),repeating-linear-gradient(90deg,transparent 0 39px,color-mix(in srgb,var(--vc) 24%,transparent) 39px 40px);border:1px solid color-mix(in srgb,var(--vc) 36%,transparent)}.ration .constraint{position:absolute;left:10%;font-size:9px;color:var(--ink-2)}.ration .c1{top:24%}.ration .c2{top:46%}.ration .c3{top:68%}.ration .solver{position:absolute;left:48%;top:47%;translate:-50% -50%;width:66px;aspect-ratio:1;border-radius:50%;display:grid;place-items:center;background:var(--vc);color:#07100d;font-weight:900;box-shadow:0 0 30px color-mix(in srgb,var(--vc) 55%,transparent)}.ration-bar{position:absolute;left:66%;height:13%;border-radius:5px;background:linear-gradient(90deg,var(--vc),color-mix(in srgb,var(--vc) 20%,transparent))}.ration .b1{top:19%;width:27%}.ration .b2{top:43%;width:19%}.ration .b3{top:67%;width:34%}
  /* fitter */

---
/** Beat 3 · Build — PINNED + SCRUBBED. The gate run: one short line per step,
 *  centred, drawn as particle text by the flight; only the gate the camera is
 *  passing is assembled (lib/storyscroll.ts steps [data-build-item], the text
 *  field reads its data-state). data-mult sets the scroll length:
 *  pin distance = (mult-1) * 100vh. */
import { pick, type Lang } from '../../../i18n/utils';

interface BuildItem {
  n: string;
  title: { en: string; ar: string };
  body: { en: string; ar: string };
}
interface Props {
  lang: Lang;
  kicker: { en: string; ar: string };
  heading: { en: string; ar: string };
  intro?: { en: string; ar: string };
  /** pin length multiplier (default 2.6) */
  mult?: number;
  items: BuildItem[];
}
const { lang, heading, mult = 2.6, items } = Astro.props;
---

<section class="beat beat--build" data-build data-mult={mult.toString()} data-flight-stop="build">
  <div class="beat__sticky gates__sticky" data-build-sticky>
    <h2 class="sr-only">{pick(lang, heading)}</h2>
    <ol class="gates">
      {
        items.map((it, i) => (
          <li class="gate" data-build-item data-state={i === 0 ? 'active' : 'future'}>
            <span class="gate__line" data-ptext>{pick(lang, it.title)}</span>
          </li>
        ))
      }
    </ol>
    <div class="gates__bar"><i data-build-bar></i></div>
  </div>
</section>

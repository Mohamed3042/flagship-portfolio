---
/** Beat 5 · Honesty + next — the sourcing/credit note, then a parallax
 *  colour-wipe hand-off that teases the NEXT story's domain colour. */
import { pick, workPath, useTranslations, type Lang } from '../../../i18n/utils';
import { projects, neighbours } from '../../../data/projects';

interface Props {
  lang: Lang;
  slug: string;
  kicker: { en: string; ar: string };
  note: { en: string; ar: string }; // HTML
}
const { lang, slug, note } = Astro.props;
const t = useTranslations(lang);
const ar = lang === 'ar';
// the one line the boundary opens with; the whole note stays under the fold
const plain = pick(lang, note).replace(/<[^>]+>/g, '').replace(/\s+/g, ' ').trim();
const first = plain.match(/^(.{24,}?[.!?؟])(\s|$)/);
const short = first ? first[1] : plain.length > 140 ? plain.slice(0, 137).trimEnd() + '…' : plain;

const { next } = neighbours(slug);
---

<section class="beat beat--honesty" data-screen="honesty" data-flight-stop="honesty">
  <div class="sourcing reveal">
    <h2 class="sourcing__line" data-ptext>{short}</h2>
    <details class="tx-more">
      <summary>{ar ? 'الإرسال الكامل' : 'Full transmission'}</summary>
      <p class="sourcing__quote" set:html={pick(lang, note)}></p>
      <slot name="tools" />
    </details>
  </div>

  <a class="handoff reveal" href={workPath(lang, next.slug)} data-next={next.accent} data-flight-stop="next">
    <span class="handoff__wash" aria-hidden="true" data-px="0.05"></span>
    <span class="handoff__row">
      <span class="handoff__copy">
        <span class="handoff__label" data-ptext data-px="0.04">{pick(lang, next.title)}</span>
      </span>
      <span class="handoff__num" data-px="0.09">
        {pick(lang, next.stat)}
        <span class="handoff__arrow" aria-hidden="true">→</span>
      </span>
    </span>
  </a>
</section>

---
import { projects, type ProjectMeta } from '../../../data/projects';
import { storyForProject } from '../../../data/project-kinetics';
import { storybookRealmFor } from '../../../data/storybook-realms';
import { homePath, pick, type Lang } from '../../../i18n/utils';
import ProjectKinetic from '../ProjectKinetic.astro';

interface Props { lang: Lang; project: ProjectMeta }
const { lang, project } = Astro.props;
const ar = lang === 'ar';
const story = storyForProject(project, lang);
const no = String(projects.findIndex((item) => item.slug === project.slug) + 1).padStart(2, '0');
const back = homePath(lang) + '#disney-chapters';
const arrow = ar ? '←' : '→';
const realm = storybookRealmFor(project);
const motes = Array.from({ length: 16 });
---

<article
  class:list={['sworld', 'sworld--disney', 'dpb-world', `dpb-world--${realm}`]}
  data-story-world="disney"
  data-disney-project-book
  data-project-realm={realm}
  aria-hidden="true"
>
  <section class="sworld-stage dpb-cover-stage" data-story-stage>
    <div class="sworld-stick">
      <div class="dpb-night" aria-hidden="true">
        <div class="dpb-moon"></div>
        <div class="dpb-motes">{motes.map((_, i) => <i style={`--i:${i}`}></i>)}</div>
        <div class="dpb-horizon"><i></i><i></i><i></i></div>
      </div>
      <div class="dpb-cover-object" aria-hidden="true">
        <div class="dpb-page-block"></div>
        <div class="dpb-cover-face">
          <span>{ar ? 'الفصل' : 'Chapter'} {no}</span>
          <i></i>
          <ProjectKinetic project={project} lang={lang} world="disney" phase="input" compact />
          <b>{story.ghost}</b>
          <small>{pick(lang, project.tag)}</small>
        </div>
      </div>
      <div class="dpb-cover-copy">
        <span>{ar ? 'من مخطوطة الأنظمة' : 'From the systems manuscript'}</span>
        <div class="story-heading" role="heading" aria-level="1">{pick(lang, project.title)}</div>
        <p>{pick(lang, story.lead)}</p>
        <div><a href="#chapter-one">{ar ? 'افتح الفصل' : 'Open this chapter'} {arrow}</a><a href={back}>{ar ? 'كل الفصول' : 'All chapters'}</a></div>
      </div>
      <div class="dpb-stage-number" aria-hidden="true">{no}</div>
    </div>
  </section>

  <section class="sworld-stage dpb-opening-stage" id="chapter-one" data-story-stage>
    <div class="sworld-stick">
      <div class="dpb-opening-night" aria-hidden="true"></div>
      <div class="dpb-opening-book">
        <div class="dpb-opening-page dpb-opening-page--copy">
          <span>{pick(lang, story.problemKicker)}</span>
          <h2>{pick(lang, story.problemHeading)}</h2>
          <p>{pick(lang, story.problemBody)}</p>
        </div>
        <b class="dpb-opening-gutter"></b>
        <div class="dpb-opening-page dpb-opening-page--scene">
          <div class="dpb-pop-architecture" aria-hidden="true"><i></i><b></b><i></i></div>
          <ProjectKinetic project={project} lang={lang} world="disney" phase="run" />
          <div class="dpb-pop-foreground" aria-hidden="true"><i></i><i></i><i></i></div>
        </div>
        <div class="dpb-opening-turn" aria-hidden="true"></div>
      </div>
      <div class="dpb-enter-label">{ar ? 'مرّر لتدخل الآلية' : 'Scroll into the mechanism'}</div>
    </div>
  </section>

  <div class="dpb-story-pages">
    {story.steps.map((step, index) => (
      <section class:list={['sworld-stage', 'dpb-step-stage', index % 2 && 'dpb-step-stage--reverse']} data-story-stage data-book-step={index + 1}>
        <div class="sworld-stick">
          <div class="dpb-paper-light" aria-hidden="true"></div>
          <div class="dpb-step-spread">
            <div class="dpb-step-copy">
              <span>{ar ? 'المشهد' : 'Scene'} {step.n}</span>
              <h2>{pick(lang, step.title)}</h2>
              <p>{pick(lang, step.body)}</p>
              <small>{index === 0 ? pick(lang, story.problemKicker) : index === story.steps.length - 1 ? pick(lang, story.proofHeading) : pick(lang, story.stepsHeading)}</small>
            </div>
            <b class="dpb-step-gutter"></b>
            <div class="dpb-step-illustration">
              <div class="dpb-scene-back" aria-hidden="true"><i></i><i></i><b></b></div>
              <ProjectKinetic project={project} lang={lang} world="disney" phase={index === story.steps.length - 1 ? 'proof' : 'run'} />
              <div class="dpb-scene-front" aria-hidden="true"><i></i><i></i><i></i></div>
              <span>{project.slug.replaceAll('-', ' ')}</span>
            </div>
            <div class="dpb-step-turn" aria-hidden="true"></div>
          </div>
          <div class="dpb-progress" aria-hidden="true"><span>{String(index + 1).padStart(2, '0')}</span><i><b style={`--step:${(index + 1) / story.steps.length}`}></b></i><span>{String(story.steps.length).padStart(2, '0')}</span></div>
        </div>
      </section>
    ))}
  </div>

  <section class="sworld-stage dpb-proof-stage" data-story-stage>
    <div class="sworld-stick">
      <div class="dpb-proof-sky" aria-hidden="true">{motes.slice(0, 10).map((_, i) => <i style={`--i:${i}`}></i>)}</div>
      <div class="dpb-proof-book">
        <div class="dpb-proof-copy">
          <span>{ar ? 'الدليل' : 'The evidence'}</span>
          <h2>{pick(lang, story.proofHeading)}</h2>
          <p>{pick(lang, story.proofBody)}</p>
        </div>
        <b></b>
        <dl>{story.proof.map((metric) => <div><dt>{metric.value}</dt><dd>{pick(lang, metric.label)}</dd></div>)}</dl>
      </div>
      <div class="dpb-proof-seal" aria-hidden="true"><i></i><b>MM</b><span>VERIFIED<br/>CHAPTER</span></div>
    </div>
  </section>

  <footer class="dpb-back-cover">
    <div class="dpb-back-emblem" aria-hidden="true"><i></i><b>{story.ghost}</b><i></i></div>
    <span>{pick(lang, story.boundaryKicker)}</span>
    <h2>{ar ? 'كل حكاية صادقة تعرف حدودها.' : 'An honest story knows its boundary.'}</h2>
    <p>{pick(lang, story.boundary)}</p>
    <div class="dpb-tools">{story.tools.map((tool) => <i>{tool}</i>)}</div>
    <a href={back}>{ar ? 'أغلق الكتاب وعد إلى الفصول' : 'Close the book and return to the chapters'} {arrow}</a>
  </footer>
</article>

<script>
  let disneyProjectBookCleanup: (() => void) | null = null;
  function initDisneyProjectBook() {
    disneyProjectBookCleanup?.();
    const root = document.querySelector<HTMLElement>('[data-disney-project-book]');
    if (!root) return;
    const paper = root.querySelector<HTMLElement>('.dpb-story-pages');
    const proof = root.querySelector<HTMLElement>('.dpb-proof-stage');
    let raf = 0;
    const update = () => {
      raf = 0;
      if (root.getAttribute('aria-hidden') === 'true') {
        document.documentElement.removeAttribute('data-disney-book-open');
        return;
      }
      const vh = Math.max(innerHeight, 1);
      const paperRect = paper?.getBoundingClientRect();
      const proofRect = proof?.getBoundingClientRect();
      const insidePaper = Boolean(paperRect && paperRect.top < vh * .55 && paperRect.bottom > vh * .08);
      const insideProofBook = Boolean(proofRect && proofRect.top < vh * .32 && proofRect.bottom > vh * .72);
      document.documentElement.toggleAttribute('data-disney-book-open', insidePaper || insideProofBook);
    };
    const queue = () => { if (!raf) raf = requestAnimationFrame(update); };
    addEventListener('scroll', queue, { passive: true });
    addEventListener('resize', queue, { passive: true });
    document.addEventListener('mm:worldchange', queue);
    update();
    disneyProjectBookCleanup = () => {
      if (raf) cancelAnimationFrame(raf);
      removeEventListener('scroll', queue);
      removeEventListener('resize', queue);
      document.removeEventListener('mm:worldchange', queue);
      document.documentElement.removeAttribute('data-disney-book-open');
    };
  }
  initDisneyProjectBook();
  document.addEventListener('astro:page-load', initDisneyProjectBook);
</script>

<style>
  .dpb-world{--paper:#f5e9c8;--paper-2:#dfcc9c;--gold:#e6c66f;background:#070c27;color:#fff8e4;font-family:var(--font-serif);overflow:clip}.dpb-world h2,.dpb-world p{margin-top:0}
  .dpb-cover-stage .sworld-stick{background:radial-gradient(circle at 54% 35%,color-mix(in srgb,var(--story-a) 20%,#344b80),#111943 45%,#05091f 78%)}
  .dpb-night,.dpb-opening-night,.dpb-proof-sky{position:absolute;inset:0;overflow:hidden}.dpb-night::before{content:"";position:absolute;inset:0;background:radial-gradient(circle at 12% 19%,#fff4b5 0 1px,transparent 1.8px),radial-gradient(circle at 76% 33%,#c7e2ff 0 1px,transparent 1.8px),radial-gradient(circle at 43% 71%,#fff 0 1px,transparent 1.8px);background-size:149px 171px,223px 207px,269px 287px;transform:translateY(calc(var(--p)*-95px))}
  .dpb-moon{position:absolute;right:13%;top:13%;width:min(25vw,320px);aspect-ratio:1;border-radius:50%;background:radial-gradient(circle at 38% 34%,#fffce6,#dccf9f 64%,#a69a73);box-shadow:0 0 55px #fff1b788,0 0 180px color-mix(in srgb,var(--story-a) 35%,transparent);transform:translateY(calc(var(--p)*-8vh)) scale(calc(.72 + var(--p)*.46))}
  .dpb-motes i,.dpb-proof-sky i{position:absolute;left:calc(4% + var(--i)*6.1%);top:calc(8% + (var(--i)%6)*14%);width:5px;aspect-ratio:1;border-radius:50%;background:var(--gold);box-shadow:0 0 15px var(--gold);animation:dpb-mote calc(3s + var(--i)*.17s) ease-in-out infinite alternate;animation-delay:calc(var(--i)*-.29s)}
  .dpb-horizon i{position:absolute;left:-8%;right:-8%;bottom:-8%;height:38%;background:#060a20;clip-path:polygon(0 70%,9% 51%,16% 65%,25% 28%,34% 67%,43% 38%,53% 69%,62% 23%,73% 62%,84% 35%,92% 65%,100% 45%,100% 100%,0 100%);transform:translateY(calc(var(--p)*var(--d)))}.dpb-horizon i:nth-child(1){--d:24px;bottom:5%;background:color-mix(in srgb,var(--story-a) 15%,#17254c);opacity:.45}.dpb-horizon i:nth-child(2){--d:48px;background:#111735;opacity:.72}.dpb-horizon i:nth-child(3){--d:78px;bottom:-17%}
  .dpb-cover-object{position:absolute;z-index:3;right:8vw;top:50%;width:min(43vw,610px);aspect-ratio:1.38;transform-style:preserve-3d;transform:translateY(-50%) perspective(1200px) rotateX(calc(50deg - var(--p)*42deg)) rotateY(calc(-16deg + var(--p)*12deg)) rotateZ(calc(5deg - var(--p)*5deg)) scale(calc(.72 + var(--p)*.5));filter:drop-shadow(0 48px 65px #000c)}
  .dpb-page-block{position:absolute;inset:4% -2% -5% 3%;border-radius:16px 38px 38px 16px;background:repeating-linear-gradient(#f0e3bd 0 2px,#ae9562 3px 4px);transform:translateZ(-17px)}.dpb-cover-face{position:absolute;inset:0;display:grid;place-items:center;padding:11%;border:5px double var(--gold);border-radius:16px 38px 38px 16px;text-align:center;background:radial-gradient(circle at 50% 40%,color-mix(in srgb,var(--story-a) 48%,#344b78),color-mix(in srgb,var(--story-b) 32%,#182146) 58%,#0a1233);box-shadow:inset 0 0 0 12px #10173b,inset 0 0 0 14px #e6c66f55;overflow:hidden}.dpb-cover-face::before,.dpb-cover-face::after{content:"";position:absolute;width:40%;aspect-ratio:1;border:1px solid #e6c66f55;transform:rotate(45deg)}.dpb-cover-face::before{left:-22%;top:-20%}.dpb-cover-face::after{right:-22%;bottom:-20%}.dpb-cover-face span{position:absolute;top:10%;color:var(--gold);font-style:italic}.dpb-cover-face>i{width:42%;aspect-ratio:1;border:1px solid var(--gold);border-radius:50%;box-shadow:0 0 0 10px #e6c66f10,0 0 45px color-mix(in srgb,var(--story-a) 35%,transparent)}.dpb-cover-face b{position:absolute;font-size:clamp(60px,10vw,150px);line-height:.7;color:#fff8e7}.dpb-cover-face small{position:absolute;bottom:10%;max-width:72%;font:700 10px var(--font);letter-spacing:.15em;text-transform:uppercase;color:#e1e7ff}
  .dpb-cover-face :global(.project-kinetic){position:absolute!important;z-index:2!important;left:14%!important;right:14%!important;top:23%!important;width:72%!important;min-height:0!important;margin:0!important;border-color:#e6c66f55!important;background:#0b123077!important;box-shadow:none!important;opacity:.46;filter:sepia(.3) saturate(.8);mix-blend-mode:screen;transform:scale(calc(.84 + var(--p)*.12)) rotateX(calc((1 - var(--p))*8deg))!important}.dpb-cover-face b{z-index:3;text-shadow:0 4px 28px #07102d}
  .dpb-cover-copy{position:absolute;z-index:5;left:6vw;top:50%;width:min(650px,50vw);transform:translateY(calc(-50% - var(--p)*25px));opacity:calc(1 - var(--p)*.35)}.dpb-cover-copy>span{color:var(--gold);font-style:italic}.dpb-cover-copy .story-heading{margin:20px 0;font-size:clamp(54px,7.3vw,105px);line-height:.88;font-weight:700;text-wrap:balance}.dpb-cover-copy p{max-width:58ch;color:#d6def6;font:500 clamp(16px,1.35vw,20px)/1.6 var(--font)}.dpb-cover-copy>div{display:flex;gap:18px;align-items:center;margin-top:25px}.dpb-cover-copy a{color:#fff2cc;text-decoration:none;font:700 13px var(--font)}.dpb-cover-copy a:first-child{padding:13px 18px;border:1px solid var(--gold);background:#e6c66f12}.dpb-stage-number{position:absolute;left:2vw;bottom:-.12em;color:#ffffff08;font-size:min(38vw,530px);line-height:.7}
  .dpb-opening-stage .sworld-stick{background:radial-gradient(circle at 50% 50%,#35497d,#0e153b 64%,#05081c)}.dpb-opening-night{opacity:calc(1 - var(--p)*1.6);background:radial-gradient(circle at 50% 50%,color-mix(in srgb,var(--story-a) 24%,transparent),transparent 44%)}
  .dpb-opening-book{position:absolute;z-index:2;left:50%;top:50%;width:min(91vw,1320px);height:min(69vw,770px);display:grid;grid-template-columns:1fr 18px 1fr;transform-style:preserve-3d;transform:translate(-50%,-50%) perspective(1400px) rotateX(calc(52deg - var(--p)*51deg)) scale(calc(.68 + var(--p)*1.28));filter:drop-shadow(0 55px 75px #000b)}.dpb-opening-page{position:relative;padding:clamp(28px,6vw,84px);background:var(--paper);color:#33293c;box-shadow:inset 0 0 90px #73531d20;overflow:hidden}.dpb-opening-page::after{content:"";position:absolute;inset:0;pointer-events:none;background:repeating-radial-gradient(circle at 20% 20%,#533b140a 0 1px,transparent 1.4px 4px);mix-blend-mode:multiply}.dpb-opening-page--copy{border-radius:28px 4px 4px 28px;transform-origin:right;transform:rotateY(calc((1 - var(--p))*66deg))}.dpb-opening-page--scene{display:grid;place-items:center;border-radius:4px 28px 28px 4px;transform-origin:left;transform:rotateY(calc((1 - var(--p))*-66deg));background:radial-gradient(circle at 50% 43%,color-mix(in srgb,var(--story-a) 18%,#fff1cb),#ddca9c 73%)}.dpb-opening-page--copy>span{color:color-mix(in srgb,var(--story-a) 70%,#795b1d);font-style:italic}.dpb-opening-page--copy h2{margin:22px 0;font-size:clamp(34px,3.8vw,55px);line-height:1.02;overflow-wrap:normal;word-break:normal;hyphens:none}.dpb-opening-page--copy p{color:#5c5260;font:500 clamp(15px,1.28vw,19px)/1.65 var(--font)}.dpb-opening-gutter{background:linear-gradient(90deg,#4c321e,#8d6337,#4b301c);box-shadow:0 0 28px #382219}
  .dpb-opening-page--scene :global(.project-kinetic){position:relative!important;z-index:4!important;width:92%!important;min-height:0!important;margin:0!important;background:#f0e1b9bd!important;border-color:#735a2e55!important;box-shadow:0 28px 55px #5c3e1c44!important;mix-blend-mode:multiply;filter:sepia(.22) saturate(.84) contrast(1.05);transform:translateY(calc((.5 - var(--p))*50px)) rotateX(calc((1 - var(--p))*11deg)) scale(calc(.84 + var(--p)*.12))!important;transform-origin:center bottom}.dpb-pop-architecture,.dpb-pop-foreground{position:absolute;inset:0;pointer-events:none}.dpb-pop-architecture{z-index:2;transform:translateY(calc((.5 - var(--p))*32px))}.dpb-pop-architecture i{position:absolute;bottom:4%;width:18%;height:62%;border:3px solid color-mix(in srgb,var(--story-a) 58%,#675027);border-bottom:0;border-radius:50% 50% 0 0}.dpb-pop-architecture i:first-child{left:3%}.dpb-pop-architecture i:last-child{right:3%}.dpb-pop-architecture b{position:absolute;left:11%;right:11%;top:7%;height:22%;border:2px solid color-mix(in srgb,var(--story-a) 52%,#675027);border-bottom:0;border-radius:50% 50% 0 0}.dpb-pop-foreground{z-index:5}.dpb-pop-foreground i{position:absolute;bottom:-1%;width:17%;height:30%;background:color-mix(in srgb,var(--story-a) 45%,#766139);clip-path:polygon(50% 0,65% 47%,100% 100%,0 100%,35% 47%);transform-origin:bottom;transform:rotate(calc((.5 - var(--p))*9deg))}.dpb-pop-foreground i:nth-child(1){left:0}.dpb-pop-foreground i:nth-child(2){right:0;height:38%}.dpb-pop-foreground i:nth-child(3){left:44%;width:10%;height:19%;opacity:.55}.dpb-opening-turn{position:absolute;z-index:6;right:0;top:0;width:50%;height:100%;border-radius:4px 28px 28px 4px;background:linear-gradient(100deg,#b99f68,#f6e9c5 17%,#d6bf8d);transform-origin:left;transform:rotateY(calc(-176deg*var(--p)));box-shadow:-30px 0 45px #4e351c44;backface-visibility:hidden}.dpb-enter-label{position:absolute;z-index:8;left:50%;bottom:4vh;transform:translateX(-50%);color:var(--gold);font:700 10px var(--font);letter-spacing:.16em;text-transform:uppercase;opacity:calc(1 - var(--p)*1.5)}

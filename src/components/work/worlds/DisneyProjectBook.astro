---
import { projects, type ProjectMeta } from '../../../data/projects';
import { storyForProject } from '../../../data/project-kinetics';
import { storybookSceneFor } from '../../../data/storybook-scenes';
import { homePath, pick, type Lang } from '../../../i18n/utils';

interface Props { lang: Lang; project: ProjectMeta }
const { lang, project } = Astro.props;
const story = storyForProject(project, lang);
const scene = storybookSceneFor(project);
const ar = lang === 'ar';
const no = String(projects.findIndex((item) => item.slug === project.slug) + 1).padStart(2, '0');
const back = `${homePath(lang)}#work`;
const arrow = ar ? '←' : '→';
const sceneStyle = `--story-a:${project.cardA};--story-b:${project.cardB};--scene-start:${scene.startX};--scene-end:${scene.endX};--scene-zoom:${scene.zoom};--scene-lift:${scene.lift};--scene-tilt:${scene.tilt}`;
---

<article
  class:list={['sworld', 'sworld--disney', 'dp-film', `dp-film--${scene.motion}`]}
  data-story-world="disney"
  data-project-film={project.slug}
  data-transition={scene.transition}
  style={sceneStyle}
  aria-hidden="true"
>
  <section class="sworld-stage dp-act dp-act--cover" data-story-stage data-film-act="cover" data-from-x={scene.startX} data-to-x={0}>
    <div class="sworld-stick dp-frame">
      <div class="dp-camera" aria-hidden="true">
        <img src={scene.image} alt="" width="1792" height="1024" fetchpriority="high" decoding="async" />
        <img class="dp-camera__near" src={scene.image} alt="" width="1792" height="1024" decoding="async" />
      </div>
      <div class="dp-wash" aria-hidden="true"></div>
      <header class="dp-cover-copy">
        <span>{ar ? 'حكاية تشغيل حقيقية' : 'A true operating story'} · {no}</span>
        <div class="story-heading" role="heading" aria-level="1">{pick(lang, project.title)}</div>
        <p>{pick(lang, story.lead)}</p>
        <a href="#the-friction">{ar ? 'ابدأ من المشكلة' : 'Begin with the friction'} ↓</a>
      </header>
      <div class="dp-book-edge" aria-hidden="true"><i></i><span>{scene.transition.replaceAll('-', ' ')}</span></div>
    </div>
  </section>

  <section id="the-friction" class="sworld-stage dp-act dp-act--problem" data-story-stage data-film-act="problem" data-from-x={scene.startX} data-to-x={scene.startX * .45}>
    <div class="sworld-stick dp-frame">
      <div class="dp-camera" aria-hidden="true">
        <img src={scene.image} alt="" width="1792" height="1024" loading="lazy" decoding="async" />
        <img class="dp-camera__near" src={scene.image} alt="" width="1792" height="1024" loading="lazy" decoding="async" />
      </div>
      <div class="dp-wash" aria-hidden="true"></div>
      <div class="dp-caption dp-caption--problem">
        <small>{ar ? 'الفصل الأول · ما شعر به الناس' : 'Chapter one · What people felt'}</small>
        <h2>{pick(lang, story.problemHeading)}</h2>
        <p>{pick(lang, story.problemBody)}</p>
      </div>
      <div class="dp-page-turn" aria-hidden="true"><i></i></div>
    </div>
  </section>

  <section class="sworld-stage dp-act dp-act--intervention" data-story-stage data-film-act="intervention" data-from-x={scene.startX * .3} data-to-x={scene.endX * .3}>
    <div class="sworld-stick dp-frame">
      <div class="dp-camera" aria-hidden="true">
        <img src={scene.image} alt="" width="1792" height="1024" loading="lazy" decoding="async" />
        <img class="dp-camera__near" src={scene.image} alt="" width="1792" height="1024" loading="lazy" decoding="async" />
      </div>
      <div class="dp-wash" aria-hidden="true"></div>
      <header class="dp-intervention-title">
        <small>{ar ? 'الفصل الثاني · لحظة التحول' : 'Chapter two · The intervention'}</small>
        <h2>{pick(lang, story.stepsHeading)}</h2>
      </header>
      <ol class="dp-steps">
        {story.steps.map((step, index) => (
          <li data-film-step={index}>
            <span>{step.n}</span>
            <div><h3>{pick(lang, step.title)}</h3><p>{pick(lang, step.body)}</p></div>
          </li>
        ))}
      </ol>
      <div class="dp-step-progress" aria-hidden="true"><i></i><b></b></div>
      <div class="dp-page-turn" aria-hidden="true"><i></i></div>
    </div>
  </section>

  <section class="sworld-stage dp-act dp-act--outcome" data-story-stage data-film-act="outcome" data-from-x={scene.endX * .35} data-to-x={scene.endX}>
    <div class="sworld-stick dp-frame">
      <div class="dp-camera" aria-hidden="true">
        <img src={scene.image} alt="" width="1792" height="1024" loading="lazy" decoding="async" />
        <img class="dp-camera__near" src={scene.image} alt="" width="1792" height="1024" loading="lazy" decoding="async" />
      </div>
      <div class="dp-wash" aria-hidden="true"></div>
      <div class="dp-caption dp-caption--outcome">
        <small>{ar ? 'الفصل الثالث · ما تغيّر' : 'Chapter three · What changed'}</small>
        <h2>{pick(lang, story.proofHeading)}</h2>
        <p>{pick(lang, story.proofBody)}</p>
        <dl>{story.proof.map((metric) => <div><dt>{metric.value}</dt><dd>{pick(lang, metric.label)}</dd></div>)}</dl>
        {story.link && <a href={story.link.href} target="_blank" rel="noopener">{pick(lang, story.link.label)} ↗</a>}
      </div>
      <div class="dp-page-turn" aria-hidden="true"><i></i></div>
    </div>
  </section>

  <section class="dp-boundary">
    <div>
      <small>{ar ? 'الخاتمة · الحد الصادق' : 'Epilogue · The honest boundary'}</small>
      <h2>{pick(lang, story.boundaryKicker)}</h2>
      <p>{pick(lang, story.boundary)}</p>
      <div class="dp-tools">{story.tools.map((tool) => <i>{tool}</i>)}</div>
    </div>
    <aside aria-hidden="true"><span>MM</span><i></i><b>{no}</b></aside>
    <a href={back}>{ar ? 'عد إلى كل الحكايات' : 'Return to every story'} {arrow}</a>
  </section>
</article>

<script>
  let projectFilmCleanup: (() => void) | null = null;
  function initProjectFilm() {
    projectFilmCleanup?.();
    const root = document.querySelector<HTMLElement>('[data-project-film]');
    if (!root) return;
    const acts = [...root.querySelectorAll<HTMLElement>('[data-film-act]')];
    let raf = 0;
    const clamp = (value: number) => Math.max(0, Math.min(1, value));
    const update = () => {
      raf = 0;
      if (root.getAttribute('aria-hidden') === 'true') return;
      acts.forEach((act) => {
        const rect = act.getBoundingClientRect();
        const p = clamp(-rect.top / Math.max(rect.height - innerHeight, 1));
        const eased = p * p * (3 - 2 * p);
        const from = Number(act.dataset.fromX || 0);
        const to = Number(act.dataset.toX || 0);
        const zoom = Number(getComputedStyle(root).getPropertyValue('--scene-zoom')) || 1.22;
        const lift = Number(getComputedStyle(root).getPropertyValue('--scene-lift')) || 0;
        const tilt = Number(getComputedStyle(root).getPropertyValue('--scene-tilt')) || 0;
        const pulse = Math.sin(Math.PI * p);
        const x = from + (to - from) * eased;
        act.style.setProperty('--film-p', p.toFixed(4));
        act.style.setProperty('--frame-x', `${x.toFixed(3)}vw`);
        act.style.setProperty('--frame-near-x', `${(x * 1.16).toFixed(3)}vw`);
        act.style.setProperty('--frame-y', `${(lift * pulse).toFixed(3)}vh`);
        act.style.setProperty('--frame-near-y', `${(lift * pulse * 1.3).toFixed(3)}vh`);
        act.style.setProperty('--frame-scale', (1.12 + (zoom - 1.08) * pulse).toFixed(4));
        act.style.setProperty('--frame-near-scale', (1.17 + (zoom - 1.03) * pulse).toFixed(4));
        act.style.setProperty('--frame-tilt', `${(tilt * (p - .5) * 2).toFixed(3)}deg`);
        act.style.setProperty('--page-p', clamp((p - .84) / .16).toFixed(4));
        if (act.dataset.filmAct === 'intervention') {
          const count = Math.max(act.querySelectorAll('[data-film-step]').length, 1);
          act.dataset.activeStep = String(Math.min(count - 1, Math.floor(p * count)));
        }
      });
    };
    const queue = () => { if (!raf) raf = requestAnimationFrame(update); };
    addEventListener('scroll', queue, { passive: true });
    addEventListener('resize', queue, { passive: true });
    document.addEventListener('mm:worldchange', queue);
    update();
    projectFilmCleanup = () => {
      if (raf) cancelAnimationFrame(raf);
      removeEventListener('scroll', queue);
      removeEventListener('resize', queue);
      document.removeEventListener('mm:worldchange', queue);
    };
  }
  initProjectFilm();
  document.addEventListener('astro:page-load', initProjectFilm);
</script>

<style>
  .dp-film{--paper:#e9dcc0;--ink:#211d19;background:#11100f;color:#f5ecde;font-family:var(--font);overflow:clip}.dp-act{height:225vh;--film-p:0;--page-p:0}.dp-act--cover{height:300vh}.dp-act--intervention{height:340vh}.dp-act .sworld-stick{position:sticky;top:0;height:100svh;min-height:620px;overflow:hidden}.dp-frame{isolation:isolate;background:#15120f;overflow:hidden}.dp-camera{position:absolute;inset:-7%;transform:translate3d(var(--frame-x,0),var(--frame-y,0),0) scale(var(--frame-scale,1.12)) rotate(var(--frame-tilt,0deg));will-change:transform}.dp-camera img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;filter:saturate(.84) contrast(1.04)}.dp-camera__near{clip-path:polygon(0 63%,18% 57%,42% 66%,63% 55%,82% 62%,100% 56%,100% 100%,0 100%);transform:translate3d(calc(var(--frame-near-x,0vw) - var(--frame-x,0vw)),calc(var(--frame-near-y,0vh) - var(--frame-y,0vh)),0) scale(var(--frame-near-scale,1.17));filter:saturate(.9) contrast(1.08)!important}.dp-wash{position:absolute;z-index:1;inset:0;background:linear-gradient(90deg,#06070bc7 0,transparent 46%,#09090d82 100%),linear-gradient(0deg,#09090dc7,transparent 55%);pointer-events:none}:global([dir="rtl"]) .dp-wash{transform:scaleX(-1)}.dp-frame::after{content:"";position:absolute;z-index:2;inset:0;opacity:.19;pointer-events:none;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.82' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.32'/%3E%3C/svg%3E");mix-blend-mode:multiply}
  .dp-cover-copy{position:absolute;z-index:4;left:clamp(22px,6vw,110px);bottom:clamp(36px,9vh,120px);width:min(860px,84vw);text-shadow:0 3px 30px #000}.dp-cover-copy span,.dp-caption small,.dp-intervention-title small,.dp-boundary small{font-size:10px;font-weight:800;letter-spacing:.18em;text-transform:uppercase;color:#e4c994}.dp-cover-copy .story-heading{margin:14px 0;font-size:clamp(54px,9vw,140px);font-weight:750;line-height:.82;letter-spacing:-.065em;text-wrap:balance}.dp-cover-copy p{max-width:680px;font-size:clamp(16px,1.7vw,24px);line-height:1.5}.dp-cover-copy a,.dp-caption a{display:inline-flex;margin-top:18px;padding:12px 18px;border:1px solid #e3c68f8c;border-radius:999px;background:#11100db8;color:#fff;text-decoration:none;font-weight:800;backdrop-filter:blur(10px)}.dp-cover-copy a:focus-visible,.dp-caption a:focus-visible,.dp-boundary>a:focus-visible{outline:3px solid #fff;outline-offset:4px}:global([dir="rtl"]) .dp-cover-copy{left:auto;right:clamp(22px,6vw,110px)}
  .dp-book-edge{position:absolute;z-index:4;right:3vw;top:10vh;bottom:10vh;width:1px;background:#f0d59a38}.dp-book-edge i{position:absolute;inset:0;background:#f0d59a;transform-origin:top;transform:scaleY(var(--film-p))}.dp-book-edge span{position:absolute;right:16px;bottom:0;writing-mode:vertical-rl;color:#e2c58c;font-size:9px;font-weight:800;letter-spacing:.17em;text-transform:uppercase}:global([dir="rtl"]) .dp-book-edge{right:auto;left:3vw}:global([dir="rtl"]) .dp-book-edge span{right:auto;left:16px}
  .dp-caption{position:absolute;z-index:4;bottom:clamp(34px,9vh,118px);left:clamp(22px,7vw,130px);width:min(690px,84vw);text-shadow:0 3px 28px #000}.dp-caption h2,.dp-intervention-title h2{margin:12px 0;font:600 clamp(46px,7vw,108px)/.88 Georgia,serif;letter-spacing:-.055em;text-wrap:balance}.dp-caption>p{max-width:640px;font-size:clamp(16px,1.55vw,23px);line-height:1.55;text-wrap:pretty}.dp-caption--outcome{left:auto;right:clamp(22px,7vw,130px);text-align:right}.dp-caption dl{display:flex;flex-wrap:wrap;justify-content:flex-end;gap:12px;margin:24px 0 0}.dp-caption dl div{max-width:240px;padding:14px 18px;border:1px solid #eed8ad55;border-radius:14px;background:#11100dc4;backdrop-filter:blur(9px)}.dp-caption dt{font-size:clamp(27px,4vw,58px);font-weight:850;line-height:1}.dp-caption dd{margin:6px 0 0;color:#e8dece;font-size:12px;line-height:1.4}:global([dir="rtl"]) .dp-caption{left:auto;right:clamp(22px,7vw,130px);text-align:right}:global([dir="rtl"]) .dp-caption--outcome{right:auto;left:clamp(22px,7vw,130px);text-align:left}:global([dir="rtl"]) .dp-caption--outcome dl{justify-content:flex-start}
  .dp-intervention-title{position:absolute;z-index:4;top:max(82px,11vh);left:clamp(22px,6vw,110px);width:min(760px,82vw);text-shadow:0 3px 28px #000}.dp-intervention-title h2{font-size:clamp(42px,6vw,84px)}:global([dir="rtl"]) .dp-intervention-title{left:auto;right:clamp(22px,6vw,110px)}.dp-steps{position:absolute;z-index:4;right:clamp(20px,6vw,100px);bottom:clamp(30px,7vh,88px);width:min(580px,84vw);list-style:none;margin:0;padding:0}.dp-steps li{display:grid;grid-template-columns:auto 1fr;gap:15px;align-items:start;padding:18px;border:1px solid #ead3a94d;border-radius:15px;background:#11100dcc;box-shadow:0 18px 50px #0005;backdrop-filter:blur(12px);opacity:0;transform:translateY(28px) scale(.98);transition:opacity .3s ease,transform .42s ease;position:absolute;right:0;bottom:0;width:100%}.dp-steps li>span{display:grid;place-items:center;width:38px;aspect-ratio:1;border-radius:50%;background:#e5d2aa;color:#241f18;font-weight:900}.dp-steps h3{margin:0 0 7px;font:600 clamp(24px,3vw,40px)/1 Georgia,serif}.dp-steps p{margin:0;color:#e9dfcf;font-size:14px;line-height:1.5}.dp-act--intervention[data-active-step="0"] [data-film-step="0"],.dp-act--intervention[data-active-step="1"] [data-film-step="1"],.dp-act--intervention[data-active-step="2"] [data-film-step="2"],.dp-act--intervention[data-active-step="3"] [data-film-step="3"]{opacity:1;transform:none}:global([dir="rtl"]) .dp-steps{right:auto;left:clamp(20px,6vw,100px)}.dp-step-progress{position:absolute;z-index:4;right:3vw;top:20vh;bottom:20vh;width:2px;background:#ffffff2b}.dp-step-progress b{position:absolute;inset:0;background:#ebce94;transform-origin:top;transform:scaleY(var(--film-p))}.dp-step-progress i{position:absolute;left:50%;top:calc(var(--film-p)*100%);width:9px;aspect-ratio:1;border-radius:50%;background:#ffe0a5;transform:translate(-50%,-50%)}:global([dir="rtl"]) .dp-step-progress{right:auto;left:3vw}
  .dp-page-turn{position:absolute;z-index:8;right:-4%;top:-3%;width:60%;height:106%;background:linear-gradient(100deg,#cbbb96,#eee4ce 52%,#ad9a72);box-shadow:-35px 0 75px #0008;transform-origin:right center;transform:perspective(1400px) rotateY(calc(var(--page-p)*-110deg));opacity:clamp(0,calc(var(--page-p)*2),1);pointer-events:none}.dp-page-turn::before{content:"";position:absolute;inset:0;background:repeating-linear-gradient(5deg,transparent 0 7px,#6c5a3b0c 8px 9px)}.dp-page-turn i{position:absolute;left:9%;top:8%;bottom:8%;width:1px;background:#5c4a2e33}:global([dir="rtl"]) .dp-page-turn{right:auto;left:-4%;transform-origin:left center;transform:perspective(1400px) rotateY(calc(var(--page-p)*110deg))}
  .dp-boundary{min-height:100vh;display:grid;grid-template-columns:minmax(0,1fr) minmax(240px,34vw);align-content:center;gap:40px;padding:14vh clamp(22px,8vw,140px);background:radial-gradient(circle at 78% 28%,#f4ebda,#d4c19d);color:var(--ink)}.dp-boundary>div{align-self:center}.dp-boundary h2{margin:12px 0;font:600 clamp(48px,7vw,106px)/.9 Georgia,serif;letter-spacing:-.055em}.dp-boundary p{max-width:740px;font-size:clamp(17px,1.65vw,25px);line-height:1.55}.dp-boundary aside{align-self:center;aspect-ratio:1.45;display:grid;place-items:center;border:2px solid #735e3b;border-radius:10px 28px 28px 10px;box-shadow:inset 0 0 0 9px #e0cfad,inset 0 0 0 11px #735e3b33;background:#1a2a42;color:#e8d7b6;transform:rotate(3deg)}.dp-boundary aside span{position:absolute;font:700 11px Georgia,serif;letter-spacing:.3em}.dp-boundary aside i{width:40%;aspect-ratio:1;border:1px solid #c7a96f;border-radius:50%}.dp-boundary aside b{position:absolute;bottom:14%;font-size:12px;letter-spacing:.18em}.dp-boundary>a{grid-column:1/-1;justify-self:start;padding:14px 20px;border:1px solid #6e5938;border-radius:999px;color:var(--ink);text-decoration:none;font-weight:850}.dp-tools{display:flex;flex-wrap:wrap;gap:8px;margin-top:24px}.dp-tools i{padding:7px 10px;border:1px solid #7b684b55;border-radius:999px;font-style:normal;font-size:11px}
  @media(max-width:760px){.dp-act{height:245vh}.dp-act--cover{height:275vh}.dp-act--intervention{height:360vh}.dp-camera{inset:-4% -66%}.dp-cover-copy{left:20px;right:20px;bottom:max(34px,7vh);width:auto}.dp-cover-copy .story-heading{font-size:clamp(50px,15vw,78px)}:global([dir="rtl"]) .dp-cover-copy{left:20px;right:20px}.dp-caption,.dp-caption--outcome,:global([dir="rtl"]) .dp-caption,:global([dir="rtl"]) .dp-caption--outcome{left:20px;right:20px;bottom:max(30px,6vh);width:auto;text-align:start}.dp-caption h2{font-size:clamp(42px,13vw,68px)}.dp-caption>p{font-size:15px}.dp-caption dl,.dp-caption--outcome dl,:global([dir="rtl"]) .dp-caption--outcome dl{justify-content:flex-start}.dp-intervention-title,:global([dir="rtl"]) .dp-intervention-title{left:20px;right:20px;top:max(78px,10vh);width:auto}.dp-intervention-title h2{font-size:clamp(38px,11vw,58px)}.dp-steps,:global([dir="rtl"]) .dp-steps{left:20px;right:20px;bottom:max(28px,6vh);width:auto}.dp-step-progress{right:10px}:global([dir="rtl"]) .dp-step-progress{left:10px}.dp-page-turn{width:80%}.dp-boundary{grid-template-columns:1fr;padding-left:22px;padding-right:22px}.dp-boundary aside{width:min(78vw,420px)}}
  @media(prefers-reduced-motion:reduce){.dp-act{height:auto}.dp-frame{position:relative;min-height:110svh;display:flex;flex-direction:column;justify-content:flex-end;padding:22vh 20px 30px}.dp-camera{inset:0;transform:none}.dp-camera__near,.dp-page-turn,.dp-step-progress,.dp-book-edge{display:none}.dp-cover-copy,.dp-caption,.dp-caption--outcome,.dp-intervention-title,.dp-steps{position:relative;left:auto!important;right:auto!important;top:auto;bottom:auto;width:min(760px,100%);text-align:start}.dp-cover-copy,.dp-caption,.dp-intervention-title{padding:18px;border-radius:15px;background:#11100dcc}.dp-steps{display:grid;gap:10px;margin-top:18px}.dp-steps li{position:relative;opacity:1;transform:none}.dp-act--intervention .dp-frame{justify-content:flex-end}.dp-boundary{min-height:auto;padding-top:18vh;padding-bottom:18vh}}
</style>

---
import { automationProjects, labProjects } from '../../data/system-projects';
import { legacyProjects } from '../../data/projects';
import { storybookRealmFor } from '../../data/storybook-realms';
import { pick, workPath, type Lang } from '../../i18n/utils';
import ProjectKinetic from '../work/ProjectKinetic.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const ar = lang === 'ar';
const all = [...automationProjects, ...legacyProjects, ...labProjects];
const groups = [
  { title: ar ? 'أنظمة الأتمتة' : 'Automation systems', kicker: ar ? 'الفصل الأول' : 'Act one', items: automationProjects },
  { title: ar ? 'الأساس التشغيلي' : 'Operating foundation', kicker: ar ? 'الفصل الثاني' : 'Act two', items: legacyProjects },
  { title: ar ? 'المختبر الهندسي' : 'Engineering lab', kicker: ar ? 'الفصل الثالث' : 'Act three', items: labProjects },
];
const particles = Array.from({ length: 18 });
const chapterNumber = (slug: string) => String(all.findIndex((item) => item.slug === slug) + 1).padStart(2, '0');
const chapterStyle = (project: (typeof all)[number], index: number) => {
  const hash = [...project.slug].reduce((sum, char) => sum + char.charCodeAt(0), 0);
  return `--ink:${project.cardA};--ink-2:${project.cardB};--tilt:${((hash % 9) - 4) * .35}deg;--drift:${18 + (hash % 33)}px;--delay:${(index % 7) * -.37}s`;
};
const arrow = ar ? '←' : '→';
---

<article class="wj wj--disney db-world" data-world-journey="disney" data-disney-book-home aria-hidden="true">
  <section class="wj-stage db-awakening" data-world-stage>
    <div class="wj-stick">
      <div class="db-night" aria-hidden="true">
        <div class="db-moon"></div>
        <div class="db-hills"><i></i><i></i><i></i></div>
        <div class="db-fireflies">{particles.map((_, i) => <i style={`--i:${i}`}></i>)}</div>
      </div>
      <div class="db-pedestal" aria-hidden="true"><i></i><b></b></div>
      <div class="db-closed-book" aria-hidden="true">
        <div class="db-book-pages"></div>
        <div class="db-cover">
          <span>MM</span>
          <i></i>
          <b>{ar ? 'حكايات الأنظمة' : 'Stories of systems'}</b>
          <small>{all.length} {ar ? 'فصلًا حقيقيًا' : 'true chapters'}</small>
        </div>
      </div>
      <div class="db-intro">
        <p>{ar ? 'كتاب أعمال حي' : 'A living book of work'}</p>
        <div class="home-heading" role="heading" aria-level="1">{ar ? 'كل نظام يبدأ قبل أن تُرى الآلة.' : 'Every system begins before the machine appears.'}</div>
        <span>{ar ? 'مرّر الصفحة. اقترب من الكتاب.' : 'Scroll. Move closer to the book.'}</span>
      </div>
      <div class="db-scroll-cue" aria-hidden="true"><i></i><span>{ar ? 'افتح' : 'OPEN'}</span></div>
    </div>
  </section>

  <section class="wj-stage db-portal" data-world-stage>
    <div class="wj-stick">
      <div class="db-portal-night" aria-hidden="true">{particles.slice(0, 10).map((_, i) => <i style={`--i:${i}`}></i>)}</div>
      <div class="db-spread" aria-hidden="true">
        <div class="db-page db-page--left">
          <span>{ar ? 'قبل' : 'Once'}</span>
          <svg viewBox="0 0 400 420" role="presentation"><path d="M48 330h304M93 330V191l67-64 65 64v139m-97-1v-70h63v70m52 0V113l72 78v139M90 154 46 211v119"/><circle cx="105" cy="95" r="30"/><path d="M105 125v57m-33-26h66"/></svg>
        </div>
        <b class="db-gutter"></b>
        <div class="db-page db-page--right">
          <span>{ar ? 'بعد' : 'After'}</span>
          <svg viewBox="0 0 400 420" role="presentation"><path d="M45 329h310M65 329V180h80v149m17 0V111h80v218m18 0V214h76v115M81 201h48m49-59h48m50 103h44"/><path d="M82 160c28-73 112-101 178-56 38 26 59 65 60 110"/><circle cx="82" cy="160" r="13"/><circle cx="320" cy="214" r="13"/></svg>
        </div>
        <div class="db-page-turn" aria-hidden="true"></div>
      </div>
      <div class="db-portal-copy">
        <span>{ar ? 'الحقيقة لا تتغير عندما يتغير الفصل' : 'The truth survives the page turn'}</span>
        <h2>{ar ? 'ادخل الكتاب.' : 'Enter the book.'}</h2>
        <p>{ar ? 'في الداخل، تتحول كل مشكلة إلى مشهد، وكل معمارية إلى آلية ورقية، وكل نتيجة إلى دليل مكتوب على الصفحة.' : 'Inside, every problem becomes a scene, every architecture becomes a paper mechanism, and every result leaves evidence on the page.'}</p>
      </div>
      <div class="db-iris" aria-hidden="true"></div>
    </div>
  </section>

  <main class="db-manuscript" id="disney-chapters">
    <header class="db-manuscript__title">
      <span>{ar ? 'المخطوطة الكاملة' : 'The complete manuscript'}</span>
      <h2>{ar ? 'ثلاثون فصلًا. لكل واحد عالمه وآليته.' : 'Thirty chapters. Each with its own world and mechanism.'}</h2>
      <p>{ar ? 'لا بطاقات مكررة هنا. كل تمريرة تقلب صفحة، وكل رسم يشرح كيف يعمل المشروع بالفعل.' : 'No repeated cards here. Each scroll turns a page, and each illustration explains how that project actually works.'}</p>
    </header>

    {groups.map((group, groupIndex) => (
      <section class="db-act" data-act={groupIndex + 1}>
        <header>
          <span>{group.kicker}</span>
          <h3>{group.title}</h3>
          <i>{String(group.items.length).padStart(2, '0')} {ar ? 'فصول' : 'chapters'}</i>
        </header>
        <div class="db-chapter-list">
          {group.items.map((project, index) => {
            const scene = storybookRealmFor(project);
            const absoluteIndex = all.findIndex((item) => item.slug === project.slug);
            return (
              <section
                class:list={['db-chapter', `db-chapter--${scene}`, absoluteIndex % 2 && 'db-chapter--reverse']}
                data-disney-chapter
                data-project-chapter={project.slug}
                data-scene={scene}
                style={chapterStyle(project, absoluteIndex)}
              >
                <div class="db-chapter__atmosphere" aria-hidden="true">
                  <i></i><i></i><i></i><b></b><span></span>
                </div>
                <a class="db-sheet" href={workPath(lang, project.slug)} aria-label={`${ar ? 'افتح فصل' : 'Open chapter'} ${pick(lang, project.title)}`}>
                  <div class="db-sheet__grain" aria-hidden="true"></div>
                  <div class="db-chapter-copy">
                    <span>{ar ? 'الفصل' : 'Chapter'} {chapterNumber(project.slug)}</span>
                    <small>{pick(lang, project.tag)}</small>
                    <h4>{pick(lang, project.title)}</h4>
                    <p>{pick(lang, project.blurb)}</p>
                    <dl><dt>{pick(lang, project.stat)}</dt><dd>{pick(lang, project.statNote)}</dd></dl>
                    <b>{ar ? 'ادخل الفصل' : 'Enter chapter'} {arrow}</b>
                  </div>
                  <div class="db-pop-up" aria-hidden="true">
                    <div class="db-scene-sky"><i></i><i></i><i></i></div>
                    <div class="db-scene-arch"><i></i><b></b><i></i></div>
                    <ProjectKinetic project={project} lang={lang} world="disney" compact />
                    <div class="db-scene-front"><i></i><i></i><i></i></div>
                  </div>
                  <div class="db-folio">MM · {chapterNumber(project.slug)}</div>
                  <div class="db-curl" aria-hidden="true"></div>
                </a>
              </section>
            );
          })}
        </div>
      </section>
    ))}

    <footer class="db-epilogue">
      <div aria-hidden="true"><i></i><b>MM</b><i></i></div>
      <span>{ar ? 'الخاتمة ليست النهاية' : 'The epilogue is not the end'}</span>
      <h2>{ar ? 'الفصل التالي نكتبه معًا.' : 'We write the next chapter together.'}</h2>
      <a href="#contact">{ar ? 'ابدأ الحكاية التالية' : 'Begin the next story'} {arrow}</a>
    </footer>
  </main>
</article>

<script>
  let disneyBookCleanup: (() => void) | null = null;
  function initDisneyBook() {
    disneyBookCleanup?.();
    const root = document.querySelector<HTMLElement>('[data-disney-book-home]');
    if (!root) return;
    const chapters = [...root.querySelectorAll<HTMLElement>('[data-disney-chapter]')];
    const manuscript = root.querySelector<HTMLElement>('.db-manuscript');
    let raf = 0;
    const update = () => {
      raf = 0;
      if (root.getAttribute('aria-hidden') === 'true') {
        document.documentElement.removeAttribute('data-disney-book-open');
        return;
      }
      const vh = Math.max(window.innerHeight, 1);
      if (manuscript) {
        const paper = manuscript.getBoundingClientRect();
        document.documentElement.toggleAttribute('data-disney-book-open', paper.top < vh * .52 && paper.bottom > 0);
      }
      chapters.forEach((chapter) => {
        const rect = chapter.getBoundingClientRect();
        const progress = Math.max(0, Math.min(1, (vh - rect.top) / (vh + rect.height)));
        chapter.style.setProperty('--chapter-p', progress.toFixed(4));
        chapter.toggleAttribute('data-in-view', rect.bottom > vh * .08 && rect.top < vh * .92);
      });
    };
    const queue = () => { if (!raf) raf = requestAnimationFrame(update); };
    addEventListener('scroll', queue, { passive: true });
    addEventListener('resize', queue, { passive: true });
    document.addEventListener('mm:worldchange', queue);
    update();
    disneyBookCleanup = () => {
      if (raf) cancelAnimationFrame(raf);
      removeEventListener('scroll', queue);
      removeEventListener('resize', queue);
      document.removeEventListener('mm:worldchange', queue);
      document.documentElement.removeAttribute('data-disney-book-open');
    };
  }
  initDisneyBook();
  document.addEventListener('astro:page-load', initDisneyBook);
</script>

<style>
  .db-world{--paper:#f4e8c6;--paper-deep:#d8c493;--night:#070c27;--gold:#e6c66f;background:var(--night);color:#fff9e8;font-family:var(--font-serif);overflow:clip}
  .db-awakening .wj-stick{background:radial-gradient(circle at 50% 38%,#324880 0,#151d51 34%,#080d29 68%,#030617 100%)}
  .db-night,.db-portal-night{position:absolute;inset:0;overflow:hidden}.db-night::before{content:"";position:absolute;inset:0;background:radial-gradient(circle at 8% 18%,#fff 0 1px,transparent 1.8px),radial-gradient(circle at 72% 29%,#ffe9a0 0 1px,transparent 1.8px),radial-gradient(circle at 41% 68%,#bde5ff 0 1px,transparent 1.8px);background-size:137px 173px,211px 229px,283px 251px;transform:translateY(calc(var(--p)*-110px)) scale(calc(1 + var(--p)*.08));opacity:calc(.65 - var(--p)*.25)}
  .db-moon{position:absolute;left:50%;top:14%;width:min(18vw,220px);aspect-ratio:1;border-radius:50%;background:#fff5cf;box-shadow:0 0 45px #fff4c9aa,0 0 140px #8ab8ff66;transform:translate(-50%,calc(var(--p)*-5vh)) scale(calc(.78 + var(--p)*.38))}
  .db-moon::after{content:"";position:absolute;inset:12%;border-radius:inherit;background:radial-gradient(circle at 65% 35%,#d6cfae 0 5%,transparent 6%),radial-gradient(circle at 38% 62%,#d6cfae 0 8%,transparent 9%);opacity:.42}
  .db-hills i{position:absolute;left:-10%;right:-10%;bottom:-12%;height:45%;background:#05091e;clip-path:polygon(0 69%,8% 51%,15% 68%,23% 35%,31% 62%,42% 30%,50% 57%,59% 20%,70% 62%,79% 38%,88% 63%,100% 31%,100% 100%,0 100%);transform:translateY(calc(var(--p)*var(--y)))}.db-hills i:nth-child(1){--y:32px;opacity:.35;bottom:3%;background:#263865}.db-hills i:nth-child(2){--y:54px;opacity:.65;bottom:-5%;background:#11183a}.db-hills i:nth-child(3){--y:82px}
  .db-fireflies i,.db-portal-night i{--x:calc((var(--i)*47)%100);position:absolute;left:calc(4% + (var(--i)*53%));top:calc(8% + (var(--i)*37%));width:clamp(3px,.45vw,7px);aspect-ratio:1;border-radius:50%;background:#ffe58b;box-shadow:0 0 16px #ffe58b;animation:db-float calc(3.2s + var(--i)*.13s) ease-in-out infinite alternate;animation-delay:calc(var(--i)*-.31s)}
  .db-pedestal{position:absolute;left:50%;bottom:3%;width:min(86vw,1080px);height:20vh;transform:translateX(-50%) translateY(calc(var(--p)*8vh));perspective:900px}.db-pedestal i{position:absolute;inset:0;border-radius:50%;background:radial-gradient(ellipse,#1e2b59,#080d25 68%);transform:rotateX(67deg);box-shadow:0 -10px 60px #d7c67b22}.db-pedestal b{position:absolute;left:50%;top:34%;width:42%;height:70%;transform:translateX(-50%);background:linear-gradient(90deg,#090d25,#1b2750,#090d25);clip-path:polygon(8% 0,92% 0,100% 100%,0 100%)}
  .db-closed-book{position:absolute;z-index:3;left:50%;top:52%;width:min(52vw,670px);aspect-ratio:1.48;transform-style:preserve-3d;transform:translate(-50%,-50%) perspective(1200px) rotateX(calc(54deg - var(--p)*43deg)) rotateZ(calc(-7deg + var(--p)*7deg)) scale(calc(.68 + var(--p)*.56));filter:drop-shadow(0 45px 55px #000a)}
  .db-book-pages{position:absolute;inset:5% -1% -4% 3%;border-radius:18px 34px 34px 18px;background:repeating-linear-gradient(#f5e8c5 0 2px,#c9b47f 3px 4px);transform:translateZ(-18px)}
  .db-cover{position:absolute;inset:0;display:grid;place-items:center;text-align:center;padding:12%;border:5px double var(--gold);border-radius:18px 40px 40px 18px;background:radial-gradient(circle at 50% 42%,#315391,#182855 54%,#0b153a);box-shadow:inset 0 0 0 12px #0b1332,inset 0 0 0 14px #e6c66f66;transform-origin:left;transform:rotateY(calc(var(--p)*-8deg));overflow:hidden}.db-cover::before,.db-cover::after{content:"";position:absolute;width:42%;aspect-ratio:1;border:1px solid #e6c66f55;transform:rotate(45deg)}.db-cover::before{left:-22%;top:-20%}.db-cover::after{right:-22%;bottom:-20%}.db-cover span{position:absolute;top:11%;font-size:13px;letter-spacing:.38em;color:var(--gold)}.db-cover i{width:42%;aspect-ratio:1;border:1px solid var(--gold);border-radius:50%;box-shadow:0 0 0 10px #e6c66f12,0 0 40px #e6c66f33}.db-cover b{position:absolute;left:12%;right:12%;font-size:clamp(25px,3.8vw,54px);line-height:1.02;text-transform:uppercase;letter-spacing:.02em}.db-cover small{position:absolute;bottom:12%;color:#d9e3ff;font:600 11px var(--font);letter-spacing:.18em;text-transform:uppercase}
  .db-intro{position:absolute;z-index:5;left:6vw;top:11vh;width:min(720px,47vw);transform:translateY(calc(var(--p)*-36px));opacity:calc(1 - var(--p)*1.35)}.db-intro p{color:var(--gold);font-style:italic}.db-intro .home-heading{font-size:clamp(52px,7.5vw,108px);font-weight:700;line-height:.9;text-wrap:balance}.db-intro>span{display:block;margin-top:24px;color:#d5ddf8;font-family:var(--font)}
  .db-scroll-cue{position:absolute;z-index:5;right:5vw;bottom:6vh;display:grid;justify-items:center;gap:9px;color:#d9c477;font:700 9px var(--font);letter-spacing:.22em}.db-scroll-cue i{width:1px;height:52px;background:linear-gradient(transparent,#e6c66f);transform-origin:top;transform:scaleY(calc(.2 + var(--p)*.8))}
  .db-portal .wj-stick{background:radial-gradient(circle at 50% 50%,#3a4e82,#0b112f 65%,#040719)}.db-portal-night{opacity:calc(1 - var(--p)*1.3)}.db-portal-night i{left:calc(9% + var(--i)*9%);top:calc(14% + (var(--i)%4)*19%)}
  .db-spread{position:absolute;z-index:2;left:50%;top:50%;width:min(84vw,1180px);height:min(66vw,710px);display:grid;grid-template-columns:1fr 18px 1fr;transform-style:preserve-3d;transform:translate(-50%,-50%) perspective(1400px) rotateX(calc(48deg - var(--p)*47deg)) scale(calc(.74 + var(--p)*1.8));filter:drop-shadow(0 50px 65px #000a)}
  .db-page{position:relative;padding:8%;background:var(--paper);color:#342b3e;overflow:hidden;box-shadow:inset 0 0 90px #8e6c3028}.db-page::after{content:"";position:absolute;inset:0;background:repeating-radial-gradient(circle at 30% 20%,#6d54230a 0 1px,transparent 1px 4px);mix-blend-mode:multiply}.db-page--left{border-radius:30px 4px 4px 30px;transform-origin:right;transform:rotateY(calc((1 - var(--p))*62deg))}.db-page--right{border-radius:4px 30px 30px 4px;transform-origin:left;transform:rotateY(calc((1 - var(--p))*-62deg))}.db-page>span{position:relative;z-index:2;font-size:clamp(31px,5vw,72px);font-weight:700;text-transform:uppercase}.db-page svg{position:absolute;inset:19% 7% 2%;width:86%;height:76%;fill:none;stroke:#5d4b54;stroke-width:5;stroke-linecap:round;stroke-linejoin:round;opacity:calc(.2 + var(--p)*.75);transform:translateY(calc((1 - var(--p))*35px))}.db-gutter{background:linear-gradient(90deg,#5a3b24,#8c6336,#50331e);box-shadow:0 0 25px #2c1a13}.db-page-turn{position:absolute;z-index:5;right:0;top:0;width:50%;height:100%;border-radius:4px 30px 30px 4px;background:linear-gradient(100deg,#c5ad77,#f4e8c6 22%,#dfca99 100%);transform-origin:left;transform:rotateY(calc(-176deg*var(--p)));box-shadow:-25px 0 45px #4b351c44;backface-visibility:hidden}
  .db-portal-copy{position:absolute;z-index:5;left:50%;top:50%;width:min(780px,82vw);text-align:center;transform:translate(-50%,-50%) translateY(calc((1 - var(--p))*60px));opacity:clamp(0,calc((var(--p) - .24)*3),1);color:#362a3b}.db-portal-copy span{color:#8b6b2b;font-style:italic}.db-portal-copy h2{margin:17px 0;font-size:clamp(58px,9vw,128px);line-height:.86}.db-portal-copy p{max-width:66ch;margin-inline:auto;font:500 clamp(15px,1.4vw,20px)/1.65 var(--font)}
  .db-iris{position:absolute;z-index:7;inset:-25%;pointer-events:none;border:clamp(0px,calc((1 - var(--p))*18vw),290px) solid #030617;border-radius:42%;opacity:calc(1 - var(--p));transform:scale(calc(1 + var(--p)*.4))}
  .db-manuscript{position:relative;background:var(--paper);color:#30283a;box-shadow:0 -60px 120px #0008}.db-manuscript::before{content:"";position:absolute;inset:0;pointer-events:none;background:radial-gradient(circle at 5% 7%,#6c512112 0 1px,transparent 1.7px),radial-gradient(circle at 80% 43%,#6c51210c 0 1px,transparent 1.5px);background-size:17px 19px,23px 27px;mix-blend-mode:multiply;opacity:.65}
  .db-manuscript__title{position:relative;z-index:2;min-height:100svh;display:flex;flex-direction:column;justify-content:center;padding:12vh 8vw 16vh;border-bottom:1px solid #846d423d;text-align:center}.db-manuscript__title::before{content:"MM";position:absolute;left:50%;top:50%;font-size:min(42vw,610px);line-height:.7;color:#765d2410;transform:translate(-50%,-50%)}.db-manuscript__title span,.db-act>header span{color:#8c6b25;font-style:italic}.db-manuscript__title h2{position:relative;max-width:13ch;margin:22px auto;font-size:clamp(54px,8vw,112px);line-height:.92;text-wrap:balance}.db-manuscript__title p{position:relative;max-width:68ch;margin-inline:auto;font:500 clamp(16px,1.5vw,21px)/1.65 var(--font);color:#5f5663}
  .db-act{position:relative}.db-act>header{position:relative;z-index:3;display:grid;grid-template-columns:1fr auto;align-items:end;min-height:46vh;padding:12vh 7vw 7vh;border-bottom:1px solid #745d3038}.db-act>header span{grid-column:1/-1}.db-act>header h3{margin:16px 0 0;font-size:clamp(47px,7vw,96px);line-height:.9}.db-act>header i{font:600 11px var(--font);font-style:normal;letter-spacing:.14em;text-transform:uppercase;color:#7c705e}

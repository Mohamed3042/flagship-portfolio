---
import { automationProjects, labProjects } from '../../data/system-projects';
import { legacyProjects } from '../../data/projects';
import { storyForProject } from '../../data/project-kinetics';
import { storybookSceneFor } from '../../data/storybook-scenes';
import { pick, workPath, type Lang } from '../../i18n/utils';

interface Props { lang: Lang }
const { lang } = Astro.props;
const ar = lang === 'ar';
const all = [...automationProjects, ...legacyProjects, ...labProjects];
const groups = [
  { title: ar ? 'أنظمة الأتمتة' : 'Automation systems', kicker: ar ? 'الفصل الأول' : 'Act one', items: automationProjects },
  { title: ar ? 'الأساس التشغيلي' : 'Operating foundation', kicker: ar ? 'الفصل الثاني' : 'Act two', items: legacyProjects },
  { title: ar ? 'المختبر الهندسي' : 'Engineering lab', kicker: ar ? 'الفصل الثالث' : 'Act three', items: labProjects },
];
const chapterNumber = (slug: string) => String(all.findIndex((item) => item.slug === slug) + 1).padStart(2, '0');
const arrow = ar ? '←' : '→';
---

<article class="wj wj--disney sb-world" data-world-journey="disney" data-disney-book-home aria-hidden="true">
  <section class="wj-stage sb-book-film" data-book-film data-world-stage>
    <div class="wj-stick">
      <div class="sb-desk" aria-hidden="true">
        <img src="/images/storybook/opening-book.webp" alt="" width="1792" height="1024" fetchpriority="high" decoding="async" />
        <img class="sb-desk__near" src="/images/storybook/opening-book.webp" alt="" width="1792" height="1024" decoding="async" />
      </div>
      <div class="sb-cover-lid" aria-hidden="true">
        <i></i><span>MM</span><b>{ar ? 'حكايات الأنظمة' : 'Systems, made human'}</b><small>{all.length} {ar ? 'حكاية حقيقية' : 'true stories'}</small>
      </div>
      <div class="sb-page-fan" aria-hidden="true"><i></i><i></i><i></i></div>
      <div class="sb-film-copy sb-film-copy--first">
        <span>{ar ? 'ليس معرض مشاريع' : 'Not a project gallery'}</span>
        <div class="home-heading" role="heading" aria-level="1">{ar ? 'إنها حكايات عن عملٍ كان يؤلم الناس.' : 'Work hurt. Then the system changed it.'}</div>
        <p>{ar ? 'مرّر لتفتح الكتاب.' : 'Scroll to open the book.'}</p>
      </div>
      <div class="sb-film-copy sb-film-copy--second">
        <span>{ar ? 'المشكلة ← التدخل ← النتيجة' : 'Friction → intervention → outcome'}</span>
        <h2>{ar ? 'ادخل إلى العمل.' : 'Enter the work.'}</h2>
        <p>{ar ? 'كل فصل مشهد إنساني حقيقي، وليس رسماً تقنياً مكرراً.' : 'Every chapter is a human situation—not another reskinned diagram.'}</p>
      </div>
      <div class="sb-film-progress" aria-hidden="true"><span></span><i></i></div>
      <div class="sb-film-iris" aria-hidden="true"></div>
    </div>
  </section>

  <main class="sb-manuscript" id="disney-chapters">
    <header class="sb-manuscript__title">
      <span>{ar ? 'المخطوطة الكاملة' : 'The complete manuscript'}</span>
      <h2>{ar ? 'ثلاثون موقفاً. ثلاثون تحولاً.' : 'Thirty situations. Thirty transformations.'}</h2>
      <p>{ar ? 'تتحرك الكاميرا من الفوضى، عبر لحظة البناء، إلى النتيجة التي يمكن إثباتها.' : 'The camera moves from friction, through the build, to an outcome that can be proved.'}</p>
    </header>

    {groups.map((group, groupIndex) => (
      <section class="sb-act" data-act={groupIndex + 1}>
        <header class="sb-act__title">
          <span>{group.kicker}</span><h3>{group.title}</h3><i>{String(group.items.length).padStart(2, '0')}</i>
        </header>
        {group.items.map((project, localIndex) => {
          const absoluteIndex = all.findIndex((item) => item.slug === project.slug);
          const story = storyForProject(project, lang);
          const scene = storybookSceneFor(project);
          const intervention = story.steps.slice(0, 2).map((step) => pick(lang, step.title)).join(ar ? '، ثم ' : '. Then ');
          return (
            <section
              class:list={['sb-chapter', `sb-chapter--${scene.motion}`, localIndex % 2 && 'sb-chapter--reverse']}
              data-disney-chapter
              data-story-panorama
              data-project-chapter={project.slug}
              data-motion={scene.motion}
              data-transition={scene.transition}
              data-start-x={scene.startX}
              data-end-x={scene.endX}
              data-lift={scene.lift}
              data-zoom={scene.zoom}
              data-tilt={scene.tilt}
              style={`--accent:${project.cardA};--accent-2:${project.cardB};--chapter-index:${absoluteIndex};--turn-skew:${(absoluteIndex % 7) - 3}deg`}
            >
              <div class="sb-shot">
                <div class="sb-camera" aria-hidden="true">
                  <img class="sb-panorama" src={scene.image} alt="" width="1792" height="1024" loading={absoluteIndex === 0 ? 'eager' : 'lazy'} decoding="async" />
                  <img class="sb-panorama sb-panorama--near" src={scene.image} alt="" width="1792" height="1024" loading="lazy" decoding="async" />
                  <div class="sb-light-pass"></div>
                </div>
                <div class="sb-grain" aria-hidden="true"></div>
                <div class="sb-folio"><span>{ar ? 'الفصل' : 'Chapter'} {chapterNumber(project.slug)}</span><i>{pick(lang, project.tag)}</i></div>

                <div class="sb-beat sb-beat--problem" data-story-beat="problem">
                  <small>{ar ? 'قبل' : 'The friction'}</small>
                  <h4>{pick(lang, story.problemHeading)}</h4>
                  <p>{pick(lang, story.problemBody)}</p>
                </div>
                <div class="sb-beat sb-beat--intervention" data-story-beat="intervention">
                  <small>{ar ? 'لحظة التحول' : 'The intervention'}</small>
                  <h4>{pick(lang, story.stepsHeading)}</h4>
                  <p>{intervention}</p>
                </div>
                <div class="sb-beat sb-beat--outcome" data-story-beat="outcome">
                  <small>{ar ? 'بعد' : 'The outcome'}</small>
                  <h4>{pick(lang, project.title)}</h4>
                  <strong>{pick(lang, project.stat)}</strong>
                  <p>{pick(lang, project.statNote)}</p>
                  <a href={workPath(lang, project.slug)}>{ar ? 'شاهد الحكاية كاملة' : 'Watch the full story'} {arrow}</a>
                </div>

                <div class="sb-page-turn" aria-hidden="true"><i></i><span>{scene.transition.replaceAll('-', ' ')}</span></div>
              </div>
            </section>
          );
        })}
      </section>
    ))}

    <footer class="sb-epilogue">
      <span>{ar ? 'الصفحة التالية لم تُكتب بعد' : 'The next page is unwritten'}</span>
      <h2>{ar ? 'لنكتب نظام العمل التالي.' : 'Let’s write the next operating story.'}</h2>
      <a href="#contact">{ar ? 'ابدأ الحكاية' : 'Begin the story'} {arrow}</a>
    </footer>
  </main>
</article>

<script>
  let storybookCinemaCleanup: (() => void) | null = null;
  function initStorybookCinema() {
    storybookCinemaCleanup?.();
    const root = document.querySelector<HTMLElement>('[data-disney-book-home]');
    if (!root) return;
    const film = root.querySelector<HTMLElement>('[data-book-film]');
    const manuscript = root.querySelector<HTMLElement>('.sb-manuscript');
    const chapters = [...root.querySelectorAll<HTMLElement>('[data-disney-chapter]')];
    let raf = 0;
    const clamp = (value: number) => Math.max(0, Math.min(1, value));
    const progress = (element: HTMLElement) => {
      const rect = element.getBoundingClientRect();
      return clamp(-rect.top / Math.max(rect.height - innerHeight, 1));
    };
    const update = () => {
      raf = 0;
      if (root.getAttribute('aria-hidden') === 'true') {
        document.documentElement.removeAttribute('data-disney-book-open');
        return;
      }
      if (film) film.style.setProperty('--film-p', progress(film).toFixed(4));
      if (manuscript) {
        const rect = manuscript.getBoundingClientRect();
        document.documentElement.toggleAttribute('data-disney-book-open', rect.top < innerHeight * .7 && rect.bottom > 0);
      }
      chapters.forEach((chapter) => {
        const p = progress(chapter);
        const eased = p * p * (3 - 2 * p);
        const start = Number(chapter.dataset.startX || 10);
        const end = Number(chapter.dataset.endX || -10);
        const lift = Number(chapter.dataset.lift || 0);
        const zoom = Number(chapter.dataset.zoom || 1.22);
        const tilt = Number(chapter.dataset.tilt || 0);
        const pulse = Math.sin(Math.PI * p);
        const x = start + (end - start) * eased;
        chapter.style.setProperty('--chapter-p', p.toFixed(4));
        chapter.style.setProperty('--cam-x', `${x.toFixed(3)}vw`);
        chapter.style.setProperty('--near-x', `${(x * 1.16).toFixed(3)}vw`);
        chapter.style.setProperty('--cam-y', `${(lift * pulse).toFixed(3)}vh`);
        chapter.style.setProperty('--near-y', `${(lift * pulse * 1.28).toFixed(3)}vh`);
        chapter.style.setProperty('--cam-scale', (1.1 + (zoom - 1.1) * pulse).toFixed(4));
        chapter.style.setProperty('--near-scale', (1.14 + (zoom - 1.06) * pulse).toFixed(4));
        chapter.style.setProperty('--cam-tilt', `${(tilt * (p - .5) * 2).toFixed(3)}deg`);
        chapter.style.setProperty('--turn-p', clamp((p - .82) / .18).toFixed(4));
        chapter.dataset.activeBeat = p < .34 ? 'problem' : p < .69 ? 'intervention' : 'outcome';
      });
    };
    const queue = () => { if (!raf) raf = requestAnimationFrame(update); };
    addEventListener('scroll', queue, { passive: true });
    addEventListener('resize', queue, { passive: true });
    document.addEventListener('mm:worldchange', queue);
    update();
    storybookCinemaCleanup = () => {
      if (raf) cancelAnimationFrame(raf);
      removeEventListener('scroll', queue);
      removeEventListener('resize', queue);
      document.removeEventListener('mm:worldchange', queue);
      document.documentElement.removeAttribute('data-disney-book-open');
    };
  }
  initStorybookCinema();
  document.addEventListener('astro:page-load', initStorybookCinema);
</script>

<style>
  .sb-world{--paper:#e9dcc0;--ink:#201d1a;--night:#090d18;background:#0d1017;color:#f5eddf;font-family:var(--font);overflow:clip}
  .sb-book-film{height:430vh;--film-p:0}.sb-book-film .wj-stick{position:sticky;top:0;height:100svh;min-height:620px;overflow:hidden;background:#0b0d12;perspective:1600px;isolation:isolate}
  .sb-desk{position:absolute;inset:-7%;transform:translate3d(0,calc((.5 - var(--film-p))*5vh),0) scale(calc(.73 + var(--film-p)*1.74));transform-origin:50% 55%;filter:saturate(.82) contrast(1.04) brightness(calc(.58 + var(--film-p)*.47))}
  .sb-desk img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.sb-desk__near{clip-path:polygon(0 65%,100% 57%,100% 100%,0 100%);transform:translateY(calc(var(--film-p)*-3vh)) scale(calc(1 + var(--film-p)*.035));filter:contrast(1.04)}
  .sb-cover-lid{position:absolute;z-index:4;left:50%;top:56%;width:min(59vw,850px);aspect-ratio:1.58;display:grid;place-items:center;text-align:center;padding:8%;border:2px solid #a98b58;border-radius:18px 38px 38px 18px;background:radial-gradient(circle at 48% 40%,#263a5a,#111d34 61%,#091121);box-shadow:inset 0 0 0 12px #0c1427,inset 0 0 0 14px #b69a682f,0 36px 80px #000b;color:#ece0c6;transform-origin:left center;transform-style:preserve-3d;transform:translate(-50%,-50%) rotateX(7deg) rotateY(calc(var(--film-p)*-176deg)) scale(calc(.98 - var(--film-p)*.2));opacity:clamp(0,calc(1.28 - var(--film-p)*1.7),1)}
  :global([dir="rtl"]) .sb-cover-lid{transform-origin:right center;transform:translate(-50%,-50%) rotateX(7deg) rotateY(calc(var(--film-p)*176deg)) scale(calc(.98 - var(--film-p)*.2))}
  .sb-cover-lid::before,.sb-cover-lid::after{content:"";position:absolute;inset:6%;border:1px solid #b89a656e;border-radius:12px 28px 28px 12px}.sb-cover-lid::after{inset:11%;border-style:double}.sb-cover-lid i{position:absolute;left:8%;top:7%;bottom:7%;width:2px;background:#b89a6580;box-shadow:8px 0 18px #0008}.sb-cover-lid span{position:absolute;top:12%;font:600 11px Georgia,serif;letter-spacing:.32em;color:#c5aa78}.sb-cover-lid b{font:600 clamp(28px,4.8vw,70px)/.92 Georgia,serif;max-width:80%;text-wrap:balance}.sb-cover-lid small{position:absolute;bottom:12%;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:#b9c6d9}
  .sb-page-fan{position:absolute;z-index:3;left:50%;top:56%;width:min(58vw,835px);aspect-ratio:1.58;transform:translate(-50%,-50%);perspective:1200px}.sb-page-fan i{position:absolute;inset:2%;border-radius:12px 30px 30px 12px;background:#eadfca;box-shadow:0 18px 45px #0007;transform-origin:left;opacity:clamp(0,calc((var(--film-p) - var(--start))*8),1);transform:rotateY(calc(clamp(0,calc((var(--film-p) - var(--start))*4),1)*-165deg))}.sb-page-fan i:nth-child(1){--start:.24}.sb-page-fan i:nth-child(2){--start:.33}.sb-page-fan i:nth-child(3){--start:.42}
  .sb-film-copy{position:absolute;z-index:6;max-width:min(680px,80vw);text-shadow:0 3px 30px #000;pointer-events:none}.sb-film-copy span{font:700 11px var(--font);letter-spacing:.18em;text-transform:uppercase;color:#d5bd8b}.sb-film-copy .home-heading,.sb-film-copy h2{font-size:clamp(44px,7.1vw,110px);line-height:.88;letter-spacing:-.055em;text-wrap:balance}.sb-film-copy p{font-size:clamp(14px,1.35vw,20px);color:#eee4d2}.sb-film-copy--first{left:5vw;bottom:8vh;opacity:clamp(0,calc(1 - var(--film-p)*3.6),1);transform:translateY(calc(var(--film-p)*-5vh))}.sb-film-copy--second{right:5vw;top:10vh;text-align:right;opacity:clamp(0,calc((var(--film-p) - .5)*5),1);transform:translateY(calc((1 - var(--film-p))*8vh))}:global([dir="rtl"]) .sb-film-copy--second{text-align:left;right:auto;left:5vw}
  .sb-film-progress{position:absolute;z-index:7;right:2.6vw;top:16vh;bottom:16vh;width:2px;background:#ffffff1c}.sb-film-progress i{position:absolute;inset:0;background:#d8bd86;transform-origin:top;transform:scaleY(var(--film-p))}.sb-film-progress span{position:absolute;left:50%;top:calc(var(--film-p)*100%);width:9px;aspect-ratio:1;border-radius:50%;background:#f1dfbc;transform:translate(-50%,-50%);box-shadow:0 0 18px #f1dfbc99}.sb-film-iris{position:absolute;z-index:5;inset:0;pointer-events:none;box-shadow:inset 0 0 calc(var(--film-p)*24vw) calc(var(--film-p)*4vw) #05070d;opacity:clamp(0,calc((var(--film-p) - .7)*2.4),.75)}
  .sb-manuscript{position:relative;background:#171512}.sb-manuscript__title,.sb-act__title,.sb-epilogue{background:var(--paper);color:var(--ink)}.sb-manuscript__title{min-height:90vh;display:grid;align-content:center;gap:20px;padding:14vh clamp(24px,8vw,140px);background:linear-gradient(115deg,#d9c9aa,#f2e8d2 58%,#c8b38c)}.sb-manuscript__title span,.sb-act__title span,.sb-epilogue span{font:700 11px var(--font);letter-spacing:.19em;text-transform:uppercase;color:#735d3f}.sb-manuscript__title h2,.sb-epilogue h2{max-width:1050px;margin:0;font:600 clamp(48px,8vw,120px)/.89 Georgia,serif;letter-spacing:-.055em;text-wrap:balance}.sb-manuscript__title p{max-width:700px;font-size:clamp(17px,1.7vw,24px);line-height:1.55;color:#4c4439}
  .sb-act__title{min-height:62vh;display:grid;grid-template-columns:1fr auto;align-content:center;gap:10px 30px;padding:11vh clamp(24px,8vw,140px);border-top:1px solid #8f7955}.sb-act__title span{grid-column:1/-1}.sb-act__title h3{margin:0;font:600 clamp(44px,7vw,102px)/.95 Georgia,serif}.sb-act__title i{align-self:end;font-size:clamp(34px,5vw,74px);font-style:normal;color:#8d7756}
  .sb-chapter{height:230vh;position:relative;--chapter-p:0;--turn-p:0}.sb-shot{position:sticky;top:0;height:100vh;height:100dvh;overflow:hidden;isolation:isolate;background:#171411}.sb-camera{position:absolute;inset:-7%;transform:translate3d(var(--cam-x,10vw),var(--cam-y,0),0) scale(var(--cam-scale,1.1)) rotate(var(--cam-tilt,0deg));will-change:transform}.sb-panorama{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;filter:saturate(.84) contrast(1.03)}.sb-panorama--near{clip-path:polygon(0 62%,25% 57%,55% 65%,75% 55%,100% 60%,100% 100%,0 100%);transform:translate3d(calc(var(--near-x,10vw) - var(--cam-x,10vw)),calc(var(--near-y,0vh) - var(--cam-y,0vh)),0) scale(var(--near-scale,1.14));filter:saturate(.9) contrast(1.08) brightness(.93)}
  .sb-light-pass{position:absolute;inset:-20%;background:linear-gradient(102deg,#0a0d17bb 2%,transparent 38%,#ffe1a52b 67%,#fff0c549 100%);transform:translateX(calc((var(--chapter-p) - .5)*22%));mix-blend-mode:soft-light}.sb-grain{position:absolute;z-index:2;inset:0;opacity:.2;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.35'/%3E%3C/svg%3E");mix-blend-mode:multiply;pointer-events:none}.sb-shot::after{content:"";position:absolute;z-index:2;inset:0;background:linear-gradient(90deg,#07080dc2 0,transparent 45%,#07080d80 100%),linear-gradient(0deg,#07080daf,transparent 48%);pointer-events:none}:global([dir="rtl"]) .sb-shot::after{transform:scaleX(-1)}
  .sb-folio{position:absolute;z-index:4;top:max(76px,8vh);left:clamp(20px,4vw,70px);right:clamp(20px,4vw,70px);display:flex;justify-content:space-between;gap:20px;color:#efe6d7;font-size:10px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;text-shadow:0 2px 16px #000}.sb-folio i{font-style:normal;color:#d8bd8c}
  .sb-beat{position:absolute;z-index:4;left:clamp(20px,6vw,110px);bottom:clamp(32px,8vh,100px);width:min(620px,84vw);opacity:0;transform:translateY(34px) scale(.985);transition:opacity .32s ease,transform .45s cubic-bezier(.2,.8,.2,1);pointer-events:none;text-shadow:0 3px 24px #000}.sb-chapter--reverse .sb-beat{left:auto;right:clamp(20px,6vw,110px);text-align:right}:global([dir="rtl"]) .sb-beat{left:auto;right:clamp(20px,6vw,110px);text-align:right}:global([dir="rtl"]) .sb-chapter--reverse .sb-beat{right:auto;left:clamp(20px,6vw,110px);text-align:left}.sb-beat small{display:block;margin-bottom:12px;color:#e3c993;font-size:10px;font-weight:800;letter-spacing:.18em;text-transform:uppercase}.sb-beat h4{margin:0 0 12px;font:600 clamp(38px,6vw,86px)/.9 Georgia,serif;letter-spacing:-.05em;text-wrap:balance}.sb-beat p{max-width:590px;margin:0;color:#f1e9dc;font-size:clamp(14px,1.3vw,19px);line-height:1.5;text-wrap:pretty}.sb-beat strong{display:block;margin:12px 0 8px;color:#fff3d6;font-size:clamp(34px,5vw,72px);line-height:1}.sb-beat a{display:inline-flex;margin-top:20px;padding:12px 18px;border:1px solid #e4c99199;border-radius:999px;background:#17130dbd;color:#fff;text-decoration:none;font-weight:800;pointer-events:auto;backdrop-filter:blur(10px)}.sb-beat a:focus-visible{outline:3px solid #fff;outline-offset:4px}.sb-chapter[data-active-beat="problem"] .sb-beat--problem,.sb-chapter[data-active-beat="intervention"] .sb-beat--intervention,.sb-chapter[data-active-beat="outcome"] .sb-beat--outcome{opacity:1;transform:none}

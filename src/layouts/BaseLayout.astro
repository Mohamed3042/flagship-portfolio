---
import '../styles/tokens.css';
import { ClientRouter } from 'astro:transitions';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { profile } from '../data/profile';
import { useTranslations, dir, mirrorPath, pick, type Lang } from '../i18n/utils';
import type { Accent } from '../data/projects';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** path of THIS page, e.g. "/en" or "/en/work/meta-ads" */
  path: string;
  accent?: Accent;
  home?: boolean;
  ogImage?: string;
  footerNote?: string;
  /** extra schema.org node(s) merged into the JSON-LD graph */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** when true: emit robots noindex + skip canonical/hreflang (e.g. the 404 page) */
  noindex?: boolean;
}

const {
  lang,
  title,
  description,
  path,
  accent = 'blue',
  home = false,
  ogImage,
  footerNote,
  jsonLd,
  noindex = false,
} = Astro.props;

const t = useTranslations(lang);
const direction = dir(lang);

// SEO canonical: the same build is served from two hosts (Netlify at the root,
// GitHub Pages under /flagship-portfolio/), but search engines must see ONE
// canonical origin. Netlify (the clean root host) is canonical; the GitHub
// Pages copy is a functional mirror that points crawlers here instead of
// competing as duplicate content. Keep this origin in sync with the Netlify
// SITE in `astro.config.mjs`.
const CANONICAL = new URL('https://mohamed-khalil-kw.netlify.app');
// Normalize a path to base-free + root-relative so it maps onto the canonical
// root host regardless of which build (rooted or /flagship-portfolio/) emitted
// it. Tolerates input with or without the deployment base.
const baseSeg = import.meta.env.BASE_URL.replace(/\/$/, '');
const abs = (p: string): string => {
  let s = p.startsWith('/') ? p : `/${p}`;
  if (baseSeg && (s === baseSeg || s.startsWith(baseSeg + '/'))) s = s.slice(baseSeg.length) || '/';
  return new URL(s, CANONICAL).href;
};
const canonical = abs(path);
const enUrl = abs(mirrorPath(path, 'en'));
const arUrl = abs(mirrorPath(path, 'ar'));
const ogUrl = abs(ogImage ?? `/og/${lang}.png`);

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: pick(lang, profile.name),
  alternateName: [lang === 'ar' ? profile.name.en : profile.name.ar, profile.nickname],
  jobTitle: pick(lang, profile.title),
  description: pick(lang, profile.tagline),
  inLanguage: lang === 'ar' ? 'ar' : 'en',
  url: abs(`/${lang}`),
  image: ogUrl,
  email: `mailto:${profile.contact.email}`,
  telephone: profile.contact.phone,
  nationality: { '@type': 'Country', name: 'Egypt' },
  knowsLanguage: ['Arabic', 'English'],
  address: { '@type': 'PostalAddress', addressCountry: 'KW', addressLocality: 'Kuwait' },
  sameAs: [profile.contact.linkedin, profile.contact.whatsapp],
  alumniOf: { '@type': 'CollegeOrUniversity', name: pick(lang, profile.education[0].org) },
  hasCredential: profile.certifications.map((c) => ({
    '@type': 'EducationalOccupationalCredential',
    name: pick(lang, c.name),
    credentialCategory: 'certification',
    recognizedBy: { '@type': 'Organization', name: c.org },
  })),
};

const graph = [personSchema, ...(Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [])];
---

<!doctype html>
<html lang={lang} dir={direction}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {!noindex && <link rel="canonical" href={canonical} />}

    {
      !noindex && (
        <>
          <link rel="alternate" hreflang="en" href={enUrl} />
          <link rel="alternate" hreflang="ar" href={arUrl} />
          <link rel="alternate" hreflang="x-default" href={enUrl} />
        </>
      )
    }

    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f5f5f7" media="(prefers-color-scheme: light)" />
    <meta name="color-scheme" content="dark light" />

    <!-- icons -->
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Cdefs%3E%3ClinearGradient id='g' x1='0' y1='0' x2='1' y2='1'%3E%3Cstop offset='0' stop-color='%232997ff'/%3E%3Cstop offset='.5' stop-color='%23a259ff'/%3E%3Cstop offset='1' stop-color='%23ff5e8a'/%3E%3C/linearGradient%3E%3C/defs%3E%3Crect width='64' height='64' rx='15' fill='black'/%3E%3Ctext x='50%25' y='52%25' font-family='Inter,Arial' font-size='30' font-weight='800' fill='url(%23g)' text-anchor='middle' dominant-baseline='middle'%3EMM%3C/text%3E%3C/svg%3E"
    />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/apple-touch-icon.png`} />

    <!-- Open Graph -->
    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content={profile.name.en} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'ar' ? 'ar_KW' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'ar' ? 'en_US' : 'ar_KW'} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(graph)} is:inline />

    <!-- No flash of wrong theme: dark is default, honour an explicit light choice. -->
    <script is:inline>
      (() => {
        document.documentElement.classList.add('js');
        // Owner's choice: this portfolio ALWAYS plays its motion — even when the
        // OS asks to reduce motion — because the scroll animations ARE the work
        // being shown. Make every reduced-motion media query report "motion is
        // fine" so the JS engines (pins, scrub, centerpieces, biome, starfield)
        // never fall back to static. The CSS reduced-motion blocks are likewise
        // neutralised in tokens.css. (Reverting = delete this shim + restore the
        // @media blocks.)
        try {
          const _mm = window.matchMedia.bind(window);
          window.matchMedia = (q) => {
            if (typeof q === 'string' && q.indexOf('prefers-reduced-motion') !== -1) {
              return {
                matches: q.indexOf('no-preference') !== -1, // reduce→false, no-preference→true
                media: q, onchange: null,
                addEventListener() {}, removeEventListener() {},
                addListener() {}, removeListener() {}, dispatchEvent() { return false; },
              };
            }
            return _mm(q);
          };
        } catch (e) {
          /* matchMedia unavailable — nothing to override */
        }
        const apply = () => {
          try {
            const root = document.documentElement;
            // N-theme selector: dark (attribute absent, the default) · light ·
            // neon · cinema · storybook · wave — same mm-theme key both sites share.
            const THEMES = ['dark', 'light', 'neon', 'cinema', 'storybook', 'wave'];
            let v = localStorage.getItem('mm-theme') || 'dark';
            if (THEMES.indexOf(v) === -1) v = 'dark';
            if (v === 'dark') root.removeAttribute('data-theme');
            else root.setAttribute('data-theme', v);
            localStorage.setItem('mm-lang', root.getAttribute('lang') || 'en');
          } catch (e) {
            /* ignore */
          }
        };
        apply();
        document.addEventListener('astro:after-swap', apply);
      })();
    </script>

    <ClientRouter />
  </head>

  <body data-accent={accent}>
    <canvas id="space" aria-hidden="true"></canvas>
    <a href="#main" class="skip-link">{t('a11y.skip')}</a>
    <div class="progress" aria-hidden="true"></div>

    <Nav lang={lang} home={home} />

    <main id="main">
      <slot />
    </main>

    <Footer lang={lang} note={footerNote} />

    <script>
      import { initInteractions } from '../lib/interactions';
      import { initMotion } from '../lib/motion';
      import { initAurora } from '../lib/aurora';
      import { initSpace } from '../lib/space';
      import { activeTheme, THEME_GLYPHS } from '../lib/theme';

      // Reflect the active theme in the nav menu (trigger glyph + selected row).
      function syncThemeUI() {
        const cur = activeTheme();
        document
          .querySelectorAll<HTMLElement>('[data-theme-btn]')
          .forEach((b) => (b.textContent = THEME_GLYPHS[cur]));
        document
          .querySelectorAll<HTMLElement>('[data-theme-opt]')
          .forEach((o) => o.setAttribute('aria-selected', o.dataset.themeOpt === cur ? 'true' : 'false'));
      }

      function boot() {
        initInteractions();
        initMotion();
        initAurora();
        initSpace();
        syncThemeUI();
      }
      boot();
      document.addEventListener('astro:page-load', boot);

      /* Theme menu — delegated once on document (survives View Transitions). */
      function closeThemeMenus() {
        document.querySelectorAll<HTMLElement>('[data-theme-menu]').forEach((m) => {
          m.querySelector('[data-theme-btn]')?.setAttribute('aria-expanded', 'false');
          m.querySelector('.theme-menu__list')?.setAttribute('hidden', '');
        });
      }
      function applyTheme(v: string) {
        const root = document.documentElement;
        if (v === 'dark') root.removeAttribute('data-theme');
        else root.setAttribute('data-theme', v);
        try {
          localStorage.setItem('mm-theme', v);
        } catch (err) {
          /* ignore */
        }
        // Repaint canvases + retime the motion engines for the new palette.
        document.dispatchEvent(new Event('mm:themechange'));
        syncThemeUI();
      }
      document.addEventListener('click', (e) => {
        const t = e.target as HTMLElement;
        const opt = t.closest<HTMLElement>('[data-theme-opt]');
        if (opt) {
          applyTheme(opt.dataset.themeOpt || 'dark');
          closeThemeMenus();
          return;
        }
        const btn = t.closest<HTMLElement>('[data-theme-btn]');
        if (btn) {
          const menu = btn.closest('[data-theme-menu]');
          const list = menu?.querySelector<HTMLElement>('.theme-menu__list');
          const wasClosed = !!list?.hasAttribute('hidden');
          closeThemeMenus();
          if (list && wasClosed) {
            list.removeAttribute('hidden');
            btn.setAttribute('aria-expanded', 'true');
          }
          return;
        }
        closeThemeMenus();
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          const open = document.querySelector<HTMLElement>('[data-theme-menu] [aria-expanded="true"]');
          closeThemeMenus();
          open?.focus();
          return;
        }
        if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
          const list = (e.target as HTMLElement).closest?.('.theme-menu__list');
          if (!list) return;
          e.preventDefault();
          const opts = Array.from(list.querySelectorAll<HTMLElement>('[data-theme-opt]'));
          const i = opts.indexOf(document.activeElement as HTMLElement);
          const n = e.key === 'ArrowDown' ? (i + 1) % opts.length : (i - 1 + opts.length) % opts.length;
          opts[n]?.focus();
        }
      });
    </script>
  </body>
</html>

---
import '../styles/tokens.css';
import '../styles/worlds.css';
import '../styles/identity-scenes.css';
import '../styles/showcase-worlds.css';
import { ClientRouter } from 'astro:transitions';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { profile } from '../data/profile';
import { useTranslations, dir, mirrorPath, pick, type Lang } from '../i18n/utils';
import type { Accent } from '../data/projects';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** path of THIS page, e.g. "/en" or "/en/work/meta-ads" */
  path: string;
  accent?: Accent;
  home?: boolean;
  ogImage?: string;
  footerNote?: string;
  /** extra schema.org node(s) merged into the JSON-LD graph */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** when true: emit robots noindex + skip canonical/hreflang (e.g. the 404 page) */
  noindex?: boolean;
}

const {
  lang,
  title,
  description,
  path,
  accent = 'blue',
  home = false,
  ogImage,
  footerNote,
  jsonLd,
  noindex = false,
} = Astro.props;

const t = useTranslations(lang);
const direction = dir(lang);

// SEO canonical: the same build is served from two hosts (Netlify at the root,
// GitHub Pages under /flagship-portfolio/), but search engines must see ONE
// canonical origin. Netlify (the clean root host) is canonical; the GitHub
// Pages copy is a functional mirror that points crawlers here instead of
// competing as duplicate content. Keep this origin in sync with the Netlify
// SITE in `astro.config.mjs`.
const CANONICAL = new URL('https://mohamed-mahmoud-kuwait.netlify.app');
// Normalize a path to base-free + root-relative so it maps onto the canonical
// root host regardless of which build (rooted or /flagship-portfolio/) emitted
// it. Tolerates input with or without the deployment base.
const baseSeg = import.meta.env.BASE_URL.replace(/\/$/, '');
const abs = (p: string): string => {
  let s = p.startsWith('/') ? p : `/${p}`;
  if (baseSeg && (s === baseSeg || s.startsWith(baseSeg + '/'))) s = s.slice(baseSeg.length) || '/';
  return new URL(s, CANONICAL).href;
};
const canonical = abs(path);
const enUrl = abs(mirrorPath(path, 'en'));
const arUrl = abs(mirrorPath(path, 'ar'));
const ogUrl = abs(ogImage ?? `/og/${lang}.png`);

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: pick(lang, profile.name),
  alternateName: [lang === 'ar' ? profile.name.en : profile.name.ar, profile.nickname],
  jobTitle: pick(lang, profile.title),
  description: pick(lang, profile.tagline),
  inLanguage: lang === 'ar' ? 'ar' : 'en',
  url: abs(`/${lang}`),
  image: ogUrl,
  email: `mailto:${profile.contact.email}`,
  telephone: profile.contact.phone,
  nationality: { '@type': 'Country', name: 'Egypt' },
  knowsLanguage: ['Arabic', 'English'],
  address: { '@type': 'PostalAddress', addressCountry: 'KW', addressLocality: 'Kuwait' },
  sameAs: [profile.contact.linkedin, profile.contact.whatsapp],
  alumniOf: { '@type': 'CollegeOrUniversity', name: pick(lang, profile.education[0].org) },
  hasCredential: profile.certifications.map((c) => ({
    '@type': 'EducationalOccupationalCredential',
    name: pick(lang, c.name),
    credentialCategory: 'certification',
    recognizedBy: { '@type': 'Organization', name: c.org },
  })),
};

const graph = [personSchema, ...(Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [])];
---

<!doctype html>
<html lang={lang} dir={direction} data-world="astronomy">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {!noindex && <link rel="canonical" href={canonical} />}

    {
      !noindex && (
        <>
          <link rel="alternate" hreflang="en" href={enUrl} />
          <link rel="alternate" hreflang="ar" href={arUrl} />
          <link rel="alternate" hreflang="x-default" href={enUrl} />
        </>
      )
    }

    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f5f5f7" media="(prefers-color-scheme: light)" />
    <meta name="color-scheme" content="dark light" />

    <!-- icons -->
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Cdefs%3E%3ClinearGradient id='g' x1='0' y1='0' x2='1' y2='1'%3E%3Cstop offset='0' stop-color='%232997ff'/%3E%3Cstop offset='.5' stop-color='%23a259ff'/%3E%3Cstop offset='1' stop-color='%23ff5e8a'/%3E%3C/linearGradient%3E%3C/defs%3E%3Crect width='64' height='64' rx='15' fill='black'/%3E%3Ctext x='50%25' y='52%25' font-family='Inter,Arial' font-size='30' font-weight='800' fill='url(%23g)' text-anchor='middle' dominant-baseline='middle'%3EMM%3C/text%3E%3C/svg%3E"
    />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/apple-touch-icon.png`} />

    <!-- Open Graph -->
    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content={profile.name.en} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'ar' ? 'ar_KW' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'ar' ? 'en_US' : 'ar_KW'} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(graph)} is:inline />

    <!-- No flash of wrong theme: dark is default, honour an explicit light choice. -->
    <script is:inline>
      (() => {
        document.documentElement.classList.add('js');
        // Owner's choice: this portfolio ALWAYS plays its motion — even when the
        // OS asks to reduce motion — because the scroll animations ARE the work
        // being shown. Make every reduced-motion media query report "motion is
        // fine" so the JS engines (pins, scrub, centerpieces, biome, starfield)
        // never fall back to static. The CSS reduced-motion blocks are likewise
        // neutralised in tokens.css. (Reverting = delete this shim + restore the
        // @media blocks.)
        try {
          const _mm = window.matchMedia.bind(window);
          window.matchMedia = (q) => {
            if (typeof q === 'string' && q.indexOf('prefers-reduced-motion') !== -1) {
              return {
                matches: q.indexOf('no-preference') !== -1, // reduce→false, no-preference→true
                media: q, onchange: null,
                addEventListener() {}, removeEventListener() {},
                addListener() {}, removeListener() {}, dispatchEvent() { return false; },
              };
            }
            return _mm(q);
          };
        } catch (e) {
          /* matchMedia unavailable — nothing to override */
        }
        const apply = () => {
          try {
            const root = document.documentElement;
            const WORLDS = ['astronomy', 'razer', 'disney', 'cod', 'netflix', 'spotify', 'apple', 'samsung'];
            const LEGACY = { dark: 'astronomy', light: 'astronomy', neon: 'razer', cinema: 'netflix', storybook: 'disney', wave: 'spotify' };
            const legacy = localStorage.getItem('mm-theme') || '';
            let world = localStorage.getItem('mm-world') || LEGACY[legacy] || 'astronomy';
            if (WORLDS.indexOf(world) === -1) world = 'astronomy';
            let mode = localStorage.getItem('mm-mode') || (legacy === 'light' ? 'light' : 'dark');
            if (mode !== 'light') mode = 'dark';
            root.setAttribute('data-world', world);
            // Branded worlds are purpose-built dark environments. The stored
            // appearance returns when the visitor comes back to Astronomy.
            if (world === 'astronomy' && mode === 'light') root.setAttribute('data-theme', 'light');
            else root.removeAttribute('data-theme');
            localStorage.setItem('mm-world', world);
            localStorage.setItem('mm-mode', mode);
            localStorage.setItem('mm-lang', root.getAttribute('lang') || 'en');
          } catch (e) {
            /* ignore */
          }
        };
        apply();
        document.addEventListener('astro:after-swap', apply);
      })();
    </script>

    <ClientRouter />
  </head>

  <body data-accent={accent}>
    <canvas id="space" aria-hidden="true"></canvas>
    <div class="world-ambient" aria-hidden="true">
      <i class="wa-grid"></i>
      <b class="wa-orbit"></b>
      <i class="wa-signal"></i>
      <span class="wa-mark">{lang === 'ar' ? 'عالم الهوية / محمد محمود' : 'Identity world / Mohamed Mahmoud'}</span>
    </div>
    <div class="world-transition" data-world-transition aria-hidden="true">
      <i></i><b></b><span data-world-transition-label></span>
    </div>
    <a href="#main" class="skip-link">{t('a11y.skip')}</a>
    <div class="progress" aria-hidden="true"></div>

    <Nav lang={lang} home={home} />

    <main id="main">
      <slot />
    </main>

    <Footer lang={lang} note={footerNote} />

    <script>
      import { initInteractions } from '../lib/interactions';
      import { initMotion } from '../lib/motion';
      import { initAurora } from '../lib/aurora';
      import { initSpace } from '../lib/space';
      import { activeWorld, WORLDS, WORLD_GLYPHS, WORLD_META, type WorldName } from '../lib/theme';

      // Reflect the active identity world and Astronomy appearance in the nav.
      function syncWorldUI() {
        const cur = activeWorld();
        document
          .querySelectorAll<HTMLElement>('[data-world-glyph]')
          .forEach((el) => (el.textContent = WORLD_GLYPHS[cur]));
        document
          .querySelectorAll<HTMLElement>('[data-world-opt]')
          .forEach((o) => o.setAttribute('aria-selected', o.dataset.worldOpt === cur ? 'true' : 'false'));
        const selected = document.querySelector<HTMLElement>(`[data-world-opt="${cur}"]`);
        document
          .querySelectorAll<HTMLElement>('[data-world-label]')
          .forEach((el) => (el.textContent = selected?.dataset.worldCopy || WORLD_META[cur].label));
        const mode = document.documentElement.getAttribute('data-theme') === 'light' ? 'light' : 'dark';
        document.querySelectorAll<HTMLElement>('[data-mode-btn]').forEach((button) => {
          button.textContent = mode === 'light' ? '☀' : '☾';
          button.toggleAttribute('hidden', cur !== 'astronomy');
        });
      }

      function boot() {
        initInteractions();
        initMotion();
        initAurora();
        initSpace();
        syncWorldUI();
      }
      boot();
      document.addEventListener('astro:page-load', boot);

      /* Identity menu — delegated once on document (survives View Transitions). */
      function closeWorldMenus() {
        document.querySelectorAll<HTMLElement>('[data-world-menu]').forEach((m) => {
          m.querySelector('[data-world-btn]')?.setAttribute('aria-expanded', 'false');
          m.querySelector('.theme-menu__list')?.setAttribute('hidden', '');
        });
      }
      function storedMode(): 'dark' | 'light' {
        try { return localStorage.getItem('mm-mode') === 'light' ? 'light' : 'dark'; }
        catch { return 'dark'; }
      }
      function applyAppearance(world: WorldName) {
        const root = document.documentElement;
        if (world === 'astronomy' && storedMode() === 'light') root.setAttribute('data-theme', 'light');
        else root.removeAttribute('data-theme');
      }
      let worldTimer = 0;
      function applyWorld(value: string) {
        if (!(WORLDS as readonly string[]).includes(value)) return;
        const world = value as WorldName;
        try {
          localStorage.setItem('mm-world', world);
        } catch (err) {
          /* ignore */
        }
        const root = document.documentElement;
        const overlay = document.querySelector<HTMLElement>('[data-world-transition]');
        const label = overlay?.querySelector<HTMLElement>('[data-world-transition-label]');
        window.clearTimeout(worldTimer);
        if (overlay) overlay.dataset.nextWorld = world;
        if (label) label.textContent = WORLD_META[world].label;
        root.dataset.worldNext = world;
        root.classList.add('world-switching');
        window.setTimeout(() => {
          root.dataset.world = world;
          applyAppearance(world);
          document.dispatchEvent(new Event('mm:themechange'));
          document.dispatchEvent(new CustomEvent('mm:worldchange', { detail: { world } }));
          syncWorldUI();
        }, 220);
        worldTimer = window.setTimeout(() => {
          root.classList.remove('world-switching');
          delete root.dataset.worldNext;
          if (overlay) delete overlay.dataset.nextWorld;
        }, 820);
      }
      function toggleMode() {
        const next = storedMode() === 'light' ? 'dark' : 'light';
        try { localStorage.setItem('mm-mode', next); } catch { /* ignore */ }
        applyAppearance(activeWorld());
        document.dispatchEvent(new Event('mm:themechange'));
        syncWorldUI();
      }
      document.addEventListener('click', (e) => {
        const t = e.target as HTMLElement;
        const opt = t.closest<HTMLElement>('[data-world-opt]');
        if (opt) {
          applyWorld(opt.dataset.worldOpt || 'astronomy');
          closeWorldMenus();
          return;
        }
        if (t.closest<HTMLElement>('[data-mode-btn]')) {
          toggleMode();
          return;
        }
        const btn = t.closest<HTMLElement>('[data-world-btn]');
        if (btn) {
          const menu = btn.closest('[data-world-menu]');
          const list = menu?.querySelector<HTMLElement>('.theme-menu__list');
          const wasClosed = !!list?.hasAttribute('hidden');
          closeWorldMenus();
          if (list && wasClosed) {
            list.removeAttribute('hidden');
            btn.setAttribute('aria-expanded', 'true');
          }
          return;
        }
        closeWorldMenus();
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          const open = document.querySelector<HTMLElement>('[data-world-menu] [aria-expanded="true"]');
          closeWorldMenus();
          open?.focus();
          return;
        }
        if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
          const list = (e.target as HTMLElement).closest?.('.theme-menu__list');
          if (!list) return;
          e.preventDefault();
          const opts = Array.from(list.querySelectorAll<HTMLElement>('[data-world-opt]'));
          const i = opts.indexOf(document.activeElement as HTMLElement);
          const n = e.key === 'ArrowDown' ? (i + 1) % opts.length : (i - 1 + opts.length) % opts.length;
          opts[n]?.focus();
        }
      });
    </script>
  </body>
</html>

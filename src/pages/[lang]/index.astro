---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Contact from '../../components/Contact.astro';
import SkyHero from '../../components/sky/SkyHero.astro';
import SkyBeats from '../../components/sky/SkyBeats.astro';
import SkyStation from '../../components/sky/SkyStation.astro';
import SkyMap, { type MapGroup } from '../../components/sky/SkyMap.astro';
import { useTranslations, workPath, pick, locales, type Lang } from '../../i18n/utils';
import { automationProjects, labProjects, publicAiProjects } from '../../data/system-projects';
import { legacyProjects, getProject, type ProjectMeta } from '../../data/projects';
import { featured } from '../../data/featured';
import { systemSpec } from '../../data/flight';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);
const ar = lang === 'ar';

// Featured flight: only systems whose story exists, in the order featured.ts gives.
const stations = featured
  .map((feature) => ({ feature, project: getProject(feature.slug) }))
  .filter((s): s is { feature: (typeof featured)[number]; project: ProjectMeta } => !!s.project?.story);
const publicStations = stations.filter((s) => s.feature.chapter === 'public');
const privateStations = stations.filter((s) => s.feature.chapter === 'private');

// Sky map: every story on the site, grouped by how a reader can check it.
const publicSlugs = new Set(publicAiProjects.map((p) => p.slug));
const entries: { project: ProjectMeta; group: MapGroup }[] = [
  ...publicAiProjects.map((project) => ({ project, group: 'public' as const })),
  ...automationProjects.filter((p) => !publicSlugs.has(p.slug)).map((project) => ({ project, group: 'automation' as const })),
  ...labProjects.map((project) => ({ project, group: 'lab' as const })),
  ...legacyProjects.map((project) => ({ project, group: 'foundation' as const })),
];

const skyData = {
  // The same seat, kind and seed the story flight reads: one planet per project.
  stations: stations.map(({ project }) => systemSpec(project.slug, project.cardA, project.cardB)),
  stars: entries.map(({ project, group }) => ({
    slug: project.slug,
    group,
    a: project.cardB,
    title: pick(lang, project.title),
    href: workPath(lang, project.slug),
  })),
};

const chapters = {
  public: {
    title: ar ? 'أربعة تستطيع تشغيلها بدوني.' : 'Four you can run without me.',
    lead: ar
      ? 'مستودعات عامة بتكامل مستمر وحاويات، واثنان منها بعروض حية. كل رقم أدناه رقم تعيد الاختبارات إنتاجه، وكل نظام يقول ما لا يفعله.'
      : 'Public repositories with continuous integration and containers — two of them run live demos. Every figure below is one the tests reproduce, and every system says what it does not do.',
  },
  private: {
    title: ar ? 'أنظمة خاصة، تُعرض بأمان.' : 'Private systems, shown safely.',
    lead: ar
      ? 'تبقى الشيفرة خاصة. الشاشات منقّحة، والبيانات اصطناعية حيث يُذكر ذلك، والحدود مكتوبة بجانب كل ادعاء.'
      : 'The source stays private. The screens are sanitized, the data is synthetic wherever it says so, and the limits sit next to every claim.',
  },
};
---

<BaseLayout lang={lang} title={t('site.title')} description={t('site.description')} path={`/${lang}`} accent="blue" home={true}>
  <canvas class="sky" data-sky aria-hidden="true"></canvas>
  <div class="letterbox" aria-hidden="true"><i></i><i></i></div>
  <script type="application/json" id="sky-data" set:html={JSON.stringify(skyData)} is:inline />

  <SkyHero lang={lang} projectCount={entries.length} publicCount={publicAiProjects.length} />
  <SkyBeats lang={lang} />

  <div id="work" class="flight">
    {
      publicStations.length > 0 && (
        <header class="chapter">
          <h2 data-ptext>{chapters.public.title}</h2>
          <p>{chapters.public.lead}</p>
        </header>
      )
    }
    {publicStations.map(({ project, feature }, i) => <SkyStation lang={lang} project={project} feature={feature} index={i} />)}
    <header class="chapter">
      <h2 data-ptext>{chapters.private.title}</h2>
      <p>{chapters.private.lead}</p>
    </header>
    {privateStations.map(({ project, feature }, i) => <SkyStation lang={lang} project={project} feature={feature} index={i + publicStations.length} />)}
  </div>

  <SkyMap lang={lang} entries={entries} />

  <div data-sky-stop="contact" class="finale">
    <Contact lang={lang} />
  </div>
</BaseLayout>

<style is:global>
  .sky {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    display: block;
    pointer-events: none;
    opacity: 0;
    transition: opacity 1.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  html.sky-live .sky {
    opacity: 1;
  }
  html.sky-live #space {
    visibility: hidden !important;
  }
  /* the headline is drawn in the scene now: DOM scrims would dim it */
  html.sky-live .skyhero__halo,
  html.sky-live .beat::before {
    display: none;
  }
  html.sky-live .skymap__intro::before {
    opacity: 0.55;
  }
  html.sky-live .finale .cf {
    background: transparent;
  }
  html.sky-live .finale .cf-stars {
    display: none;
  }
  html.sky-live .finale .cf-scrim {
    width: min(140vw, 1300px);
    height: min(96vh, 900px);
    background: radial-gradient(60% 56% at 50% 52%, rgba(3, 3, 10, 0.78), rgba(3, 3, 10, 0.42) 60%, transparent 82%);
  }
</style>

<style>
  .flight {
    position: relative;
    z-index: 1;
  }
  .chapter {
    position: relative;
    z-index: 1;
    max-width: 1440px;
    margin: 0 auto;
    padding: 22vh clamp(20px, 5vw, 72px) 0;
  }
  .chapter h2 {
    max-width: 14ch;
    margin: 0;
    font-size: clamp(44px, 7vw, 104px);
    font-weight: 860;
    line-height: 0.95;
    letter-spacing: -0.04em;
    text-wrap: balance;
    text-shadow: 0 2px 40px rgba(3, 3, 10, 0.9);
  }
  :global([dir='rtl']) .chapter h2 {
    font-family: var(--font-ar-display);
    letter-spacing: 0;
    line-height: 1.15;
  }
  .chapter p {
    max-width: 52ch;
    margin-top: 24px;
    font-size: clamp(16px, 1.5vw, 20px);
    line-height: 1.6;
    color: var(--ink-2);
    text-shadow: 0 1px 24px rgba(3, 3, 10, 0.95);
  }
  :global([data-theme='light']) .chapter h2,
  :global([data-theme='light']) .chapter p {
    text-shadow: none;
  }
</style>

<script>
  import { bootSky, stopSky } from '../../lib/sky/boot';
  // ClientRouter fires astro:page-load on the first load too.
  document.addEventListener('astro:page-load', () => {
    if (document.querySelector('[data-sky]')) bootSky();
  });
  document.addEventListener('astro:before-swap', stopSky);
</script>

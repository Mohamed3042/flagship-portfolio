---
/**
 * The landing page: DEEP FIELD.
 *
 * Document order is the story order, and it is all real HTML: nineteen beats —
 * the name, the five worlds, the four games, the voice engine, the five systems
 * the site features first, the tools, the public work and contact — then
 * selected work, the method, the private systems, the full archive and contact
 * again. The scroll-controlled cosmos upgrades the beats in place; it never
 * supplies their only copy.
 *
 * "Skip the cinematic" and "See the systems" both land on inspectable work,
 * because a cinematic default has to stay compatible with a fast route.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Contact from '../../components/Contact.astro';
import Stage, { type SignalAction, type SignalChapterCopy, type SignalLabel } from '../../components/signal/Stage.astro';
import ProjectCard from '../../components/showroom/ProjectCard.astro';
import ProjectAtlas, { type MapGroup } from '../../components/showroom/ProjectAtlas.astro';
import { useTranslations, workPath, pick, locales, type Lang } from '../../i18n/utils';
import { automationProjects, labProjects, publicAiProjects } from '../../data/system-projects';
import { legacyProjects, getProject, type ProjectMeta } from '../../data/projects';
import { featured } from '../../data/featured';
import { profile } from '../../data/profile';
import { games, tools, voice, worlds, worldClips } from '../../data/deep-field';
import { CHAPTERS, COPY, SEGMENT_VH } from '../../lib/signal/chapters';
import '../../styles/showroom.css';
import '../../styles/signal.css';

export function getStaticPaths() { return locales.map(lang => ({ params: { lang } })); }
const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);
const ar = lang === 'ar';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const stations = featured.map(feature => ({ feature, project: getProject(feature.slug)! })).filter(s => !!s.project?.story);
const publicStations = stations.filter(s => s.feature.chapter === 'public');
const privateStations = stations.filter(s => s.feature.chapter === 'private');
const publicSlugs = new Set(publicAiProjects.map(p => p.slug));
const entries: { project: ProjectMeta; group: MapGroup }[] = [
  ...publicAiProjects.map(project => ({ project, group: 'public' as const })),
  ...automationProjects.filter(p => !publicSlugs.has(p.slug)).map(project => ({ project, group: 'automation' as const })),
  ...labProjects.map(project => ({ project, group: 'lab' as const })),
  ...legacyProjects.map(project => ({ project, group: 'foundation' as const })),
];

/** The repositories a reader can actually clone. `repo` is set only when public. */
const repos = featured.filter(f => !!f.repo);
/** The four repositories, labelled by their own names — LTR in both routes. */
const repoLabels: SignalLabel[] = repos.map(f => ({
  key: f.slug,
  label: (f.repo as string).replace(/\/$/, '').split('/').pop() as string,
  href: f.repo as string,
}));
/** The tools, labelled by the name in each skill's own frontmatter. A chip
 *  carries a link only where that tool's repository is public. */
const toolLabels: SignalLabel[] = tools.map(tool => ({
  key: tool.key, label: tool.label, ...(tool.repo ? { href: tool.repo } : {}),
}));
/** Every world's key frame ships at one width; the height is its own ratio. */
const FRAME_WIDTH = 1180;
const cv = `${base}/downloads/Mohamed-Mahmoud-AI-Automation-Engineer-Resume.pdf`;
const github = 'https://github.com/Mohamed3042';

/**
 * Resolve each chapter against the real data here, so the stage component and
 * the scene script never hold a second, unsynchronised copy of a fact.
 */
const chapters: SignalChapterCopy[] = CHAPTERS.map(chapter => {
  const copy = COPY[chapter.id] ?? COPY[chapter.act];
  const shared = { id: chapter.id, act: chapter.act, side: chapter.side };
  const actions: SignalAction[] = [];

  if (chapter.act === 'road') {
    const milestones: Record<string, [string, string]> = {
      worlds: ['WORLDS', 'العوالم'], games: ['GAMES', 'الألعاب'], voice: ['VOICE', 'الصوت'],
      systems: ['SYSTEMS', 'الأنظمة'], workshop: ['WORKSHOP', 'الورشة'], public: ['PUBLIC', 'أعمال عامة'],
    };
    const name = milestones[chapter.id.slice(5)];
    return { ...shared, kicker: null, title: name[ar ? 1 : 0], line: null, actions };
  }

  if (chapter.act === 'hero') {
    // One action on the hero. The fast route past the cinema has to exist;
    // contact has its own chapter and its own band at the foot of the page, so
    // a second button here is a block of text the contract does not want.
    actions.push({ href: '#work', label: ar ? 'استكشف الأنظمة' : 'See the systems' });
    return {
      ...shared,
      kicker: pick(lang, copy.kicker),
      title: pick(lang, profile.name),
      role: `${pick(lang, profile.title)} · ${pick(lang, profile.location)}`,
      line: copy.line ? pick(lang, copy.line) : null,
      actions,
    };
  }

  if (chapter.act === 'worlds') {
    const world = worlds.find(w => `world-${w.slug}` === chapter.id)!;
    actions.push({
      href: world.href,
      label: world.live
        ? (ar ? 'ادخل العالم' : 'Enter the world')
        : (ar ? 'شاهد طابق العوالم' : 'See the worlds floor'),
      external: true,
    });
    return {
      ...shared,
      kicker: pick(lang, copy.kicker),
      title: pick(lang, world.title),
      line: pick(lang, world.line),
      actions,
      portal: {
        src: world.frame,
        clip: worldClips[world.slug],
        alt: pick(lang, world.alt),
        aspect: world.aspect,
        width: FRAME_WIDTH,
        height: Math.round(FRAME_WIDTH / world.aspect),
      },
    };
  }

  if (chapter.act === 'games') {
    const game = games.find(g => `game-${g.id}` === chapter.id)!;
    // The three with an archive entry lead to it; the one with a public
    // repository leads to the repository. Every beat leads somewhere real.
    if (game.slug) actions.push({ href: workPath(lang, game.slug), label: ar ? 'استكشف المشروع' : 'Explore the project' });
    if (game.repo) {
      actions.push({ href: game.repo, label: ar ? 'المستودع العام' : 'Public repository', external: true });
    }
    return {
      ...shared,
      kicker: game.engine,
      title: game.title,
      line: pick(lang, game.line),
      actions,
    };
  }

  if (chapter.act === 'voice') {
    actions.push({ href: workPath(lang, voice.slug), label: ar ? 'استكشف المشروع' : 'Explore the project' });
    actions.push({
      href: `mailto:${profile.contact.email}`,
      label: ar ? 'اطلب عرضًا' : 'Ask for a demo',
    });
    return {
      ...shared,
      kicker: pick(lang, copy.kicker),
      title: voice.title,
      line: pick(lang, voice.line),
      actions,
    };
  }

  if (chapter.act === 'systems') {
    const project = getProject(chapter.project as string)!;
    const feature = featured.find(f => f.slug === chapter.project) ?? null;
    actions.push({ href: workPath(lang, project.slug), label: ar ? 'استكشف المشروع' : 'Explore the project' });
    if (feature?.repo) actions.push({ href: feature.repo, label: ar ? 'المستودع العام' : 'Public repository', external: true });
    return {
      ...shared,
      kicker: pick(lang, project.tag),
      title: pick(lang, project.title),
      line: pick(lang, project.blurb),
      actions,
    };
  }

  if (chapter.act === 'tools') {
    return {
      ...shared,
      kicker: pick(lang, copy.kicker),
      title: copy.title ? pick(lang, copy.title) : '',
      line: copy.line ? pick(lang, copy.line) : null,
      actions,
      // One label per anchor, keyed by the tool's own name. The renderer hangs
      // each of these on the star the camera projects for that key; a key with
      // no anchor simply never appears, which the harness checks for.
      labels: toolLabels,
    };
  }

  if (chapter.act === 'public') {
    actions.push({ href: '#work', label: ar ? 'افتح الأربعة' : 'Open the four' });
    actions.push({ href: github, label: 'GitHub', external: true, ltr: true });
    return {
      ...shared,
      kicker: pick(lang, copy.kicker),
      title: copy.title ? pick(lang, copy.title) : '',
      // The count is the site's own convention for a number inside an Arabic
      // sentence: Arabic-Indic digits, from toLocaleString, exactly as the
      // atlas and the sky map already render theirs. A Latin 4 in a line that
      // sits two beats after ٥٠٣ and ١٨٤ is the page changing its mind.
      line: ar
        ? `${repos.length.toLocaleString('ar-EG')} مستودعات عامة، مع تكامل مستمر وحاويات.`
        : `${repos.length} public repositories, with continuous integration and containers.`,
      actions,
      labels: repoLabels,
    };
  }

  // contact
  actions.push({ href: `mailto:${profile.contact.email}`, label: profile.contact.email, ltr: true });
  actions.push({ href: github, label: 'GitHub', external: true, ltr: true });
  actions.push({ href: profile.contact.linkedin, label: 'LinkedIn', external: true, ltr: true });
  actions.push({ href: cv, label: ar ? 'السيرة الذاتية (PDF)' : 'CV (PDF)', external: true });
  return {
    ...shared,
    kicker: pick(lang, copy.kicker),
    title: copy.title ? pick(lang, copy.title) : '',
    line: copy.line ? pick(lang, copy.line) : null,
    actions,
  };
});

// The five-step method disclosure, kept from the approved showroom round.
const method = [
  { title: ar ? 'ارسم العملية' : 'Map the loop', body: ar ? 'المدخلات والقرارات والتسليمات، قبل أي أتمتة.' : 'Inputs, decisions and hand-offs, before automation.', slug:'sheep-business-management' },
  { title: ar ? 'اربط الطبقات' : 'Connect the layers', body: ar ? 'اربط البيانات والأدوات في مسار واضح يمكن فحصه.' : 'Connect data and tools in a path you can inspect.', slug:'relayops' },
  { title: ar ? 'احتفظ بالموافقة' : 'Keep human approval', body: ar ? 'اجعل القرارات المؤثرة مرئية وخاضعة للموافقة.' : 'Make consequential decisions visible and approval-gated.', slug:'enterprise-ai-automation-templates' },
  { title: ar ? 'شغّل النظام' : 'Run the system', body: ar ? 'شغّل المسار مع سجل تدقيق وحدود واضحة.' : 'Run the workflow with an audit trail and explicit limits.', slug:'career-autopilot' },
  { title: ar ? 'تحقق من الدليل' : 'Verify the evidence', body: ar ? 'اربط الادعاءات بمصادرها، ولا تخفِ ما لم يُثبت.' : 'Trace claims to their sources. Keep unproven outcomes visible.', slug:'ask-repos' },
];

/**
 * The face the name is sampled in, so the constellation and the document's own
 * h1 can never be two different words in two different typefaces.
 */
const heroFont = ar ? '300 190px "Cairo Variable", sans-serif' : '300 190px "Inter Variable", sans-serif';
---
<BaseLayout lang={lang} title={t('site.title')} description={t('site.description')} path={`/${lang}`} accent="blue" home={true}>
  <div class="showroom" data-showroom>
    {/* The cinema scope covers the stage only, so the archive and contact below
        keep the existing six-theme system. */}
    <div class="signal" data-signal data-nodes={entries.length}
         data-base={base} data-name={pick(lang, profile.name)} data-font={heroFont}>
      {/* The still composition and the cinema are different LAYOUTS, so
          switching between them after the page has painted is a layout shift by
          definition — and it measured 0.0158 of one. The only way to have no
          shift is to decide before the first paint, which is what this does: a
          1x1 probe context, run synchronously by the parser, before anything
          inside the stage has been laid out. If the real renderer then fails,
          initSignal() puts the attribute back and the still composition returns
          — a shift in that case only, which is the rare one. */}
      <script is:inline>
        (() => {
          const stage = document.currentScript.parentElement;
          try {
            const probe = document.createElement('canvas');
            if (probe.getContext('webgl2') || probe.getContext('webgl')) stage.dataset.graphics = 'webgl';
          } catch { /* no context: the still composition is already correct */ }
          // The header is over the cinema for the whole runway, and while it is,
          // the stylesheet hides the theme control — six themes over a stage that
          // is black in all six. That attribute used to arrive with the renderer,
          // half a second after first paint, and the header lost 48px of controls
          // in front of the visitor: the site's ONLY layout shift, 0.00031 of one,
          // traced to DIV.nav__tools changing width at 496ms. Declaring it here
          // makes the first paint the right one. If a restored scroll position
          // puts the visitor past the runway, the renderer corrects it on frame one.
          stage.dataset.over = 'cinema';
        })();
      </script>
      {/* The nebula haze, under the stars and anchored to the same band they are
          drawn from. A painted layer, not a texture download. */}
      <div class="signal__haze" aria-hidden="true"></div>
      <canvas class="signal__canvas" data-signal-canvas aria-hidden="true"></canvas>
      {/* Grain and vignette sit above the field and below the type. Both are
          painted, never a texture download. */}
      <div class="signal__grade" aria-hidden="true"></div>

      <Stage lang={lang} chapters={chapters} runway={SEGMENT_VH.landscape} />
    </div>

    <div class="sr-container">
      <section class="sr-section" id="work" aria-labelledby="public-title">
        <header class="sr-section-head"><div><h2 id="public-title" tabindex="-1">{ar?'أربعة تستطيع تشغيلها بدوني.':'Four you can run without me.'}</h2><p>{ar?'مستودعات عامة وتكامل مستمر وحاويات. اثنان منها بعروض حية. النطاق والحدود بجانب كل مشروع.':'Public repositories, continuous integration and containers. Two have live demos. Scope and limitations sit with every project.'}</p></div><a class="sr-text-link" href="#sky">{ar?'تصفح كل المشاريع':'Browse all projects'}<svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="m5 7 5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.6" /></svg></a></header>
        <div class="sr-projects">{publicStations.map(s=><ProjectCard lang={lang} project={s.project} feature={s.feature} />)}</div>
      </section>

      <section class="sr-method sr-section" id="method" aria-labelledby="method-title"><header class="sr-section-head"><h2 id="method-title">{ar?'من العملية اليدوية إلى نظام.':'From a manual loop to a system.'}</h2></header><div class="sr-method__steps">{method.map((m,i)=><details><summary><span class="sr-method__node" aria-hidden="true">{i+1}</span>{m.title}</summary><p>{m.body}</p><a class="sr-text-link" href={workPath(lang,m.slug)}>{ar?'شاهد المثال':'See it in a project'}</a></details>)}</div></section>

      <section class="sr-section" id="private-work" aria-labelledby="private-title"><header class="sr-section-head"><div><h2 id="private-title">{ar?'أنظمة خاصة، تُعرض بأمان.':'Private systems, shown safely.'}</h2><p>{ar?'تبقى الشيفرة خاصة. الشاشات منقّحة، والبيانات اصطناعية حيث يُذكر ذلك. افتح نطاق المشروع لمعرفة حدوده.':'The source stays private. Screens are sanitized; data is synthetic wherever stated. Open each project’s scope to inspect its limits.'}</p></div></header><div class="sr-projects sr-projects--private">{privateStations.map(s=><ProjectCard lang={lang} project={s.project} feature={s.feature} />)}</div></section>

      <ProjectAtlas lang={lang} entries={entries} />
    </div>

    <div class="sr-contact"><Contact lang={lang}/></div>

    <dialog class="sr-dialog" data-showroom-dialog aria-labelledby="sr-dialog-heading"><div class="sr-dialog__bar"><h2 id="sr-dialog-heading">{ar?'استكشف المشروع':'Inspect the project'}</h2><button type="button" data-close-dialog aria-label={ar?'إغلاق المعاينة':'Close preview'}><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="m6 6 12 12M6 18 18 6" fill="none" stroke="currentColor" stroke-width="1.7" /></svg></button></div><div data-dialog-content></div></dialog>
  </div>
</BaseLayout>
<script>
  import { initSignal, stopSignal } from '../../lib/signal';
  import { initShowroom, stopShowroom } from '../../lib/showroom';
  document.addEventListener('astro:page-load', () => { initShowroom(); initSignal(); });
  document.addEventListener('astro:before-swap', () => { stopSignal(); stopShowroom(); });
</script>
